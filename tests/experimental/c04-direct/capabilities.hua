# C04 internal capability flow. The input program is never executed.
import modules as modules
import ast_pool as ast
import type_rules as rules
import signatures as signatures
import std.list as list
import std.strings as strings
import std.alg as alg
import std.json as json
# Numeric facts are two packed int cells: TypeId and capability bits.
# Field/operation IDs are local to an immutable shape, never compared across
# tables or analysis sessions. The origin base belongs to the value.
struct FieldTable { identity string
    ids map[string]int
    facts [][2]int
    types []string
    steps []string
    origins map[string]bool
    base_steps string }
pub struct View { type_name string
    writable bool
    readonly_children bool
    deep_owned bool
    record_copy bool
    origins map[string]bool
    origin_steps string }
pub struct Value { numeric []FieldTable
    root View
    fields map[string]View
    prefixes map[string]map[string]bool
    prefix string
    readonly_fields bool
    copied_fields bool
    copy_readonly bool
    positions []Value
    patches map[string]View
    cuts map[string]bool }
# Node consumers use the root view (including write origins) and positional
# roots only. Keep full member tables in values/environments/summaries, where
# projection and alias analysis need them, without retaining them at every AST node.
pub struct Fact { root View
    positions []Fact }
fn node_fact(input Value) Fact { var out=Fact{root:input.root,positions:[]}
    if len(input.positions)>0 { var empty []Fact=[]
        var positions=list.from_slice(empty)
        for item in input.positions { unwrap(list.append(positions,node_fact(item))) }
        out.positions=list.snapshot(positions) }
    return out
}
pub struct Parameter { target string
    type_name string
    writable bool }
pub struct Function { target string
    module string
    node int
    parameters []Parameter
    result string }
struct WriteArgument { destination string
    parameter bool
    writable bool }
# Parsed write destinations and immutable facts are published once per summary.
struct Effect { owner string
    path string
    fact View }
struct Inputs { facts map[string]View
    flags map[string]bool }
struct Memo { version int
    inputs Inputs
    returned Value
    writes map[string]View }
# A consultation records immutable pre-write actuals, never a whole environment.
struct Consultation { target string
    site string
    actual map[string]Value
    returned Value
    return_version int
    write_version int
    required_version int
    control_version int }
struct BodyMemo { work int
    calls []Consultation }
struct Summary { returned Value
    unknown bool
    saw_return bool
    writes map[string]View
    required map[string]bool
    effects map[string]Effect
    return_reads map[string]bool
    write_reads map[string]bool
    return_version int
    write_version int
    required_version int
    control_version int }
pub struct Model { facts map[string]Fact
    passes int
    work int
    error string }
struct State { units map[string]modules.Unit
    refs map[string]string
    declarations map[string]string
    fields map[string]string
    members map[string]map[string]string
    numeric_shapes map[string]FieldTable
    shapes map[string]map[string]View
    shape_prefixes map[string]map[string]map[string]bool
    functions map[string]Function
    variants map[string]string
    summaries map[string]Summary
    return_memos map[string]Memo
    write_memos map[string]Memo
    next_summary_version int
    bodies map[string]BodyMemo
    dependents map[string]map[string]bool
    dirty map[string]bool
    facts map[string]Fact
    global_symbols map[string]bool
    errors map[string]string
    probing bool
    work int
    error string }
struct Environment { unit modules.Unit
    function string
    values map[string]Value
    versions map[string]int
    next_version int
    updating bool
    edited_fields map[string]map[string]View
    edited_prefixes map[string]map[string]map[string]bool
    patch_batches map[string]map[string]View
    cut_batches map[string]map[string]bool
    alias_cache map[string][]string
    returned Value
    saw_return bool
    writes map[string]bool
    visible map[string]bool
    required map[string]bool
    callees map[string]bool
    consultations List<Consultation>
    exits []map[string]Value
    deferred bool }
fn view(type string, writable bool) View { return View{type_name:type,writable:writable,readonly_children:false,deep_owned:false,record_copy:false,origins:map[string]bool{},origin_steps:""} }
fn value(type string, writable bool) Value { return Value{numeric:[],root:view(type,writable),fields:map[string]View{},prefixes:map[string]map[string]bool{},prefix:"",readonly_fields:false,positions:[],patches:map[string]View{},cuts:map[string]bool{},copied_fields:false,copy_readonly:false} }
fn key(module string, node int) string { return module+":"+str(node) }
fn get(pool ast.Pool, id ast.NodeId) ast.Node { return unwrap(ast.get(pool,id)) }
fn target(refs map[string]string, module string, n ast.Node) string { return unwrap_or(refs[key(module,n.id.index)],"") }
fn declaration(declarations map[string]string, module string, n ast.Node) string { return unwrap_or(declarations[key(module,n.id.index)],"") }
fn record(type string) bool { return strings.contains(rules.optional(type),"#") && !rules.shared(type) && !strings.starts_with(type,"fn:") && !strings.starts_with(type,"variant:") }
fn split_origin(origin string) []string { return strings.split(origin,"|") }
fn depth(path string) int { return len(strings.split(path,"#@"))-1 }
fn tick(s mut State, span ast.SourceSpan) Result<void> {
    if s.work >= 1048576 { return err("E8202@"+str(span.line)+":"+str(span.column)+" capability work budget") }
    s.work += 1
    return ok()
}
fn denied(s mut State, e Environment, n ast.Node, reason string) Result<void> {
    # Preserve the first capability error, but let C04 validate types/arity first.
    if e.function!="" && !has(s.errors,e.function) {
        s.errors[e.function]="E3003@"+str(n.span.line)+":"+str(n.span.column)+" ["+e.unit.id+"] "+reason }
    return ok()
}
# Immutable symbolic projection. Pipes delimit projection operations, not paths.
# Owner/path terms are expanded only at alias, substitution, requirement/equality
# boundaries. The exact 512-byte reset occurs after each original operation.
fn origin_terms(input View) map[string]bool {
    if input.origin_steps=="" || len(input.origins)==0 { return input.origins }
    let steps=strings.split(input.origin_steps,"|")
    # The leading separator encodes even an empty projection operation.
    # Replay in operation order: an intermediate key collision must use the
    # original map iteration/overwrite rule before the next projection.
    if len(input.origins)==1 {
        for origin, readonly in input.origins { let parts=split_origin(origin)
            var path=parts[1]
            var flag=readonly
            for i in 1..len(steps) { path+=steps[i]
                if len(path)>512 { path=""
                    flag=true } }
            var out=map[string]bool{}
            out[parts[0]+"|"+path]=flag
            return out } }
    var current=input.origins
    for i in 1..len(steps) { var next=map[string]bool{}
        for origin, readonly in current { let parts=split_origin(origin)
            var path=parts[1]+steps[i]
            var flag=readonly
            if len(path)>512 { path=""
                flag=true }
            next[parts[0]+"|"+path]=flag }
        current=next }
    return current
}
fn projected(base View, path string, type string) View {
    var out=view(type,base.writable && !base.readonly_children)
    out.readonly_children=base.readonly_children || !base.writable
    out.deep_owned=base.deep_owned
    if len(base.origins)>0 {
        out.origins=base.origins
        out.origin_steps=base.origin_steps+"|"+path
        # Bound retained symbolic chains, without truncating logical origins.
        if len(out.origin_steps)>1024 { out.origins=origin_terms(out)
            out.origin_steps="" } }
    return out
}
fn child_type(type string) string {
    let m = rules.arguments(type,"map")
    if len(m)==2 { return m[1] }
    let l = rules.arguments(type,"List")
    if len(l)==1 { return l[0] }
    return rules.element(type)
}
# Sparse topology index: each proper prefix maps to its descendant field keys.
# Deleted keys may remain in the index; select() checks the live field table.
# Index tables are immutable after publication and detach together with fields.
fn note_prefix(prefixes mut map[string]map[string]bool, path string) {
    if has(prefixes,"@all") { var all=unwrap(prefixes["@all"])
        all[path]=true }
    let parts=strings.split(path,"#@")
    var prefix=""
    let end=len(parts)-1
    for i in 1..end { prefix+="#@"+parts[i]
        if !has(prefixes,prefix) { prefixes[prefix]=map[string]bool{} }
        var descendants=unwrap(prefixes[prefix])
        descendants[path]=true }
}
# Type buckets share the immutable topology. Entries may become stale after
# replacement; alias lookup always checks the live field and its actual type.
fn note_type(prefixes mut map[string]map[string]bool, path string, type string) {
    let bucket="@type:"+type
    if !has(prefixes,bucket) { prefixes[bucket]=map[string]bool{} }
    var paths=unwrap(prefixes[bucket])
    paths[path]=true
}
fn prefix_index(fields map[string]View) map[string]map[string]bool {
    var out=map[string]map[string]bool{"@types":map[string]bool{},"@all":map[string]bool{}}
    for path, fact in fields { note_prefix(out,path)
        note_type(out,path,fact.type_name) }
    return out
}
fn field_shape(members map[string]map[string]string, base View, level int) map[string]View {
    var result = map[string]View{}
    if level>=8 { return result }
    var type = rules.optional(base.type_name)
    let wrapped = rules.arguments(type,"Result")
    if len(wrapped)==2 { type=wrapped[0] }
    if record(type) {
        for name, typ in unwrap_or(members[type],map[string]string{}) {
            let path="#@"+name
            var item=projected(base,path,typ)
            if record(typ) && base.record_copy { item=copy_view(item) }
            result[path]=item
            for suffix, nested in field_shape(members,item,level+1) { result[path+suffix]=nested }
        }
    } else { let typ=child_type(type)
        if typ!="" { let item=projected(base,"#@[]",typ)
            result["#@[]"]=item
            for suffix, nested in field_shape(members,item,level+1) { result["#@[]"+suffix]=nested } } }
    return result
}
# Cache declaration/capability shapes only. Origins belong to the current value,
# and a fresh State discards every shape before the next analyzed program.
fn field_defaults(s mut State, base View, level int) map[string]View {
    let cache_key=base.type_name+"|"+str(level)+":"+str(base.writable)+str(base.readonly_children)+str(base.deep_owned)+str(base.record_copy)
    if !has(s.shapes,cache_key) { var prototype=base
        prototype.origins=map[string]bool{}
        prototype.origin_steps=""
        s.shapes[cache_key]=field_shape(s.members,prototype,level) }
    var result=map[string]View{}
    for path, fact in unwrap(s.shapes[cache_key]) { var item=fact
        item.origins=base.origins
        item.origin_steps=base.origin_steps
        # field_shape projects one segment at a time. Preserve those operations.
        let segments=strings.split(path,"#@")
        for i in 1..len(segments) {
            item.origin_steps+="|#@"+segments[i] }
        result[path]=item }
    return result
}

# Shape construction happens once per type/capability combination. No owner
# origins are expanded here. Values carry the immutable table plus their base.
fn numeric_shape(s mut State, base View) FieldTable {
    let identity=base.type_name+":"+str(base.writable)+str(base.readonly_children)+str(base.deep_owned)+str(base.record_copy)
    if has(s.numeric_shapes,identity) { return unwrap(s.numeric_shapes[identity]) }
    var prototype=base
    prototype.origins=map[string]bool{}
    prototype.origin_steps=""
    let fields=field_shape(s.members,prototype,0)
    var ids=map[string]int{}
    var type_ids=map[string]int{}
    var empty_types []string=[]
    var types=list.from_slice(empty_types)
    var empty_facts [][2]int=[]
    var facts=list.from_slice(empty_facts)
    var steps=list.from_slice(empty_types)
    for path, fact in fields {
        if !has(type_ids,fact.type_name) { type_ids[fact.type_name]=list.len(types)
            unwrap(list.append(types,fact.type_name)) }
        let id=list.len(facts)
        ids[path]=id
        var flags=0
        if fact.writable { flags+=1 }
        if fact.readonly_children { flags+=2 }
        if fact.deep_owned { flags+=4 }
        if fact.record_copy { flags+=8 }
        var cell [2]int=[unwrap(type_ids[fact.type_name]),flags]
        unwrap(list.append(facts,cell))
        var suffix=""
        let parts=strings.split(path,"#@")
        for i in 1..len(parts) { suffix+="|#@"+parts[i] }
        unwrap(list.append(steps,suffix))
    }
    var table=FieldTable{identity:"",ids:ids,facts:list.snapshot(facts),types:list.snapshot(types),steps:list.snapshot(steps),origins:map[string]bool{},base_steps:""}
    let encoded=json.encode(table)
    if is_ok(encoded) { table.identity=unwrap(encoded) }
    # Existing graph/type limits bound construction. Admission additionally
    # caps retained shapes; a full cache uses the same exact uncached table.
    if len(s.numeric_shapes)<4096 { s.numeric_shapes[identity]=table }
    return table
}
fn numeric_view(table FieldTable, id int) View {
    let cell=table.facts[id]
    return View{type_name:table.types[cell[0]],writable:cell[1]%2==1,readonly_children:(cell[1]//2)%2==1,deep_owned:(cell[1]//4)%2==1,record_copy:(cell[1]//8)%2==1,origins:table.origins,origin_steps:table.base_steps+table.steps[id]}
}
# Return conservative path keys only; never manufacture a dense fact map.
# New sparse keys are unioned in sorted map order, preserving alias/write order.
fn field_paths(input Value) map[string]bool {
    if !has(input.prefixes,"@all") {
        var fallback=map[string]bool{}
        for path, unused in input.fields { fallback[path]=true }
        if len(input.numeric)>0 { for path, unused in input.numeric[0].ids { fallback[path]=true } }
        for path, unused in input.patches { fallback[path]=true }
        return fallback }
    let base=unwrap(input.prefixes["@all"])
    var added=false
    for path, unused in input.patches { if !has(base,path) { added=true
        break } }
    if !added { return base }
    var out=clone(base)
    for path, unused in input.patches { out[path]=true }
    return out
}
fn alias_paths(input Value, type string) map[string]bool {
    if !has(input.prefixes,"@types") { return field_paths(input) }
    let base=unwrap_or(input.prefixes["@type:"+type],map[string]bool{})
    var added=false
    for path, fact in input.patches { if fact.type_name==type && !has(base,path) { added=true
        break } }
    if !added { return base }
    var out=clone(base)
    for path, fact in input.patches { if fact.type_name==type { out[path]=true } }
    return out
}
fn visible_field(input Value, full string) bool {
    if input.prefix!="" && !strings.starts_with(full,input.prefix+"#@") { return false }
    return field_exists(input,full)
}
fn field_relative(input Value, full string) string {
    if input.prefix=="" { return full }
    return rules.cut(full,len(input.prefix),len(full))
}
fn has_fields(input Value) bool {
    if len(input.fields)==0 && len(input.numeric)==0 { return len(input.patches)>0 }
    for full, unused in field_paths(input) { if visible_field(input,full) { return true } }
    return false
}
# Admission is conservative: stale paths may select the exact memo path, but
# must never hide a consulted origin. It does not affect logical semantics.
fn wide_fields(input Value) bool {
    if len(input.fields)>8 || len(input.patches)>8 { return true }
    if len(input.numeric)>0 && len(input.numeric[0].ids)>8 { return true }
    return len(input.fields)+len(input.patches)>8
}
fn canonical(input Value) bool {
    return len(input.numeric)==0 && !input.copied_fields && !input.copy_readonly && input.prefix=="" && !input.readonly_fields && len(input.patches)==0 && len(input.cuts)==0
}

fn seeded(s mut State, type string, writable bool, owner string) Value {
    var out=value(type,writable)
    out.root.origins[owner+"|"]=!writable
    var table=numeric_shape(s,out.root)
    table.origins=out.root.origins
    table.base_steps=out.root.origin_steps
    out.numeric=[table]
    if !has(s.shape_prefixes,type) {
        var index=map[string]map[string]bool{"@types":map[string]bool{},"@all":map[string]bool{}}
        for path, id in table.ids { note_prefix(index,path)
            note_type(index,path,table.types[table.facts[id][0]]) }
        s.shape_prefixes[type]=index }
    out.prefixes=unwrap(s.shape_prefixes[type])
    return out
}
fn parameter_seeded(s mut State, type string, writable bool, owner string) Value {
    # Owners no longer retain separate wide maps. The shape is shared; the
    # one root origin is enough to answer every numeric field query exactly.
    return seeded(s,type,writable,owner)
}
fn copy_view(input View) View { var out=input
    if record(out.type_name) { if !out.writable { out.deep_owned=false }
        out.readonly_children=out.readonly_children || !out.writable
        out.writable=true
        out.record_copy=true }
    return out
}
# Projection tables and their index are immutable views. The prefix is relative
# to that shared table; readonly_fields preserves inherited restrictions even
# after a record root is copied. Editing first detaches a logical member table.
fn overlay_existing(input Value) bool {
    for path, unused in input.patches { if !has(input.fields,path) && !(len(input.numeric)>0 && has(input.numeric[0].ids,path)) { return false } }
    return true
}
fn materialized(input Value) Value {
    if input.copied_fields || input.copy_readonly {
        var out=value("",false)
        out.root=input.root
        out.positions=input.positions
        for full, unused in field_paths(input) { if visible_field(input,full) {
            let path=field_relative(input,full)
            out.fields[path]=field_fact(input,path,"") } }
        out.prefixes=prefix_index(out.fields)
        return out }
    if len(input.numeric)>0 {
        var dense=input
        dense.fields=map[string]View{}
        let table=input.numeric[0]
        for path, id in table.ids { dense.fields[path]=numeric_view(table,id) }
        for path, fact in input.fields { dense.fields[path]=fact }
        dense.numeric=[]
        return materialized(dense) }
    if input.prefix=="" && !input.readonly_fields && len(input.patches)==0 && len(input.cuts)==0 { return input }
    var out=input
    # Point overrides cannot change topology. Reuse the immutable index; only
    # an actual type replacement needs a new conservative type bucket.
    if input.prefix=="" && !input.readonly_fields && len(input.patches)>0 && len(input.cuts)==0 && overlay_existing(input) {
        out.fields=clone(input.fields)
        var type_changed=false
        for path, fact in input.patches {
            if fact.type_name!=unwrap(input.fields[path]).type_name { type_changed=true }
            out.fields[path]=fact }
        if type_changed { out.prefixes=clone(input.prefixes)
            for path, fact in input.patches { note_type(out.prefixes,path,fact.type_name) } }
        out.patches=map[string]View{}
        out.cuts=map[string]bool{}
        return out }
    var backing=input.fields
    if len(input.patches)>0 || len(input.cuts)>0 {
        backing=map[string]View{}
        for path, fact in input.fields { if len(input.cuts)==0 || !has(input.cuts,path) { backing[path]=fact } }
        for path, fact in input.patches { backing[path]=fact } }
    out.patches=map[string]View{}
    out.cuts=map[string]bool{}
    out.fields=map[string]View{}
    if input.prefix=="" && !input.readonly_fields { out.fields=backing }
    else if input.prefix=="" {
        for path, fact in backing { var next=fact
            if input.readonly_fields { next.writable=false
                next.readonly_children=true }
            out.fields[path]=next }
    } else {
        for path, fact in backing { if strings.starts_with(path,input.prefix+"#@") {
            var next=fact
            if input.readonly_fields { next.writable=false
                next.readonly_children=true }
            out.fields[unwrap(strings.slice(path,len(input.prefix),len(path)))]=next } }
    }
    if input.prefix=="" && has(input.prefixes,"@types") && overlay_existing(input) {
        out.prefixes=input.prefixes
        var changed_type=false
        for path, fact in input.patches { if fact.type_name!=unwrap(input.fields[path]).type_name { changed_type=true } }
        if changed_type { out.prefixes=prefix_index(out.fields) }
    } else { out.prefixes=prefix_index(out.fields) }
    out.prefix=""
    out.readonly_fields=false
    return out
}
fn copied(input Value) Value {
    var out=input
    out.root=copy_view(input.root)
    if record(input.root.type_name) {
        out.copy_readonly=input.copy_readonly || input.readonly_fields || !input.root.writable
        out.copied_fields=true
        out.readonly_fields=false }
    return out
}
fn field_policy(input Value, fact View) View {
    var out=fact
    if input.copy_readonly { out.writable=false
        out.readonly_children=true }
    if input.copied_fields { out=copy_view(out) }
    if input.readonly_fields { out.writable=false
        out.readonly_children=true }
    return out
}
fn merge_view(a View, b View) View { var out=a
    out.origins=clone(origin_terms(a))
    out.origin_steps=""
    out.writable=a.writable && b.writable
    out.readonly_children=a.readonly_children || b.readonly_children
    out.deep_owned=a.deep_owned && b.deep_owned
    out.record_copy=a.record_copy && b.record_copy
    for origin, readonly in origin_terms(b) { out.origins[origin]=readonly || unwrap_or(out.origins[origin],false) }
    return out
}
# unwrap_or evaluates both arguments. Construct fallback projections only for
# missing fields, rather than once for every field in a complete shape.
# A subtree cut hides old backing keys; exact point overrides take precedence.
# Base topology remains an immutable superset. New descendants live in patches.
# Cuts are exact backing keys. Colon-prefixed entries are topology markers.
fn hidden_field(input Value, full string) bool { return has(input.cuts,full) }
fn field_exists(input Value, full string) bool {
    if has(input.patches,full) { return true }
    if len(input.cuts)>0 && has(input.cuts,full) { return false }
    if has(input.fields,full) { return true }
    return len(input.numeric)>0 && has(input.numeric[0].ids,full)
}
fn descendants(input Value, full string) bool {
    return has(input.prefixes,full) || has(input.cuts,":"+full)
}
fn field_fact(input Value, path string, type string) View {
    let full=input.prefix+path
    if has(input.patches,full) { var fact=unwrap(input.patches[full])
        if input.copied_fields || input.copy_readonly { return field_policy(input,fact) }
        if input.readonly_fields { fact.writable=false
            fact.readonly_children=true }
        return fact }
    if len(input.cuts)>0 && has(input.cuts,full) { return projected(input.root,path,type) }
    if has(input.fields,full) { var fact=unwrap(input.fields[full])
        if input.copied_fields || input.copy_readonly { return field_policy(input,fact) }
        if input.readonly_fields { fact.writable=false
            fact.readonly_children=true }
        return fact }
    if len(input.numeric)>0 && has(input.numeric[0].ids,full) {
        let table=input.numeric[0]
        var fact=numeric_view(table,unwrap(table.ids[full]))
        if input.copied_fields || input.copy_readonly { return field_policy(input,fact) }
        if input.readonly_fields { fact.writable=false
            fact.readonly_children=true }
        return fact }
    return projected(input.root,path,type)
}
fn merge_canonical(a Value, b Value) Value { let left=a
    let right=b
    var out=clone(left)
    if !has(out.prefixes,"@types") { out.prefixes=prefix_index(out.fields) }
    out.root=merge_view(a.root,b.root)
    # Count unmatched left keys while visiting the right table. Materialization
    # has already applied inherited readonly flags and removed the view cursor.
    # A unique matching key can discharge one left key exactly once.
    var remaining=len(left.fields)
    for path, item in right.fields {
        if has(left.fields,path) { remaining-=1
            let previous=unwrap(left.fields[path])
            if !same_view(previous,item) { let combined=merge_view(previous,item)
                out.fields[path]=combined
                note_prefix(out.prefixes,path)
                note_type(out.prefixes,path,combined.type_name) }
        } else { let combined=merge_view(projected(left.root,path,item.type_name),item)
            out.fields[path]=combined
            note_prefix(out.prefixes,path)
            note_type(out.prefixes,path,combined.type_name) } }
    if remaining>0 { for path, item in left.fields { if !has(right.fields,path) { out.fields[path]=merge_view(item,projected(b.root,path,item.type_name)) } } }
    for i in 0..len(out.positions) { if i<len(b.positions) { out.positions[i]=merge(out.positions[i],b.positions[i]) } }
    return out
}

fn merge(a Value, b Value) Value {
    if same_numeric(a,b) && len(a.positions)==0 && len(b.positions)==0 {
        var out=a
        out.root=merge_view(a.root,b.root)
        return out }
    if canonical(a) && canonical(b) { return merge_canonical(a,b) }
    var out=value("",false)
    out.root=merge_view(a.root,b.root)
    out.positions=clone(a.positions)
    # Enumerate live keys once and merge directly from numeric/sparse facts.
    for full, unused in field_paths(a) { if visible_field(a,full) {
        let path=field_relative(a,full)
        let item=field_fact(a,path,"")
        if field_exists(b,b.prefix+path) { let right=field_fact(b,path,"")
            if same_view(item,right) { out.fields[path]=item }
            else { out.fields[path]=merge_view(item,right) } }
        else { out.fields[path]=merge_view(item,projected(b.root,path,item.type_name)) } } }
    for full, unused in field_paths(b) { if visible_field(b,full) {
        let path=field_relative(b,full)
        if !has(out.fields,path) { let item=field_fact(b,path,"")
            out.fields[path]=merge_view(projected(a.root,path,item.type_name),item) } } }
    out.prefixes=prefix_index(out.fields)
    for i in 0..len(out.positions) { if i<len(b.positions) { out.positions[i]=merge(out.positions[i],b.positions[i]) } }
    return out
}
fn select_root(input Value, path string, type string) Value { var out=value(type,false)
    out.root=field_fact(input,path,type)
    out.root.type_name=type
    if !input.root.writable { out.root.writable=false
        out.root.readonly_children=true }
    return out
}
fn select(input Value, path string, type string) Value { var out=select_root(input,path,type)
    let prefix=input.prefix+path
    if !has(input.prefixes,prefix) {
        if len(input.patches)==0 || !descendants(input,prefix) { return out } }
    out.fields=input.fields
    out.numeric=input.numeric
    out.copied_fields=input.copied_fields
    out.copy_readonly=input.copy_readonly
    out.patches=input.patches
    out.cuts=input.cuts
    out.prefixes=input.prefixes
    out.prefix=prefix
    out.readonly_fields=input.readonly_fields || !input.root.writable
    return out
}
# Projection is now constant work and retains immutable tables. A second map
# of whole projections would duplicate bookkeeping and keep redundant snapshots.
fn select_cached(e mut Environment, input Value, path string, type string, owner string, version int) Value {
    return select(input,path,type)
}
# Values share immutable member/origin metadata. Changes to a field table go
# through editable()/merge() before publication; attaching or changing the root
# flags/type does not mutate the input table. Keep explicit deep clones for
# writable edits, branch isolation and unknown-call conservative rewrites.
fn attach(out mut Value, path string, input Value, copy bool) {
    if out.copied_fields || out.copy_readonly || len(out.numeric)>0 || out.prefix!="" || out.readonly_fields || len(out.patches)>0 || len(out.cuts)>0 { let logical=materialized(out)
        out.fields=clone(logical.fields)
        out.numeric=[]
        out.copied_fields=false
        out.copy_readonly=false
        out.prefixes=clone(logical.prefixes)
        out.prefix=""
        out.readonly_fields=false
        out.patches=map[string]View{}
    out.cuts=map[string]bool{} }
    if !has(out.prefixes,"@types") { out.prefixes=prefix_index(out.fields) }
    var item=input
    if copy { item=copied(item) }
    if depth(path)<=8 { out.fields[path]=item.root
        note_prefix(out.prefixes,path)
        note_type(out.prefixes,path,item.root.type_name) }
    for full, unused in field_paths(item) { if !visible_field(item,full) { continue }
        let name=field_relative(item,full)
        let fact=field_fact(item,name,"")
        if depth(path+name)<=8 { out.fields[path+name]=fact
            note_prefix(out.prefixes,path+name)
            note_type(out.prefixes,path+name,fact.type_name) }
        else { var parent=unwrap_or(out.fields[path],item.root)
            if !parent.deep_owned { parent.readonly_children=true }
            out.fields[path]=parent } }
}
fn projection(refs map[string]string, module string, pool ast.Pool, n ast.Node) string {
    let k=ast.kind(n.payload)
    if k=="Name" || (k=="Member" && target(refs,module,n)!="") { return target(refs,module,n) }
    if k=="Member" || k=="Index" { let parent=projection(refs,module,pool,get(pool,n.children[0]))
        if parent!="" { if k=="Index" { return parent+"#@[]" }
            return parent+"#@"+ast.payload_text(n.payload) } }
    return ""
}
fn path_owner(path string) string { return strings.split(path,"#@")[0] }
fn path_tail(path string) string { return rules.cut(path,len(path_owner(path)),len(path)) }
fn value_path(values map[string]Value, path string) Value { let owner=path_owner(path)
    if !has(values,owner) { return value("",false) }
    let root=unwrap(values[owner])
    let suffix=path_tail(path)
    if suffix=="" { return root }
    return select(root,suffix,field_fact(root,suffix,"").type_name)
}
fn lookup_path(values map[string]Value, path string) Value { return value_path(values,path) }
fn same_storage(a View, b View) bool {
    var left=a.origins
    var right=b.origins
    if a.origin_steps!="" { left=origin_terms(a) }
    if b.origin_steps!="" { right=origin_terms(b) }
    for origin, unused in left { if has(right,origin) { return true } }
    return false
}
# Monotonic stamps describe only immutable environment bindings. A restored
# branch keeps the allocator monotonic, so two independent writes never compare
# equal merely because each branch performed the same number of assignments.
fn commit(e mut Environment, name string, input Value, keep_aliases bool) {
    if !keep_aliases && len(e.alias_cache)>0 { e.alias_cache=map[string][]string{} }
    e.next_version+=1
    e.values[name]=input
    e.versions[name]=e.next_version
}
fn store(e mut Environment, name string, input Value) { commit(e,name,input,false) }
# A summary write batch evaluates no input AST and publishes no intermediate
# node/exit snapshots. Detach each changed table once, then retain private writable
# handles until the batch ends. The caller snapshots always keep the old tables.
fn begin_updates(e mut Environment) { e.updating=true }
fn end_updates(e mut Environment) {
    e.updating=false
    e.patch_batches=map[string]map[string]View{}
    e.cut_batches=map[string]map[string]bool{}
    if len(e.edited_fields)>0 || len(e.edited_prefixes)>0 {
        e.edited_fields=map[string]map[string]View{}
        e.edited_prefixes=map[string]map[string]map[string]bool{} }
}
fn editable(e mut Environment, input Value, owner string) Value {
    var out=input
    if e.updating && has(e.edited_fields,owner) && len(input.patches)==0 && len(input.cuts)==0 {
        out.fields=unwrap(e.edited_fields[owner])
        out.prefixes=unwrap(e.edited_prefixes[owner])
        out.prefix=""
        out.readonly_fields=false
        return out }
    out=clone(materialized(input))
    out.patches=map[string]View{}
    out.cuts=map[string]bool{}
    if e.updating { e.edited_fields[owner]=out.fields
        e.edited_prefixes[owner]=out.prefixes }
    return out
}
fn put(e mut Environment, path string, input Value, weak bool, copy bool) {
    let owner=path_owner(path)
    let suffix=path_tail(path)
    if owner=="" || !has(e.values,owner) { return }
    var root=unwrap(e.values[owner])
    if depth(suffix)>8 {
        delete(e.patch_batches,owner)
        delete(e.cut_batches,owner)
        root=editable(e,root,owner)
        let parts=strings.split(suffix,"#@")
        var prefix=""
        for i in 1..9 { prefix+="#@"+parts[i] }
        var ancestor=field_fact(root,prefix,"")
        ancestor.readonly_children=true
        ancestor.deep_owned=false
        root.fields[prefix]=ancestor
        note_prefix(root.prefixes,prefix)
        note_type(root.prefixes,prefix,ancestor.type_name)
        store(e,owner,root)
        if has(e.visible,owner) { e.writes[owner+"|"+prefix]=true }
        return
    }
    if suffix=="" { var next=input
        if copy { next=copied(input) }
        next.root.type_name=root.root.type_name
        if !rules.shared(next.root.type_name) { next.root.writable=root.root.writable }
        # A replacement may share its immutable fields with the source value.
        # The next descendant write must detach from that replacement again.
        delete(e.edited_fields,owner)
        delete(e.edited_prefixes,owner)
        delete(e.patch_batches,owner)
        delete(e.cut_batches,owner)
        store(e,owner,next)
        if has(e.visible,owner) { e.writes[owner+"|"]=true
            for full, unused in field_paths(next) { if visible_field(next,full) { e.writes[owner+"|"+field_relative(next,full)]=true } } }
        return }
    var item=input
    if copy { item=copied(item) }
    if weak { item=merge(lookup_path(e.values,path),item) }
    let has_children=descendants(root,root.prefix+suffix)
    if !has_children && !has_fields(item) && len(item.positions)==0 && field_exists(root,root.prefix+suffix) && same_view(field_fact(root,suffix,item.root.type_name),item.root) {
        if has(e.visible,owner) { e.writes[owner+"|"+suffix]=true }
        return }
    let old=field_fact(root,suffix,"")
    let keep_aliases=!has_children && !has_fields(item) && len(item.positions)==0 && !rules.shared(old.type_name) && !rules.shared(item.root.type_name)
    if root.copied_fields || root.copy_readonly || root.prefix!="" || root.readonly_fields { root=materialized(root) }
    delete(e.edited_fields,owner)
    delete(e.edited_prefixes,owner)
    # Detach sparse metadata once per ordered summary batch. No input AST,
    # exit or node snapshot can retain the private batch handles.
    if e.updating && has(e.patch_batches,owner) {
        root.patches=unwrap(e.patch_batches[owner])
        root.cuts=unwrap(e.cut_batches[owner])
    } else {
        root.patches=clone(root.patches)
        root.cuts=clone(root.cuts)
        if e.updating { e.patch_batches[owner]=root.patches
            e.cut_batches[owner]=root.cuts } }
    if has_children {
        root.cuts[suffix]=true
        if has(root.prefixes,suffix) {
            for name, unused in unwrap(root.prefixes[suffix]) { root.cuts[name]=true } }
        # Delete superseded overrides, preserving older snapshots and exact
        # backing-key masks. A later override takes precedence over its mask.
        var removed []string=[]
        var removals=list.from_slice(removed)
        for name, unused in root.patches { if name==suffix || strings.starts_with(name,suffix+"#@") { unwrap(list.append(removals,name)) } }
        for name in list.snapshot(removals) { delete(root.patches,name) }
    }
    # Sparse coverage needs no dense topology rebuild. Match attach()'s
    # eight-level truncation while retaining only the replacement facts.
    root.patches[suffix]=item.root
    for full, unused in field_paths(item) { if !visible_field(item,full) { continue }
        let name=field_relative(item,full)
        let fact=field_fact(item,name,"")
        if depth(suffix+name)<=8 {
            root.patches[suffix+name]=fact
            let parts=strings.split(name,"#@")
            var prefix=suffix
            if !has(root.prefixes,prefix) { root.cuts[":"+prefix]=true }
            for i in 1..(len(parts)-1) { prefix+="#@"+parts[i]
                if !has(root.prefixes,prefix) { root.cuts[":"+prefix]=true } }
        }
        else { var parent=unwrap(root.patches[suffix])
            if !parent.deep_owned { parent.readonly_children=true }
            root.patches[suffix]=parent } }
    commit(e,owner,root,keep_aliases)
    if has(e.visible,owner) { e.writes[owner+"|"+suffix]=true
        for full, unused in field_paths(item) { if visible_field(item,full) { let name=field_relative(item,full)
            if depth(suffix+name)<=8 { e.writes[owner+"|"+suffix+name]=true } } } }
}
# Cache the exact old enumeration order. Shared-container alias membership
# cannot change when a child-free nonshared field changes; other stores and
# branch restoration clear the cache before the next query.
fn storage_aliases(e mut Environment, container View) Result<[]string> {
    var empty []string=[]
    if len(container.origins)==0 { return ok(empty) }
    var identity=""
    if rules.shared(container.type_name) { let encoded=json.encode(origin_terms(container))
        if is_ok(encoded) { identity=str(len(container.type_name))+":"+container.type_name+":"+unwrap(encoded)
            if has(e.alias_cache,identity) { return ok(unwrap(e.alias_cache[identity])) } } }
    var found=list.from_slice(empty)
    for owner, root in e.values {
        if same_storage(root.root,container) { list.append(found,owner)? }
        let paths=alias_paths(root,container.type_name)
        for full, unused in paths { if visible_field(root,full) {
            let path=field_relative(root,full)
            let field=field_fact(root,path,"")
            if field.type_name==container.type_name && same_storage(field,container) { list.append(found,owner+path)? } } }
    }
    let result=list.snapshot(found)
    if identity!="" { e.alias_cache[identity]=result }
    return ok(result)
}
fn assign(refs map[string]string, e mut Environment, left ast.Node, input Value) Result<void> {
    let path=projection(refs,e.unit.id,e.unit.tree.pool,left)
    if path=="" { return ok() }
    if ast.kind(left.payload)!="Index" { put(e,path,input,false,true)
        return ok() }
    let container=lookup_path(e.values,projection(refs,e.unit.id,e.unit.tree.pool,get(e.unit.tree.pool,left.children[0])))
    let destinations=storage_aliases(e,container.root)?
    for destination in destinations { put(e,destination+"#@[]",input,true,true) }
    return ok()
}
fn require_write(s mut State, e mut Environment, n ast.Node, fact View) Result<void> {
    if !fact.writable { denied(s,e,n,"read-only member/view")? }
    if !fact.record_copy { for origin, readonly in origin_terms(fact) { e.required[origin]=readonly || unwrap_or(e.required[origin],false) } }
    return ok()
}
fn bind(declarations map[string]string, e mut Environment, n ast.Node, input Value, mutable bool) { let name=declaration(declarations,e.unit.id,n)
    if name=="" { return }
    var next=copied(input)
    next.root.writable=mutable && (!rules.shared(next.root.type_name) || input.root.writable)
    store(e,name,next)
}
fn instantiate_view_at(site string, source View, actual map[string]Value) View {
    var out=source
    out.origins=map[string]bool{}
    out.origin_steps=""
    var source_origins=source.origins
    if source.origin_steps!="" { source_origins=origin_terms(source) }
    for origin, readonly in source_origins { let parts=split_origin(origin)
        if has(actual,parts[0]) { let root=unwrap(actual[parts[0]])
            var fact=root.root
            if parts[1]!="" { fact=field_fact(root,parts[1],source.type_name)
                if !field_exists(root,root.prefix+parts[1]) && !root.root.deep_owned { fact.writable=false
                    fact.readonly_children=true }
                if !root.root.writable { fact.writable=false
                    fact.readonly_children=true } }
            if !source.record_copy { out.writable=out.writable && fact.writable && !readonly
                out.readonly_children=out.readonly_children || fact.readonly_children || readonly }
            var fact_origins=fact.origins
            if fact.origin_steps!="" { fact_origins=origin_terms(fact) }
            for name, flag in fact_origins { out.origins[name]=flag || readonly || unwrap_or(out.origins[name],false) }
        } else { var owner=parts[0]
            var path=parts[1]
            if strings.contains(owner,"!") {
                if !strings.starts_with(path,"@") { path="@"+owner+path }
                owner=site
            }
            out.origins[owner+"|"+path]=readonly }
    }
    return out
}
# Root and every field are rebuilt below; avoid deep-cloning their discarded
# source values first. Positions still clone their slice before indexed updates.
# Keep prefixes independent too, so the result retains the old clone isolation.
fn instantiate_canonical(site string, source Value, actual map[string]Value) Value {
    let logical=source
    var out=Value{root:instantiate_view_at(site,source.root,actual),fields:map[string]View{},prefixes:clone(logical.prefixes),prefix:"",readonly_fields:false,positions:clone(source.positions),patches:map[string]View{},cuts:map[string]bool{},numeric:[],copied_fields:false,copy_readonly:false}
    for path, fact in logical.fields { out.fields[path]=instantiate_view_at(site,fact,actual) }
    for i in 0..len(source.positions) { out.positions[i]=instantiate_at(site,source.positions[i],actual) }
    return out
}
# Keep the isolated helper entry points; production calls bind the immutable
# site once and pass three arguments through the entire value/position tree.

fn instantiate_at(site string, source Value, actual map[string]Value) Value {
    if canonical(source) { return instantiate_canonical(site,source,actual) }
    var out=value("",false)
    out.root=instantiate_view_at(site,source.root,actual)
    out.positions=clone(source.positions)
    for full, unused in field_paths(source) { if visible_field(source,full) {
        let path=field_relative(source,full)
        out.fields[path]=instantiate_view_at(site,field_fact(source,path,""),actual) } }
    if source.prefix=="" && overlay_existing(source) { out.prefixes=clone(source.prefixes) }
    else { out.prefixes=prefix_index(out.fields) }
    for i in 0..len(source.positions) { out.positions[i]=instantiate_at(site,source.positions[i],actual) }
    return out
}
fn instantiate_view(caller string, module string, node int, source View, actual map[string]Value) View {
    return instantiate_view_at(caller+"!"+key(module,node),source,actual)
}
fn instantiate(caller string, module string, node int, source Value, actual map[string]Value) Value {
    return instantiate_at(caller+"!"+key(module,node),source,actual)
}
fn invoke(s mut State, e mut Environment, n ast.Node, f Function, args []Value) Result<Value> {
    # Summaries cannot change during a body traversal. Collect each consulted
    # target once, including aliases/self-recursion and invalid-argument calls.
    # Publish these edges before the body's new summary can invalidate callers.
    if s.probing && e.function!="" && !has(e.callees,f.target) { e.callees[f.target]=true }
    if len(args)!=len(f.parameters) { return ok(value(f.result,false)) }
    for i in 0..len(args) { if !rules.compatible(f.parameters[i].type_name,args[i].root.type_name) { return ok(value(f.result,false)) } }
    # Snapshot exactly the parameter/global bindings before writes. Their
    # metadata stays immutable: put() detaches a changed binding, so pre-call
    # return/requirement instantiation can share the old fields safely.
    var actual=map[string]Value{}
    for owner, unused in s.global_symbols { if has(e.values,owner) { actual[owner]=unwrap(e.values[owner]) } }
    for i in 0..len(f.parameters) { if i<len(args) { actual[f.parameters[i].target]=args[i]
        if f.parameters[i].writable && !args[i].root.writable { denied(s,e,get(e.unit.tree.pool,n.children[i+1]),"mut borrow requires writable argument")? } } }
    if !has(s.summaries,f.target) {
        unwrap(list.append(e.consultations,Consultation{target:f.target,site:"",actual:actual,returned:value(f.result,true),return_version:0,write_version:0,required_version:0,control_version:0}))
        return ok(value(f.result,true)) }
    let summary=unwrap(s.summaries[f.target])
    if summary.unknown {
        for owner, input in e.values { if has(s.global_symbols,owner) || has(e.visible,owner) {
            var conservative=conservative_value(input)
            if record(input.root.type_name) { conservative.root.writable=input.root.writable }
            else if !has(s.global_symbols,owner) { conservative.root.writable=input.root.writable }
            store(e,owner,conservative)
        } }
        for i in 0..len(f.parameters) { if f.parameters[i].writable && i+1<len(n.children) {
            let path=projection(s.refs,e.unit.id,e.unit.tree.pool,get(e.unit.tree.pool,n.children[i+1]))
            if path!="" { let input=lookup_path(e.values,path)
                var conservative=conservative_value(input)
                conservative.root.writable=input.root.writable
                put(e,path,conservative,false,false)
            }
        } }
    }
    for origin, readonly in summary.required { let parts=split_origin(origin)
        if has(actual,parts[0]) { let root=unwrap(actual[parts[0]])
            var fact=root.root
            if parts[1]!="" { fact=field_fact(root,parts[1],"") }
            if readonly || !fact.writable { denied(s,e,n,"callee writes through a read-only member/view")? }
            if !fact.record_copy { var fact_origins=fact.origins
            if fact.origin_steps!="" { fact_origins=origin_terms(fact) }
            for name, flag in fact_origins { e.required[name]=flag || unwrap_or(e.required[name],false) } } } }
    let site=e.function+"!"+key(e.unit.id,n.id.index)
    if len(summary.writes)>0 { begin_updates(e) }
    # Argument syntax and resolved names are immutable within this call. Cache
    # owner resolution only; preserve ordered effects and the pre-write actuals.
    var write_arguments=map[string]WriteArgument{}
    let instantiated_writes=memo_writes(s,site,summary,actual)
    for origin, effect in summary.effects { let parts=[effect.owner,effect.path]
        let fact=effect.fact
        if !has(write_arguments,parts[0]) {
            var argument=WriteArgument{destination:parts[0],parameter:false,writable:false}
            for i in 0..len(f.parameters) { if f.parameters[i].target==parts[0] {
                argument.parameter=true
                argument.writable=f.parameters[i].writable
                if i+1<len(n.children) { argument.destination=projection(s.refs,e.unit.id,e.unit.tree.pool,get(e.unit.tree.pool,n.children[i+1])) } } }
            write_arguments[parts[0]]=argument }
        let argument=unwrap(write_arguments[parts[0]])
        let destination=argument.destination
        let parameter=argument.parameter
        let mutable=argument.writable
        if parameter && !mutable { continue }
        if (destination=="" && (!parameter || !strings.contains(parts[1],"#@[]"))) || (e.deferred && parameter && record(unwrap(actual[parts[0]]).root.type_name) && !strings.contains(parts[1],"#@[]")) { continue }
        var changed=value(fact.type_name,false)
        changed.root=unwrap(instantiated_writes[origin])
        if parts[1]=="" { put(e,destination,changed,false,false) }
        else { let path=destination+parts[1]
            # Install the summary fact as-is before weakly updating shared aliases.
            if destination!="" { put(e,path,changed,e.deferred,false) }
            if strings.contains(parts[1],"#@[]") {
                let start=strings.index(parts[1],"#@[]")
                let ancestor=rules.cut(parts[1],0,start)
                let suffix=rules.cut(parts[1],start,len(parts[1]))
                var container=lookup_path(e.values,destination+ancestor)
                if destination=="" && parameter {
                    container=unwrap(actual[parts[0]])
                    if ancestor!="" { container=select(container,ancestor,"") }
                }
                let aliases=storage_aliases(e,container.root)?
                for alias in aliases { put(e,alias+suffix,changed,true,true) }
            } }
    }
    if len(summary.writes)>0 { end_updates(e) }
    var result=memo_return(s,site,summary,actual)
    result.root.type_name=f.result
    unwrap(list.append(e.consultations,Consultation{target:f.target,site:site,actual:actual,returned:result,return_version:summary.return_version,write_version:summary.write_version,required_version:summary.required_version,control_version:summary.control_version}))
