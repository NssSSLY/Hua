fn expression_body(s mut State, e mut Environment, n ast.Node) Result<Value> {
    let k=ast.kind(n.payload)
    let text=ast.payload_text(n.payload)
    if k=="Name" || (k=="Member" && target(s.refs,e.unit.id,n)!="") { let name=target(s.refs,e.unit.id,n)
        if has(s.functions,name) { return ok(value("fn:"+name,false)) }
        if has(s.variants,name) { return ok(value("variant:"+name,false)) }
        if strings.starts_with(name,"builtin:") { return ok(value(name,false)) }
        if has(e.values,name) { return ok(unwrap(e.values[name])) }
        return ok(value("",false)) }
    if k=="StructLiteral" { var out=value(target(s.refs,e.unit.id,n),true)
        out.root.origins[e.function+"!"+key(e.unit.id,n.id.index)+"|"]=false
        # Literal fields come only from their initializers, not borrowed type defaults.
        for child in n.children { let field=get(e.unit.tree.pool,child)
            let name=ast.payload_text(field.payload)
            var item=expression(s,e,field.children[0])?
            item.root.type_name=unwrap_or(s.fields[out.root.type_name+"#"+name],item.root.type_name)
            attach(out,"#@"+name,item,true) }
        return ok(out) }
    if k=="Array" || k=="MapLiteral" || k=="Pack" { var out=value("",true)
        out.root.origins[e.function+"!"+key(e.unit.id,n.id.index)+"|"]=false
        var seen=false
        var element=value("",false)
        var empty []Value=[]
        var positions=list.from_slice(empty)
        var types []string=[]
        var type_names=list.from_slice(types)
        var offset=0
        if k=="MapLiteral" { offset=1 }
        for i in offset..len(n.children) { var child=get(e.unit.tree.pool,n.children[i])
            if k=="MapLiteral" { expression(s,e,child.children[0])?
                child=get(e.unit.tree.pool,child.children[1]) }
            let item=expression(s,e,child.id)?
            if k=="Pack" { list.append(positions,item)?
                list.append(type_names,item.root.type_name)? }
            else { let next=copied(item)
                if seen { element=merge(element,next) }
                else { element=next
                    seen=true } } }
        if k=="Pack" { out.positions=list.snapshot(positions)
            out.root.type_name="multi<"+strings.join(list.snapshot(type_names),",")+">"
            return ok(out) }
        out.root.type_name="[]"+element.root.type_name
        if k=="MapLiteral" { out.root.type_name=type_name(s.refs,e.unit.id,e.unit.tree.pool,n.children[0]) }
        if seen { attach(out,"#@[]",element,false) }
        return ok(out) }
    if k=="Member" || k=="Index" || k=="Slice" { let base=expression(s,e,n.children[0])?
        let base_node=get(e.unit.tree.pool,n.children[0])
        var owner=""
        var version=0
        if ast.kind(base_node.payload)=="Name" || (ast.kind(base_node.payload)=="Member" && target(s.refs,e.unit.id,base_node)!="") {
            let name=target(s.refs,e.unit.id,base_node)
            if has(e.values,name) { owner=name
                version=unwrap_or(e.versions[name],0) } }
        var path="#@"+text
        var typ=unwrap_or(s.fields[rules.optional(base.root.type_name)+"#"+text],"")
        if k!="Member" { path="#@[]"
            typ=child_type(base.root.type_name)
            for i in 1..len(n.children) { if ast.kind(get(e.unit.tree.pool,n.children[i]).payload)!="Omitted" { expression(s,e,n.children[i])? } } }
        if k=="Slice" { var out=base
            out.root.type_name="[]"+typ
            return ok(out) }
        var out=select_cached(e,base,path,typ,owner,version)
        out.root.record_copy=false
        if k=="Index" && len(rules.arguments(base.root.type_name,"map"))==2 { out.root.type_name=typ+"?" }
        return ok(out) }
    if k=="Propagate" { var out=expression(s,e,n.children[0])?
        let ts=rules.arguments(out.root.type_name,"Result")
        if len(ts)==2 { out.root.type_name=ts[0] }
        return ok(out) }
    if k=="Assignment" || k=="Update" { let left=get(e.unit.tree.pool,n.children[0])
        if ast.kind(left.payload)!="Name" { expression(s,e,left.id)?
            let base=unwrap(s.facts[key(e.unit.id,left.children[0].index)])
            require_write(s,e,left,base.root)? }
        if k=="Assignment" { let right=expression(s,e,n.children[1])?
            if text=="=" { assign(s.refs,e,left,right)? } }
        return ok(value("",false)) }
    if k=="Call" { let callee=expression(s,e,n.children[0])?
        var empty []Value=[]
        var items=list.from_slice(empty)
        for i in 1..len(n.children) { list.append(items,expression(s,e,n.children[i])?)? }
        let args=list.snapshot(items)
        let name=callee.root.type_name
        if strings.starts_with(name,"variant:") { let variant=rules.cut(name,8,len(name))
            return ok(seeded(s,unwrap(s.variants[variant]),true,e.function+"!"+key(e.unit.id,n.id.index))) }
        if strings.starts_with(name,"fn:") { let fn_name=rules.cut(name,3,len(name))
            if has(s.functions,fn_name) { return invoke(s,e,n,unwrap(s.functions[fn_name]),args) } }
        if len(args)>0 && alg.contains(["builtin:core:ok","builtin:core:err","builtin:core:unwrap","builtin:core:unwrap_err","builtin:core:unwrap_or","builtin:core:clone"],name) { var out=args[0]
            if name=="builtin:core:clone" { out=seeded(s,args[0].root.type_name,true,e.function+"!"+key(e.unit.id,n.id.index))
                out.root.deep_owned=true
                out.fields=field_defaults(s,out.root,0)
                out.numeric=[]
                for path, fact in out.fields { var next=fact
                    next.writable=true
                    next.readonly_children=false
                    next.deep_owned=true
                    out.fields[path]=next } }
            else if name=="builtin:core:ok" || name=="builtin:core:err" {
                let payload=out.root.type_name
                if payload!="nil" && payload!="void" && !rules.shared(payload) && !record(payload) { out.root.writable=true }
                if name=="builtin:core:ok" { out.root.type_name="Result<"+payload+",>" }
                else { out.root.type_name="Result<,"+payload+">" } }
            else { let ts=rules.arguments(out.root.type_name,"Result")
                if len(ts)==2 { var side=0
                    if name=="builtin:core:unwrap_err" { side=1 }
                    out.root.type_name=ts[side] }
                else { out.root.type_name=rules.optional(out.root.type_name) }
                if name=="builtin:core:unwrap_or" && len(args)==2 { out=merge(out,args[1]) } }
            return ok(out) }
        let std=signatures.signature(name)
        if is_some(std) { let sig=unwrap(std)
            if sig.mutates && len(args)>0 { require_write(s,e,n,args[0].root)? }
            if name=="builtin:std.list#from_slice" && len(args)>0 { var out=args[0]
                out.root.type_name="List<"+child_type(args[0].root.type_name)+">"
                out.root.writable=true
                out.root.origins=seeded(s,out.root.type_name,true,e.function+"!"+key(e.unit.id,n.id.index)).root.origins
                return ok(out) }
            if name=="builtin:std.list#get" && len(args)>0 { var out=select(args[0],"#@[]",child_type(args[0].root.type_name))
                out.root.writable=false
                out.root.readonly_children=true
                out.root.type_name="Result<"+out.root.type_name+",string>"
                return ok(out) }
            return ok(seeded(s,sig.result,sig.writable,e.function+"!"+key(e.unit.id,n.id.index))) }
        if name=="builtin:core:delete" && len(args)>0 { require_write(s,e,n,args[0].root)? }
        if strings.starts_with(name,"builtin:core:") { return ok(value("",false)) }
        # An unresolved callback may alter shared members. Keep them conservative.
        for owner, input in e.values { if rules.shared(input.root.type_name) || record(input.root.type_name) { var out=clone(materialized(input))
            out.root.readonly_children=true
            out.root.deep_owned=false
            for path, fact in out.fields { var next=fact
                next.writable=false
                next.readonly_children=true
                out.fields[path]=next }
            store(e,owner,out) } }
        return ok(value("",false)) }
    if k=="Integer" { return ok(value("int",false)) }
    if k=="String" { return ok(value("string",false)) }
    if k=="Float" { return ok(value("float",false)) }
    if k=="Boolean" { return ok(value("bool",false)) }
    if k=="Nil" { return ok(value("nil",false)) }
    for child in n.children { expression(s,e,child)? }
    return ok(value("",false))
}
fn type_name(refs map[string]string, module string, pool ast.Pool, id ast.NodeId) string { let n=get(pool,id)
    let k=ast.kind(n.payload)
    let text=ast.payload_text(n.payload)
    if k=="TypeName" { let name=target(refs,module,n)
        if strings.starts_with(name,"builtin:type:") { return text }
        return name }
    if k=="MutableType" { return type_name(refs,module,pool,n.children[0]) }
    if k=="OptionalType" { return type_name(refs,module,pool,n.children[0])+"?" }
    if k=="SliceType" { return "[]"+type_name(refs,module,pool,n.children[0]) }
    if k=="ArrayType" { return "["+text+"]"+type_name(refs,module,pool,n.children[0]) }
    var empty []string=[]
    var names=list.from_slice(empty)
    for child in n.children { unwrap(list.append(names,type_name(refs,module,pool,child))) }
    if text=="Result" && len(n.children)==1 { unwrap(list.append(names,"string")) }
    return text+"<"+strings.join(list.snapshot(names),",")+">"
}
# Copy the binding table, sharing immutable per-value metadata until put() detaches.
fn snapshot(values map[string]Value) map[string]Value { var out=map[string]Value{}
    for name, input in values { out[name]=input }
    return out
}
fn join(e mut Environment, other map[string]Value, versions map[string]int) {
    for name, input in e.values { if has(other,name) && unwrap_or(e.versions[name],0)!=unwrap_or(versions[name],0) {
        let previous=unwrap(other[name])
        if !same_value(input,previous) { store(e,name,merge(input,previous)) } } }
}
fn capture(e mut Environment, input Value) { let next=copied(input)
    if e.saw_return { e.returned=merge(e.returned,next) }
    else { e.returned=next
        e.saw_return=true } }
fn statement(s mut State, e mut Environment, id ast.NodeId) Result<void> { let n=get(e.unit.tree.pool,id)
    tick(s,n.span)?
    let k=ast.kind(n.payload)
    let text=ast.payload_text(n.payload)
    if alg.contains(["Function","Import","Struct","Enum","Break","Continue"],k) { return ok() }
    if k=="Block" || k=="Program" { for child in n.children { statement(s,e,child)? }
        return ok() }
    if k=="Let" || k=="Var" || k=="Const" { var input=expression(s,e,n.children[len(n.children)-1])?
        if len(n.children)==2 { input.root.type_name=type_name(s.refs,e.unit.id,e.unit.tree.pool,n.children[0]) }
        bind(s.declarations,e,n,input,k=="Var")
        return ok() }
    if k=="MultiBinding" || k=="MultiAssignment" { let names=get(e.unit.tree.pool,n.children[0])
        let input=expression(s,e,n.children[1])?
        let ts=rules.arguments(input.root.type_name,"multi")
        for i in 0..len(names.children) { let item=get(e.unit.tree.pool,names.children[i])
            var next=value("",false)
            if i<len(input.positions) { next=input.positions[i] }
            else if i<len(ts) { next.root.type_name=ts[i] }
            if k=="MultiBinding" { bind(s.declarations,e,item,next,text=="var") }
            else { assign(s.refs,e,item,next)? } }
        return ok() }
    if k=="Return" { var empty []Value=[]
        var values=list.from_slice(empty)
        for child in n.children { list.append(values,expression(s,e,child)?)? }
        let items=list.snapshot(values)
        if len(items)==1 { capture(e,items[0]) }
        else { var out=value("",false)
            out.positions=items
            capture(e,out) }
        var snapshot=map[string]Value{}
        for owner, input in e.values { if has(e.visible,owner) { snapshot[owner]=input } }
        var exits=list.from_slice(e.exits)
        list.append(exits,snapshot)?
        e.exits=list.snapshot(exits)
        return ok() }
    if k=="If" { expression(s,e,n.children[0])?
        let before=snapshot(e.values)
        let before_versions=clone(e.versions)
        statement(s,e,n.children[1])?
        let yes=snapshot(e.values)
        let yes_versions=clone(e.versions)
        e.values=snapshot(before)
        e.alias_cache=map[string][]string{}
        e.versions=clone(before_versions)
        if len(n.children)==3 { statement(s,e,n.children[2])? }
        join(e,yes,yes_versions)
