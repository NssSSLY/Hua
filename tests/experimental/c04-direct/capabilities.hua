    if k=="While" || k=="For" { let before=snapshot(e.values)
        let before_versions=clone(e.versions)
        var count=0
        if k=="While" { expression(s,e,n.children[0])? }
        else { count=len(n.children)-2
            let iterable=get(e.unit.tree.pool,n.children[count])
            let input=expression(s,e,iterable.id)?
