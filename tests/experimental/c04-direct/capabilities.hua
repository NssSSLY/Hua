            let previous_versions=clone(e.versions)
            statement(s,e,n.children[len(n.children)-1])?
            join(e,before,before_versions)
            join(e,previous,previous_versions)
            changed=false
            for owner, input in previous { if has(e.values,owner) && unwrap_or(previous_versions[owner],0)!=unwrap_or(e.versions[owner],0) && !same_value(input,unwrap(e.values[owner])) { changed=true } }
        }
        if changed { for owner, input in e.values { var conservative=clone(materialized(input))
            conservative.root.readonly_children=true
            conservative.root.deep_owned=false
            for path, fact in conservative.fields { var item=fact
                item.writable=false
                item.readonly_children=true
                conservative.fields[path]=item }
            store(e,owner,conservative) } }
        return ok() }
    if k=="Match" { expression(s,e,n.children[0])?
        let before=snapshot(e.values)
        let before_versions=clone(e.versions)
        var merged=snapshot(before)
        var merged_versions=clone(before_versions)
        for i in 1..len(n.children) { e.values=snapshot(before)
            e.alias_cache=map[string][]string{}
            e.versions=clone(before_versions)
            let arm=get(e.unit.tree.pool,n.children[i])
            statement(s,e,arm.children[2])?
            join(e,merged,merged_versions)
            merged=snapshot(e.values)
            merged_versions=clone(e.versions) }
        e.values=merged
        e.alias_cache=map[string][]string{}
        e.versions=merged_versions
        return ok() }
    if k=="Defer" { e.deferred=true
        expression(s,e,n.children[0])?
        e.deferred=false
        return ok() }
    if k=="ExpressionStatement" { expression(s,e,n.children[0])?
        return ok() }
    return ok()
}
fn environment(unit modules.Unit, function string, values map[string]Value) Environment {
    var empty []Consultation=[]
    var visible=map[string]bool{}
    for owner, unused in values { visible[owner]=true }
    return Environment{unit:unit,function:function,values:snapshot(values),versions:map[string]int{},next_version:0,updating:false,edited_fields:map[string]map[string]View{},edited_prefixes:map[string]map[string]map[string]bool{},patch_batches:map[string]map[string]View{},cut_batches:map[string]map[string]bool{},alias_cache:map[string][]string{},returned:value("",false),saw_return:false,writes:map[string]bool{},visible:visible,required:map[string]bool{},callees:map[string]bool{},consultations:list.from_slice(empty),exits:[],deferred:false}
}
fn note_reads(paths mut map[string]bool, fact View) {
    for origin, unused in origin_terms(fact) { paths[origin]=true }
}
fn value_reads(paths mut map[string]bool, input Value) {
    note_reads(paths,input.root)
    for full, unused in field_paths(input) { if visible_field(input,full) {
        note_reads(paths,field_fact(input,field_relative(input,full),"")) } }
    for item in input.positions { value_reads(paths,item) }
}
fn summary(e Environment) Summary { var writes=map[string]View{}
    var effects=map[string]Effect{}
    var write_reads=map[string]bool{}
    var return_reads=map[string]bool{}
    for origin, unused in e.writes { let parts=split_origin(origin)
        var fact=lookup_path(e.values,parts[0]+parts[1]).root
        for exit in e.exits { if has(exit,parts[0]) { fact=merge_view(fact,value_path(exit,parts[0]+parts[1]).root) } }
        writes[origin]=fact
        effects[origin]=Effect{owner:parts[0],path:parts[1],fact:fact}
        if len(e.writes)>8 { note_reads(write_reads,fact) } }
    if wide_fields(e.returned) || len(e.returned.positions)>0 { value_reads(return_reads,e.returned) }
    return Summary{returned:e.returned,unknown:false,saw_return:e.saw_return,writes:writes,required:e.required,effects:effects,return_reads:return_reads,write_reads:write_reads,return_version:0,write_version:0,required_version:0,control_version:0}
}
# Read exactly the origins consulted by substitution. Root capability and field
# presence are separate dependencies: absent projections use the old fallback.
# Unrelated actual fields are neither compared nor retained.
fn capture_inputs(paths map[string]bool, actual map[string]Value) Inputs {
    var out=Inputs{facts:map[string]View{},flags:map[string]bool{}}
    for origin, unused in paths { let parts=split_origin(origin)
        let owner=parts[0]
        if !has(actual,owner) { out.flags[origin+"|absent"]=true
            continue }
        let input=unwrap(actual[owner])
        if parts[1]=="" { out.facts[origin]=input.root }
        else { out.facts[origin]=field_fact(input,parts[1],"")
            out.flags[origin+"|present"]=field_exists(input,input.prefix+parts[1])
            out.flags[origin+"|writable"]=input.root.writable
            out.flags[origin+"|owned"]=input.root.deep_owned }
    }
    return out
}
fn same_inputs(a Inputs, b Inputs) bool {
    return same_flags(a.flags,b.flags) && same_fields(a.facts,b.facts)
}
fn memo_return(s mut State, site string, source Summary, actual map[string]Value) Value {
    # Small transfers use the direct path. This is cache admission only.
    if !wide_fields(source.returned) && len(source.returned.positions)==0 { return instantiate_at(site,source.returned,actual) }
    let inputs=capture_inputs(source.return_reads,actual)
    if has(s.return_memos,site) { let prior=unwrap(s.return_memos[site])
        if prior.version==source.return_version && same_inputs(prior.inputs,inputs) { return prior.returned } }
    let result=instantiate_at(site,source.returned,actual)
    if has(s.return_memos,site) || len(s.return_memos)<1024 {
        s.return_memos[site]=Memo{version:source.return_version,inputs:inputs,returned:result,writes:map[string]View{}} }
    return result
}
fn memo_writes(s mut State, site string, source Summary, actual map[string]Value) map[string]View {
    var out=map[string]View{}
    if len(source.effects)<=8 {
        for origin, effect in source.effects { out[origin]=instantiate_view_at(site,effect.fact,actual) }
        return out }
    let inputs=capture_inputs(source.write_reads,actual)
    if has(s.write_memos,site) { let prior=unwrap(s.write_memos[site])
        if prior.version==source.write_version && same_inputs(prior.inputs,inputs) { return prior.writes } }
    for origin, effect in source.effects { out[origin]=instantiate_view_at(site,effect.fact,actual) }
    if has(s.write_memos,site) || len(s.write_memos)<1024 {
        s.write_memos[site]=Memo{version:source.write_version,inputs:inputs,returned:value("",false),writes:out} }
    return out
}
# Versions are scoped to one graph. Only exact semantic changes advance a
# component; failed JSON fast comparisons always fall back to exact equality.
fn version_summary(s mut State, name string, input Summary) Summary {
    var out=input
    if !has(s.summaries,name) { s.next_summary_version+=1
        out.return_version=s.next_summary_version
        out.write_version=s.next_summary_version
        out.required_version=s.next_summary_version
        out.control_version=s.next_summary_version
        return out }
    let prior=unwrap(s.summaries[name])
    out.return_version=prior.return_version
    out.write_version=prior.write_version
    out.required_version=prior.required_version
    out.control_version=prior.control_version
    if !same_value(prior.returned,input.returned) { s.next_summary_version+=1
        out.return_version=s.next_summary_version }
    if !same_fields(prior.writes,input.writes) { s.next_summary_version+=1
        out.write_version=s.next_summary_version }
    if !same_flags(prior.required,input.required) { s.next_summary_version+=1
        out.required_version=s.next_summary_version }
    if prior.unknown!=input.unknown || prior.saw_return!=input.saw_return { s.next_summary_version+=1
        out.control_version=s.next_summary_version }
    return out
}
# Component versions were assigned by exact comparisons in version_summary().
# Comparing them again avoids repeating the same wide-table equality work.
fn changed_versions(a Summary, b Summary) bool {
    return a.return_version!=b.return_version || a.write_version!=b.write_version || a.required_version!=b.required_version || a.control_version!=b.control_version
}
fn same_flags(a map[string]bool, b map[string]bool) bool {
    if len(a)!=len(b) { return false }
    for name, flag in a { if !has(b,name) || flag!=unwrap(b[name]) { return false } }
    return true
}
fn same_view(a View, b View) bool {
    if a.type_name!=b.type_name || a.writable!=b.writable || a.readonly_children!=b.readonly_children || a.deep_owned!=b.deep_owned || a.record_copy!=b.record_copy { return false }
    if a.origin_steps==b.origin_steps && same_flags(a.origins,b.origins) { return true }
    if a.origin_steps=="" && b.origin_steps=="" { return false }
    return same_flags(origin_terms(a),origin_terms(b))
}
fn same_fields(a map[string]View, b map[string]View) bool {
    if len(a)!=len(b) { return false }
    # These string-keyed records contain only strings/bools/maps: canonical
    # JSON is an exact representation, without hash collisions. Preserve the
    # element-wise path if the existing JSON depth/node/byte limits reject it.
    if len(a)>8 { let left=json.encode(a)
        let right=json.encode(b)
        if is_ok(left) && is_ok(right) && unwrap(left)==unwrap(right) { return true } }
    for name, input in a { if !has(b,name) || !same_view(input,unwrap(b[name])) { return false } }
    return true
}
fn same_numeric(a Value, b Value) bool {
    if len(a.numeric)!=1 || len(b.numeric)!=1 || len(a.fields)!=0 || len(b.fields)!=0 { return false }
    if a.prefix!=b.prefix || a.readonly_fields!=b.readonly_fields || a.copied_fields!=b.copied_fields || a.copy_readonly!=b.copy_readonly { return false }
    let left=a.numeric[0]
    let right=b.numeric[0]
    if left.identity=="" || left.identity!=right.identity || left.base_steps!=right.base_steps { return false }
    return same_flags(left.origins,right.origins) && same_fields(a.patches,b.patches) && same_flags(a.cuts,b.cuts)
}
fn same_value(a Value, b Value) bool {
    if !same_view(a.root,b.root) || len(a.positions)!=len(b.positions) { return false }
    # Preserve the cheap exact canonical-table path. Numeric IDs never prove
    # equality across tables; decode only the live fields actually compared.
    var equal=same_numeric(a,b)
    if !equal && a.copied_fields==b.copied_fields && a.copy_readonly==b.copy_readonly && len(a.numeric)==0 && len(b.numeric)==0 && len(a.patches)==0 && len(b.patches)==0 && len(a.cuts)==0 && len(b.cuts)==0 && a.prefix==b.prefix && a.readonly_fields==b.readonly_fields {
        equal=same_fields(a.fields,b.fields)
        if !equal && a.prefix=="" && !a.readonly_fields && !a.copied_fields && !a.copy_readonly { return false } }
    if !equal {
        var left_count=0
        for full, unused in field_paths(a) { if visible_field(a,full) {
            let path=field_relative(a,full)
            if !field_exists(b,b.prefix+path) || !same_view(field_fact(a,path,""),field_fact(b,path,"")) { return false }
            left_count+=1 } }
        for full, unused in field_paths(b) { if visible_field(b,full) { left_count-=1 } }
        if left_count!=0 { return false }
    }
    for i in 0..len(a.positions) { if !same_value(a.positions[i],b.positions[i]) { return false } }
    return true
}
fn same_summary(a Summary, b Summary) bool {
    return a.unknown==b.unknown && a.saw_return==b.saw_return && same_value(a.returned,b.returned) && same_fields(a.writes,b.writes) && same_flags(a.required,b.required)
}
fn conservative_value(input Value) Value {
    var out=clone(materialized(input))
    out.root.writable=false
    out.root.readonly_children=true
    out.root.deep_owned=false
    for path, fact in out.fields { var readonly=fact
        readonly.writable=false
        readonly.readonly_children=true
        readonly.deep_owned=false
        out.fields[path]=readonly }
    for i in 0..len(out.positions) { out.positions[i]=conservative_value(out.positions[i]) }
    return out
}
# No callee summary is published inside statement()/expression(). Registering
# the complete body set here therefore preserves the original reverse graph,
# declaration order, self-invalidations and the 32-round fallback boundary.
fn record_dependencies(s mut State, e Environment) {
    for target, unused in e.callees {
        var callers=map[string]bool{}
        if has(s.dependents,target) { callers=unwrap(s.dependents[target]) }
        if !has(callers,e.function) { callers=clone(callers)
            callers[e.function]=true
            s.dependents[target]=callers } }
}
# Exact cross-function invalidation. A body can keep its existing node facts,
# summary and first error only if every recorded consultation has the same
# writes/requirements/control and the same instantiated return on those actuals.
# Changed raw summaries can therefore stop propagating through an unaffected call.
fn reusable_body(s mut State, name string) bool {
    if !has(s.bodies,name) { return false }
    let prior=unwrap(s.bodies[name])
    # work is the public logical analysis charge. If replay could hit its limit,
    # traverse normally to preserve the exact first failing source span.
    if s.work+prior.work>1048576 { return false }
    var empty []Consultation=[]
    var refreshed=list.from_slice(empty)
    for input in prior.calls {
        if input.return_version==0 || !has(s.summaries,input.target) { return false }
        let current=unwrap(s.summaries[input.target])
        if input.write_version!=current.write_version || input.required_version!=current.required_version || input.control_version!=current.control_version { return false }
        var next=input
        if input.return_version!=current.return_version {
            var result=instantiate_at(input.site,current.returned,input.actual)
            result.root.type_name=unwrap(s.functions[input.target]).result
            if !same_value(input.returned,result) { return false }
            next.return_version=current.return_version
            next.returned=result }
        unwrap(list.append(refreshed,next))
    }
    s.work+=prior.work
    # Preserve a fresh immutable consultation sequence for subsequent changes.
    s.bodies[name]=BodyMemo{work:prior.work,calls:list.snapshot(refreshed)}
    return true
}
pub fn analyze(graph modules.Graph, refs map[string]string, declarations map[string]string, fields map[string]string, functions map[string]Function, variants map[string]string) Result<Model> {
    # Index immutable declaration metadata once. Recursive projections visit only
    # the requested record's fields, never every unrelated field in the project.
    var members=map[string]map[string]string{}
    for full, typ in fields {
        let parts=strings.split(full,"#")
        let name=parts[len(parts)-1]
        let owner=rules.cut(full,0,len(full)-len(name)-1)
        var own=map[string]string{}
        if has(members,owner) { own=clone(unwrap(members[owner])) }
        own[name]=typ
        members[owner]=own
    }
    var s=State{numeric_shapes:map[string]FieldTable{},units:map[string]modules.Unit{},refs:refs,declarations:declarations,fields:fields,members:members,shapes:map[string]map[string]View{},shape_prefixes:map[string]map[string]map[string]bool{},functions:functions,variants:variants,summaries:map[string]Summary{},return_memos:map[string]Memo{},write_memos:map[string]Memo{},next_summary_version:0,bodies:map[string]BodyMemo{},dependents:map[string]map[string]bool{},dirty:map[string]bool{},facts:map[string]Fact{},global_symbols:map[string]bool{},errors:map[string]string{},probing:true,work:0,error:""}
    for unit in list.snapshot(graph.units) { s.units[unit.id]=unit }
    var globals=map[string]Value{}
    for module in list.snapshot(graph.order) { var e=environment(unwrap(s.units[module]),"",globals)
        statement(s,e,e.unit.tree.root)?
        for name, input in e.values { globals[name]=input } }
    for owner, unused in globals { s.global_symbols[owner]=true }
    for name, unused in functions { s.dirty[name]=true }
    var passes=0
    var changed=true
    while changed && passes<32 { passes+=1
        changed=false
        # Preserve declaration order and the original 32 coarse rounds. Within
        # each round, skip only a body whose consulted summaries cannot change.
        for name, f in functions {
            if !has(s.dirty,name) { continue }
            delete(s.dirty,name)
            if reusable_body(s,name) { continue }
            delete(s.errors,name)
            let before_work=s.work
            var e=environment(unwrap(s.units[f.module]),name,globals)
            for p in f.parameters { store(e,p.target,parameter_seeded(s,p.type_name,p.writable,p.target))
                if p.writable { e.visible[p.target]=true } }
            let n=get(e.unit.tree.pool,ast.NodeId{pool:e.unit.tree.pool.identity,index:f.node})
            statement(s,e,n.children[1])?
            record_dependencies(s,e)
            s.bodies[name]=BodyMemo{work:s.work-before_work,calls:list.snapshot(e.consultations)}
            let next=version_summary(s,name,summary(e))
            if !has(s.summaries,name) || changed_versions(next,unwrap(s.summaries[name])) { changed=true
                s.summaries[name]=next
                if has(s.dependents,name) { for caller, unused in unwrap(s.dependents[name]) { s.dirty[caller]=true } } }
        } }
    if changed { for name, input in s.summaries { var next=clone(input)
        next.unknown=true
        next.writes=map[string]View{}
        next.effects=map[string]Effect{}
        next.write_reads=map[string]bool{}
        next.returned=conservative_value(input.returned)
        next=version_summary(s,name,next)
        s.summaries[name]=next
        # The conservative fallback changes every consulted summary. Mark every
        # dependent, including self-recursion, for final validation with it.
        if has(s.dependents,name) { for caller, unused in unwrap(s.dependents[name]) { s.dirty[caller]=true } } } }
    s.probing=false
    for name, f in functions {
        # A stable body already produced its final facts and first diagnostic.
        # Only invalidated bodies need another visit; globals/parameters are fixed.
        if has(s.dirty,name) && !reusable_body(s,name) { delete(s.errors,name)
            var e=environment(unwrap(s.units[f.module]),name,globals)
            for p in f.parameters { store(e,p.target,parameter_seeded(s,p.type_name,p.writable,p.target))
                if p.writable { e.visible[p.target]=true } }
            let n=get(e.unit.tree.pool,ast.NodeId{pool:e.unit.tree.pool.identity,index:f.node})
            statement(s,e,n.children[1])? }
        if s.error=="" && has(s.errors,name) { s.error=unwrap(s.errors[name]) }
    }
    return ok(Model{facts:s.facts,passes:passes,work:s.work,error:s.error})
}
