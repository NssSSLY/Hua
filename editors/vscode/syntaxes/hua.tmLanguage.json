{
  "name": "Hua",
  "scopeName": "source.hua",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "string.quoted.double.hua",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.hua",
          "match": "\\\\[\\\\\"nrt0]"
        }
      ]
    },
    {
      "name": "keyword.control.hua",
      "match": "\\b(let|var|const|fn|return|struct|interface|pub|if|else|match|enum|for|while|break|continue|in|import|as|async|await|spawn|taskgroup|parallel|simd|defer|unsafe|extern)\\b"
    },
    {
      "name": "constant.language.hua",
      "match": "\\b(true|false|nil)\\b"
    },
    {
      "name": "storage.type.hua",
      "match": "\\b(int|float|bool|string|void|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|List|Map|Result|Task|Bytes|Buffer|Json)\\b"
    },
    {
      "name": "constant.numeric.hua",
      "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?)\\b"
    },
    {
      "name": "entity.name.function.hua",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.hua",
      "match": "\\.{2}=?|\\*\\*=?|//=?|=>|[+*/%=!<>?&|^~@-]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#docBlock"
        },
        {
          "include": "#block"
        },
        {
          "name": "comment.line.number-sign.hua",
          "match": "#.*$"
        }
      ]
    },
    "docBlock": {
      "name": "comment.block.documentation.hua",
      "begin": "#\\*\\*",
      "end": "\\*\\*#",
      "patterns": [
        {
          "include": "#docBlock"
        },
        {
          "include": "#block"
        }
      ]
    },
    "block": {
      "name": "comment.block.hua",
      "begin": "#\\*(?!\\*)",
      "end": "\\*#",
      "patterns": [
        {
          "include": "#docBlock"
        },
        {
          "include": "#block"
        }
      ]
    }
  }
}
