# Return the first index whose value is at least key, or len(values).
# The input must be in ascending order.
pub fn lower_bound(values []int, key int) int {
    var low = 0
    var high = len(values)
    while low < high {
        let mid = low + (high - low) // 2
        if values[mid] < key {
            low = mid + 1
        } else {
            high = mid
        }
    }
    return low
}
