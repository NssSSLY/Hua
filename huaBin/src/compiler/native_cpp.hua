# N4 C++ backend over the verified C05 Core.
import lowering as lower
import type_rules as rules
import std.list as list
import std.strings as strings
import std.bytes as bytes
import std.json as json
import std.alg as alg
import std.fs as fs
import std.path as path

struct Emitter { core lower.Core
    values map[string]string
    functions map[string]int
    records map[string]int
    fields map[string]int
    tags map[string]int
    files map[string]string
    globals map[string]bool
    value_types map[string]string
    ids map[int]string
    positions map[int]string }
struct RecordCode { definition string
    name string
    declarations string
    methods string
    dependencies []int
    by_value []int }
struct Unit { module string
    id string
    roots []int
    first int
    end int }
struct Program { e Emitter
    units []Unit
    layouts map[int]RecordCode }
pub struct BuildUnit { id string
    module string }
pub struct Split { units []BuildUnit
    runtime string
    layout string }
struct Receiver { code string
    value string }

fn node(core lower.Core, id int) lower.Node { return unwrap(list.get(core.nodes,id)) }
fn fail(n lower.Node, message string) string {
    return "E8001@"+str(n.line)+":"+str(n.column)+" ["+n.module+"] "+message
}
fn record_name(t string) string {
    if strings.starts_with(t,"struct:") { return rules.cut(t,7,len(t)) }
    return t
}
# Only the current Core uses its graph-wide IDs. Generated names use the
# resolved declaration name or a number scoped to the source module.
fn cpp_id(e Emitter, id int) string { return unwrap(e.ids[id]) }
fn record_type(e Emitter, id int) string { return "Record_"+cpp_id(e,id) }
fn record_body(e Emitter, id int) string { return "Body_"+cpp_id(e,id) }
fn field_name(e Emitter, id int) string { return "field_"+cpp_id(e,id) }
fn mangle(text string) string {
    let octets=bytes.from_text(text)
    let digits="0123456789abcdef"
    var result=""
    for i in 0..bytes.len(octets) {
        let b=unwrap(bytes.at(octets,i))
        result+=rules.cut(digits,b//16,b//16+1)+rules.cut(digits,b%16,b%16+1)
    }
    return result
}
fn cpp_type(e Emitter, n lower.Node, t string) Result<string> {
    if t=="int" { return ok("hn::I") }
    if t=="float" { return ok("hn::F") }
    if t=="Json" { return ok("hn::Opaque<hn::JsonTag>") }
    if t=="Buffer" { return ok("hn::Opaque<hn::BufferTag>") }
    if t=="std.file.File" { return ok("hn::Opaque<hn::FileTag>") }
    if t=="std.file.IOFailure" { return ok("hn::Opaque<hn::IOFailureTag>") }
    if t=="std.error.Value" { return ok("hn::Opaque<hn::ErrorTag>") }
    if t=="NativeHandle" { return ok("hn::Opaque<hn::NativeHandleTag>") }
    if t=="std.stream.Reader" { return ok("hn::Opaque<hn::ReaderTag>") }
    if t=="std.stream.Writer" { return ok("hn::Opaque<hn::WriterTag>") }
    if t=="std.http.Response" { return ok("hn::Opaque<hn::HttpResponseTag>") }
    if t=="std.http.StreamResponse" { return ok("hn::Opaque<hn::HttpStreamTag>") }
    if t=="std.regex.Pattern" { return ok("hn::Opaque<hn::RegexTag>") }
    if t=="std.process.Child" { return ok("hn::Opaque<hn::ProcessChildTag>") }
    if t=="std.random.Rng" { return ok("hn::Opaque<hn::RngTag>") }
    let tuple=rules.arguments(t,"multi")
    if len(tuple)>0 {
        var code="std::tuple<"
        for i in 0..len(tuple) {
            if i>0 { code+="," }
            code+=cpp_type(e,n,tuple[i])?
        }
        return ok(code+">")
    }
    if t=="string" { return ok("hn::Str") }
    if t=="bool" || t=="void" { return ok(t) }
    if t=="Bytes" { return ok("hn::Opaque<hn::BytesTag>") }
    if strings.ends_with(t,"?") { return ok("hn::Opt<"+cpp_type(e,n,rules.cut(t,0,len(t)-1))?+">") }
    if strings.starts_with(t,"[]") { return ok("hn::Slice<"+cpp_type(e,n,rules.cut(t,2,len(t)))?+">") }
    let list_args=rules.arguments(t,"List")
    if len(list_args)==1 { return ok("hn::List<"+cpp_type(e,n,list_args[0])?+">") }
    let deque_args=rules.arguments(t,"Deque")
    if len(deque_args)==1 { return ok("hn::OpaqueDeque<"+cpp_type(e,n,deque_args[0])?+">") }
    let task_args=rules.arguments(t,"Task")
    if len(task_args)==1 {
        var payload="hn::Unit"
        if task_args[0]!="void" { payload=cpp_type(e,n,task_args[0])? }
        return ok("hn::Task<"+payload+">")
    }
    let map_args=rules.arguments(t,"map")
    if len(map_args)==2 { return ok("hn::Map<"+cpp_type(e,n,map_args[0])?+","+cpp_type(e,n,map_args[1])?+">") }
    let result_args=rules.arguments(t,"Result")
    if len(result_args)==2 {
        var payload="hn::Unit"
        if result_args[0]!="void" { payload=cpp_type(e,n,result_args[0])? }
        return ok("hn::Result<"+payload+","+cpp_type(e,n,result_args[1])?+">")
    }
    let name=record_name(t)
    if has(e.records,name) { return ok(record_type(e,unwrap(e.records[name]))) }
    return err(fail(n,"unsupported native type "+t))
}
fn type_text(core lower.Core, n lower.Node) string {
    if n.kind=="MutableType" { return type_text(core,node(core,n.children[0])) }
    if n.kind=="OptionalType" { return type_text(core,node(core,n.children[0]))+"?" }
    if n.kind=="SliceType" { return "[]"+type_text(core,node(core,n.children[0])) }
    if n.kind=="GenericType" {
        var text=n.text+"<"
        for i in 0..len(n.children) {
            if i>0 { text+="," }
            text+=type_text(core,node(core,n.children[i]))
        }
        if n.text=="Result" && len(n.children)==1 { text+=",string" }
        return text+">"
    }
    return n.text
}
fn enum_decl(n lower.Node) string {
    if n.role=="enum-layout" { return rules.cut(n.text,0,len(n.text)-5) }
    return n.text
}
fn enum_part(field string) []string {
    return strings.split(field,"#")
}
fn enum_box(e Emitter, decl lower.Node, record string) Result<string> {
    let owner=enum_decl(decl)
    var layout="static const auto shape=[](){auto shape=std::make_shared<hua::EnumLayout>();shape->name="+quote(owner)+";\n"
    var values="auto data=hua::managed<hua::StructData>();data->name="+quote(owner)+";data->enumeration=shape;\n"
    for id in decl.children {
        let field=node(e.core,id)
        if field.text=="$case" { continue }
        let parts=enum_part(field.text)
        let label=rules.cut(parts[0],1,len(parts[0]))
        let tag=unwrap(e.tags[owner+":"+label])
        let q=quote(label)
        let name=quote(field.text)
        let t=quote(bridge_name(field.type_name))
        layout+="{auto& variant=shape->variants["+q+"];variant.name="+q+";variant.fields.emplace("+name+","+t+");"
        layout+="shape->fields.emplace("+name+",hua::EnumField{"+q+","+t+","+parts[1]+"});}\n"
        let active="if(v.fields.get().tag=="+str(tag)+"){"
        if parts[1]=="0" { values+=active+"data->variant=&shape->variants.at("+q+");data->fields.emplace(\"$case\",hn::Value(std::string("+q+")));}\n" }
        var payload="hn::Value{}"
        if field.type_name!="void" { payload="to_value(v.fields.get()."+field_name(e,id)+")" }
        values+=active+"data->fields.emplace("+name+","+payload+");}\n"
    }
    return ok("hn::Value to_value(const "+record+"& v){\n"+layout
        +"return shape;}();\n"+values+"return hn::Value(hua::StructValue{data,true});}\n")
}
# Lowered types preserve nominal names inside containers and tuples.
fn used_types(e Emitter, t string, found mut map[int]bool) {
    if t=="" { return }
    let name=record_name(t)
    if has(e.records,name) { found[unwrap(e.records[name])]=true
        return }
    if strings.starts_with(t,"[]") { used_types(e,rules.cut(t,2,len(t)),found)
        return }
    if strings.ends_with(t,"?") { used_types(e,rules.cut(t,0,len(t)-1),found)
        return }
    if !strings.contains(t,"<") { return }
    for family in ["List","map","Result","multi"] {
        for argument in rules.arguments(t,family) { used_types(e,argument,found) }
    }
}
fn requires_layout(e Emitter, t string, found mut map[int]bool) {
    let name=record_name(t)
    if has(e.records,name) { found[unwrap(e.records[name])]=true
        return }
    if strings.ends_with(t,"?") { requires_layout(e,rules.cut(t,0,len(t)-1),found)
        return }
    for family in ["Result","multi"] {
        for argument in rules.arguments(t,family) { requires_layout(e,argument,found) }
    }
}
fn layout(e Emitter, id int) Result<RecordCode> {
    let decl=node(e.core,id)
    let owner=enum_decl(decl)
    let body=record_body(e,id)
    let record=record_type(e,id)
    let enumeration=decl.role=="enum-layout"
    var code="struct "+body+" {\n"
    var box="hn::Value to_value(const "+record+"& v){auto data=hua::managed<hua::StructData>();data->name="+quote(owner)+";\n"
    var capture=record+" capture_value("+record+" v){\n"
    var copying=record+" clone(const "+record+"& v){"+record+" out{};\n"
    var dependencies=map[int]bool{}
    var by_value=map[int]bool{}
    if enumeration {
        code+="hn::I tag{};\n"
        copying+="out.fields.get().tag=v.fields.get().tag;\n"
    }
    var emitted_tags=map[string]bool{}
    for child in decl.children {
        let field=node(e.core,child)
        if field.kind!="Field" { return err(fail(field,"unsupported native structure member")) }
        let t=node(e.core,field.children[0])
        var field_type=type_text(e.core,t)
        var guard=""
        if enumeration {
            if field.text=="$case" { continue }
            let label=rules.cut(enum_part(field.text)[0],1,len(enum_part(field.text)[0]))
            let tag=str(unwrap(e.tags[owner+":"+label]))
            if !has(emitted_tags,label) {
                emitted_tags[label]=true
                code+="static constexpr hn::I tag_"+mangle(label)+"="+tag+";\n"
            }
            if field.type_name=="void" { continue }
            field_type=field.type_name
            guard="if(v.fields.get().tag=="+tag+")"
        }
        used_types(e,field_type,dependencies)
        requires_layout(e,field_type,by_value)
        let name=field_name(e,child)
        let field_access="v.fields.get()."+name
        code+=cpp_type(e,t,field_type)?+" "+name+"{};\n"
        capture+=guard+field_access+"=capture_value(std::move("+field_access+"));\n"
        copying+=guard+"out.fields.get()."+name+"=clone("+field_access+");\n"
        box+="data->fields.emplace("+quote(field.text)+",to_value("+field_access+"));\n"
    }
    code+="};\nstruct "+record+" { hn::RecordStorage<"+body+"> fields; };\n"
    var boxing=box+"return hn::Value(hua::StructValue{data,true});}\n"
    if enumeration { boxing=enum_box(e,decl,record)? }
    let specialization=("template<> struct hn::TypeName<hua_generated::"+record
        +">{static std::string get(){return "+quote(owner)+";}};\n")
    let declarations=(record+" capture_value("+record+");"+record+" clone(const "+record
        +"&);hn::Value to_value(const "+record+"&);\n")
    return ok(RecordCode{definition:code,name:specialization,declarations:declarations,
        methods:capture+"return v;}\n"+copying+"return out;}\n"+boxing,dependencies:sorted_ids(dependencies),
        by_value:sorted_ids(by_value)})
}
fn sorted_ids(values map[int]bool) []int {
    let empty []int=[]
    var ids=list.from_slice(empty)
    for id, _ in values { list.append(ids,id) }
    return unwrap(alg.sorted(list.snapshot(ids)))
}
fn quote(text string) string {
    let raw=bytes.from_text(text)
    let digits="0123456789abcdef"
    var escaped="\""
    for i in 0..bytes.len(raw) {
        let b=unwrap(bytes.at(raw,i))
        let hi=b//16
        let lo=b%16
        escaped+="\\x"+rules.cut(digits,hi,hi+1)+rules.cut(digits,lo,lo+1)
    }
    return escaped+"\""
}
fn location(e Emitter, n lower.Node) string { return "sp_"+unwrap(e.positions[n.id]) }
fn site(e Emitter, n lower.Node) string {
    return "static const hn::SourceSpan "+location(e,n)+"{"+unwrap(e.files[n.module])+","+str(n.start)+","+str(n.end)+","+str(n.line)+","+str(n.column)+"};\n"
}
fn literal(n lower.Node, negative bool) Result<string> {
    let normalized=rules.integer_literal(n.text,negative)
    if is_err(normalized) { return err(fail(n,unwrap_err(normalized))) }
    let text=unwrap(normalized)
    if text=="-9223372036854775808" { return ok("(-9223372036854775807LL-1LL)") }
    return ok("("+text+"LL)")
}
fn integer_operator(op string) string {
    if op=="+" { return "add" }
    if op=="-" { return "sub" }
    if op=="*" { return "mul" }
    if op=="//" { return "floor_div" }
    if op=="%" { return "mod" }
    return ""
}
fn binding_name(n lower.Node) string {
    if n.kind=="Parameter" && strings.ends_with(n.text," mut") { return rules.cut(n.text,0,len(n.text)-4) }
    return n.text
}
fn variable(e Emitter, n lower.Node) Result<string> {
    let key=binding_name(n)
    if !has(e.values,key) { return err(fail(n,"expected native variable "+n.text)) }
    return ok(unwrap(e.values[key]))
}
fn read_variable(e Emitter, n lower.Node) Result<string> {
    let storage=variable(e,n)?
    if has(e.globals,n.text) { return ok("global_slot("+storage+","+location(e,n)+")") }
    return ok(storage)
}
fn optional_name(e Emitter, n lower.Node) bool {
    return n.kind=="Name" && strings.ends_with(unwrap_or(e.value_types[n.text],""),"?")
}
fn optional_operand(e Emitter, n lower.Node) Result<string> {
    if optional_name(e,n) { return read_variable(e,n) }
    return expression(e,n)
}
fn field_id(e Emitter, n lower.Node, owner string) Result<int> {
    let key=record_name(owner)+":"+n.text
    if !has(e.fields,key) { return err(fail(n,"unsupported native field "+n.text)) }
    return ok(unwrap(e.fields[key]))
}
fn return_type(e Emitter, n lower.Node) Result<string> {
    for id in n.children {
        let part=node(e.core,id)
        if part.kind!="ReturnTypes" { continue }
        var result=""
        for child in part.children {
            let t=node(e.core,child)
            if result!="" { result+="," }
            result+=cpp_type(e,t,type_text(e.core,t))?
        }
        if len(part.children)>1 { return ok("std::tuple<"+result+">") }
        return ok(result)
    }
    return ok("void")
}
fn function_name(e Emitter, id int) string { return "fn_"+cpp_id(e,id) }
fn signature(e Emitter, n lower.Node, definition bool) Result<string> {
    let result=return_type(e,n)?
    var parameters=""
    for i in 0..len(n.children)-1 {
        let part=node(e.core,n.children[i])
        if part.kind=="ReturnTypes" { continue }
        if strings.ends_with(part.text," mut") && !shared_type(part.type_name) && !has(e.records,record_name(part.type_name)) {
            return err(fail(part,"unsupported native mutable parameter "+part.type_name))
        }
        if parameters!="" { parameters+="," }
        parameters+=cpp_type(e,part,part.type_name)?
        if definition { parameters+=" "+variable(e,part)? }
    }
    return ok(result+" "+function_name(e,n.id)+"("+parameters+")")
}
fn map_type(t string) bool { return strings.starts_with(t,"map<") }
fn slice_type(t string) bool { return len(t)>2 && strings.starts_with(t,"[]") }
fn shared_type(t string) bool { return t=="Buffer" || map_type(t) || slice_type(t) || strings.starts_with(t,"List<") }
fn bridge_name(t string) string {
    if map_type(t) {
        let parts=rules.arguments(t,"map")
        return "map["+bridge_name(parts[0])+"]"+bridge_name(parts[1])
    }
    return t
}
# BEGIN GENERATED: stdlib_bridged
fn bridged(name string) bool {
    if !strings.starts_with(name,"$std$") {
        return alg.contains(["str","int","float","sqrt","min","max","abs","clamp","type"],name)
    }
    let parts=strings.split(name,"$")
    if len(parts)!=4 { return false }
    let module=parts[2]
    let func=parts[3]
    if module=="alg" { return alg.contains(["unique","chunk","product","sorted","reverse","contains","index","lower_bound","upper_bound","binary_search","sum","min","max","windows"],func) }
    if module=="buffer" { return alg.contains(["new","len","append","write_u8","write_u32_le","write_i64_le","write_text","bytes","text","clear","write_str","write_int","take_text","reserve"],func) }
    if module=="bytes" { return alg.contains(["from_ints","from_text","to_text","to_ints","len","at","slice","concat","u32_le","i64_le","read_u32_le","read_i64_le","crc32"],func) }
    if module=="compress" { return alg.contains(["gzip_compress","gzip_decompress","gzip_reader","gzip_writer"],func) }
    if module=="crypto" { return alg.contains(["random_bytes","uuid4","sha256","hmac_sha256","equal"],func) }
    if module=="deque" { return alg.contains(["from_slice","len","push_back","push_front","pop_back","pop_front","front","back","get","clear","snapshot"],func) }
    if module=="encoding" { return alg.contains(["hex_encode","hex_decode","base64_encode","base64_decode","base64url_encode","base64url_decode","utf8_valid","utf8_encode","utf8_decode","pack_uint","pack_int","unpack_uint","unpack_int","pack_f32","pack_f64","unpack_f32","unpack_f64"],func) }
    if module=="error" { return alg.contains(["make","wrap","from_string","with_context","with_origin","with_native","domain","code","message","cause","origin","native_domain","native_code","contexts","truncated","format"],func) }
    if module=="file" { return alg.contains(["open","read","write","seek","tell","flush","close","state","close_error","error","transferred","partial","read_line","read_all","read_exact","write_all"],func) }
    if module=="fs" { return alg.contains(["stat","rename","replace","temp_file","walk","copy_file","copy_dir","remove_all","canonical","read_text","write_text","append_text","exists","remove","mkdir_all","list_dir","read_bytes","write_bytes","append_bytes"],func) }
    if module=="gc" { return alg.contains(["collect","live","allocated","collected"],func) }
    if module=="heap" { return alg.contains(["heapify","push","pop","peek","smallest","largest"],func) }
    if module=="http" { return alg.contains(["get","post","request","status","header","headers","body","text","open_stream","stream_status","stream_header","stream_headers","stream_body","stream_close"],func) }
    if module=="io" { return alg.contains(["write_err","read_line","read_all","write"],func) }
    if module=="json" { return alg.contains(["decode","encode","kind","get","at","len","keys","as_string","as_int","as_float","as_bool","is_null","null","from","array","object","set","remove","append","set_at","encode_pretty","decode_lines","encode_lines"],func) }
    if module=="list" { return alg.contains(["reserve","insert","remove_at","index_of","contains","reverse","sort","swap","truncate","slice","dedup"],func) }
    if module=="log" { return alg.contains(["debug","info","warn","error","with_fields","set_level"],func) }
    if module=="maps" { return alg.contains(["keys","values","entries","get_or","pop","merge"],func) }
    if module=="math" { return alg.contains(["floor","ceil","trunc","round","sin","cos","tan","exp","log","log2","log10","hypot","gcd","lcm","isqrt","asin","acos","atan","atan2","cbrt","fmod","pi","e","tau","popcount","leading_zeros","trailing_zeros","rotate_left","rotate_right","checked_add","checked_sub","checked_mul","checked_neg","checked_abs","checked_pow","wrapping_add","wrapping_sub","wrapping_mul","wrapping_neg","wrapping_abs","wrapping_pow","saturating_add","saturating_sub","saturating_mul","saturating_neg","saturating_abs","saturating_pow","sinh","cosh","tanh","asinh","acosh","atanh"],func) }
    if module=="os" { return alg.contains(["exit","platform","arch","pid","cpu_count","getenv","args","cwd","environ","parse_args"],func) }
    if module=="path" { return alg.contains(["join","normalize","basename","dirname","ext","relative"],func) }
    if module=="process" { return alg.contains(["run","run_with","start","stdin","stdout","stderr","wait","kill"],func) }
    if module=="random" { return alg.contains(["new","int","float","bool","bytes","shuffle","choice","sample"],func) }
    if module=="regex" { return alg.contains(["compile","is_match","find","find_all","replace_all","split"],func) }
    if module=="sets" { return alg.contains(["from_slice","union","intersection","difference","is_subset","is_disjoint","symmetric_difference"],func) }
    if module=="simd" { return alg.contains(["backend","add","sub","mul"],func) }
    if module=="stream" { return alg.contains(["from_bytes","from_file","to_buffer","to_file","limit","read","read_exact","read_all","write","write_all","flush","close_reader","close_writer","copy"],func) }
    if module=="strings" { return alg.contains(["contains","index","len_bytes","rune_count","trim","lower_ascii","upper_ascii","join","replace","last_index","count","repeat","split_n","fields","lines","trim_start","trim_end","trim_prefix","trim_suffix","pad_left","pad_right","replace_n","is_empty","parse_int","parse_float","format_int","format_float","format","center","codepoints","chars","from_codepoints","slice_runes","template","format_int_grouped","format_float_grouped","upper","lower","casefold","equal_fold"],func) }
    if module=="test" { return alg.contains(["assert","equal","not_equal","fail"],func) }
    if module=="time" { return alg.contains(["since_ns","format_duration","parse_duration","utc_parts","utc_from_parts","weekday","day_of_year","is_leap_year","days_in_month","format_rfc3339","format_rfc3339_offset","parse_rfc3339","monotonic_ns","unix_ms"],func) }
    if module=="url" { return alg.contains(["parse","encode","decode","build_query"],func) }
    return false
}
# END GENERATED: stdlib_bridged
fn typed_builtin(e Emitter, n lower.Node, name string, args []string) string {
    let site=location(e,n)
    let joined=strings.join(args,",")
    if name=="print" { return "hn::print("+site+",{"+joined+"})" }
    if name=="len" || name=="has" || name=="is_ok" || name=="is_err" || name=="is_some" || name=="is_none" || name=="unwrap_or" {
        return "hn::"+name+"("+joined+")"
    }
    if name=="unwrap" || name=="unwrap_err" || name=="err" {
        return "hn::"+name+"("+joined+","+site+")"
    }
    if name=="ok" { return "hn::ok("+joined+")" }
    if name=="clone" { return "hn::clone_checked("+joined+","+site+")" }
    if name=="$std$strings$split" { return "hn::split("+joined+","+site+")" }
    if name=="$std$strings$starts_with" { return "hn::starts_with("+joined+")" }
    if name=="$std$strings$ends_with" { return "hn::ends_with("+joined+")" }
    if name=="$std$list$clear" { return "hn::list_clear("+joined+","+site+")" }
    if name=="$std$list$extend" { return "hn::list_extend("+joined+","+site+")" }
    if name=="$std$strings$slice" { return "hn::text_slice("+joined+","+site+")" }
    if name=="delete" { return "hn::erase("+joined+","+site+")" }
    if name=="$std$list$from_slice" || name=="$std$list$len" || name=="$std$list$snapshot" {
        return "hn::list_"+rules.cut(name,10,len(name))+"("+joined+")"
    }
    if name=="$std$list$append" || name=="$std$list$get" || name=="$std$list$pop" || name=="$std$list$set" {
        return "hn::list_"+rules.cut(name,10,len(name))+"("+joined+","+site+")"
    }
    return ""
}
fn bridge_mut_arg(name string) int {
    if name=="$std$random$shuffle" { return 2 }
    if alg.contains(["$std$list$insert","$std$list$remove_at","$std$list$reverse","$std$list$sort","$std$list$swap","$std$list$truncate","$std$list$dedup","$std$heap$heapify","$std$heap$push","$std$heap$pop","$std$maps$pop","$std$maps$merge"],name) { return 1 }
    return 0
}
fn call(e Emitter, n lower.Node) Result<string> {
    return emit_call(e,n,false)
}
fn callback_helper(name string) string {
    if strings.starts_with(name,"$std$alg$") {
        let m=rules.cut(name,9,len(name))
        if alg.contains(["map","fold","filter","any","all","find","find_index","sorted_by_key","sorted_by","min_by_key","max_by_key","partition","zip_with"],m) {
            return "hn::alg_"+m
        }
    }
    if name=="$std$list$sort_by_key" || name=="$std$list$sort_by" || name=="$std$list$retain" {
        return "hn::list_"+rules.cut(name,10,len(name))
    }
    if name=="$std$heap$push_by_key" || name=="$std$heap$pop_by_key" {
        return "hn::heap_"+rules.cut(name,10,len(name))
    }
    if name=="$std$maps$update" { return "hn::map_update" }
    return ""
}
fn callback_arity(name string) int {
    if name=="$std$alg$fold" || name=="$std$alg$sorted_by" || name=="$std$alg$zip_with" || name=="$std$list$sort_by" { return 2 }
    return 1
}
fn emit_call(e Emitter, n lower.Node, deferred bool) Result<string> {
    let callee=node(e.core,n.children[0])
    if callee.kind!="Name" { return err(fail(callee,"native calls require a function declaration")) }
    var code="({\n"
    let empty []string=[]
    var args=list.from_slice(empty)
    var flags=list.from_slice(empty)
    let direct=has(e.functions,callee.text)
    var function=callee
    var builtin=""
    if direct { function=node(e.core,unwrap(e.functions[callee.text])) }
    else if strings.starts_with(callee.text,"$core$") { builtin=rules.cut(callee.text,6,len(callee.text)) }
    else { return err(fail(callee,"unsupported native callee "+callee.text)) }
    let site=location(e,n)
    if builtin=="task_group_begin" { return ok("hn::task_group_begin()") }
    if builtin=="task_group_end" {
        let h=expression(e,node(e.core,n.children[1]))?
        if deferred {
            return ok("auto deferred"+cpp_id(e,n.id)+"=({auto arg1="+h+";[arg1]() mutable {hn::task_group_end(arg1,"+site+");};});\nhn::Deferred guard"+cpp_id(e,n.id)+"(std::move(deferred"+cpp_id(e,n.id)+"));\n")
        }
        return ok("hn::task_group_end("+h+","+site+")")
    }
    if builtin=="task_await" {
        let h=expression(e,node(e.core,n.children[1]))?
        if n.type_name=="void" { return ok("({(void)hn::await_task("+h+","+site+");})") }
        return ok("hn::from_value<"+cpp_type(e,n,n.type_name)?+">(hn::await_task("+h+","+site+"))")
    }
    if builtin=="task_start" {
        let fn_node=node(e.core,n.children[1])
        if fn_node.kind!="Name" || !has(e.functions,fn_node.text) { return err(fail(fn_node,"task_start requires a known function declaration")) }
        let target_fn=node(e.core,unwrap(e.functions[fn_node.text]))
        let t_args=rules.arguments(n.type_name,"Task")
        let inner_t=t_args[0]
        var caps=list.from_slice(empty)
        var call_args=list.from_slice(empty)
        for i in 2..len(n.children) {
            let arg=node(e.core,n.children[i])
            let aname="targ"+str(i-1)
            let ptype=node(e.core,target_fn.children[i-2]).type_name
            code+=cpp_type(e,arg,ptype)?+" "+aname+"=hn::task_input_any("+contextual_expression(e,arg,ptype)?+");\n"
            list.append(caps,aname+"=std::move("+aname+")")?
            list.append(call_args,aname)?
        }
        let fn_call=function_name(e,target_fn.id)+"("+strings.join(list.snapshot(call_args),",")+")"
        var body_ret=""
        if inner_t=="void" {
            body_ret="auto depth=hn::enter<false,false>("+site+");"+fn_call+";hn::leave<false>(depth);return hua::Value{};"
        } else {
            body_ret="auto depth=hn::enter<false,false>("+site+");auto r="+fn_call+";hn::leave<false>(depth);return hn::to_value(r);"
        }
        return ok(code+cpp_type(e,n,n.type_name)?+"{hn::start_task(["+strings.join(list.snapshot(caps),",")+"]() mutable -> hua::Value {"+body_ret+"},"+quote(inner_t)+","+site+").value};})")
    }
    if strings.starts_with(builtin,"$std$task$") {
        for i in 1..len(n.children) {
            let arg=node(e.core,n.children[i])
            let aname="arg"+str(i)
            code+="auto "+aname+"="+expression(e,arg)?+";\n"
            list.append(args,"hn::to_value("+aname+")")?
        }
        let invoke="hn::task_wait("+quote(builtin)+",{"+strings.join(list.snapshot(args),",")+"},"+site+")"
        if n.type_name=="void" { return ok(code+"(void)"+invoke+";})") }
        return ok(code+"hn::from_value<"+cpp_type(e,n,n.type_name)?+">("+invoke+");})")
    }
    let cb_helper=callback_helper(builtin)
    if cb_helper!="" {
        let cb_idx=len(n.children)-1
        let fn_node=node(e.core,n.children[cb_idx])
        if fn_node.kind!="Name" || !has(e.functions,fn_node.text) { return err(fail(fn_node,"callback requires a known Hua function")) }
        let cb_fn=node(e.core,unwrap(e.functions[fn_node.text]))
        for i in 1..cb_idx {
            let arg=node(e.core,n.children[i])
            let aname="arg"+str(i)
            code+="auto "+aname+"="+expression(e,arg)?+";\n"
            list.append(args,aname)?
        }
        let arity=callback_arity(builtin)
        var lam=""
        if arity==2 {
            lam="[&](auto&& p0,auto&& p1){auto depth=hn::enter<false,false>("+site+");auto r="+function_name(e,cb_fn.id)+"(p0,p1);hn::leave<false>(depth);return r;}"
        } else {
            lam="[&](auto&& p0){auto depth=hn::enter<false,false>("+site+");auto r="+function_name(e,cb_fn.id)+"(p0);hn::leave<false>(depth);return r;}"
        }
        list.append(args,lam)?
        return ok(code+cb_helper+"("+strings.join(list.snapshot(args),",")+","+site+");})")
    }
    let bridge=bridged(builtin)
    let ext_call=direct && function.role=="external"
    if deferred && (!direct || ext_call) { return err(fail(n,"unsupported native deferred intrinsic")) }
    if deferred {
        code="auto deferred"+cpp_id(e,n.id)+"=({\n"
    }
    for i in 1..len(n.children) {
        let arg=node(e.core,n.children[i])
        let name="arg"+str(i)
        var value=""
        if direct { value=contextual_expression(e,arg,node(e.core,function.children[i-1]).type_name)? }
        else { value=expression(e,arg)? }
        if !direct && (builtin=="is_some" || builtin=="is_none" || builtin=="unwrap" || builtin=="unwrap_or") && i==1 {
            value=optional_operand(e,arg)?
        }
        if direct && !ext_call {
            let param=node(e.core,function.children[i-1])
            if !strings.ends_with(param.text," mut") {
                value="capture_value("+value+")"
            } else if has(e.records,record_name(param.type_name)) {
                let borrowed=receiver(e,arg)?
                code+=borrowed.code
                value="borrow_record("+borrowed.value+")"
            }
            code+=cpp_type(e,param,param.type_name)?+" "+name+"="+value+";\n"
        } else {
            if arg.type_name=="void" { return err(fail(arg,"unsupported native argument void")) }
            code+="auto "+name+"="+value+";\n"
        }
        if builtin=="print" || bridge || ext_call {
            list.append(args,"to_value("+name+")")?
            list.append(flags,str(arg.kind=="Array"))?
        } else if direct && !deferred { list.append(args,"std::move("+name+")")? }
        else { list.append(args,name)? }
    }
    let arguments=list.snapshot(args)
    if ext_call {
        let linked=strings.split(function.text," ")[0]
        let invoke=("hn::call_external("+quote(linked)+","+location(e,n)+",{"+strings.join(arguments,",")
            +"},{"+strings.join(list.snapshot(flags),",")+"})")
        if n.type_name=="void" { return ok(code+invoke+";})") }
        return ok(code+"hn::from_value<"+cpp_type(e,n,n.type_name)?+">("+invoke+");})")
    }
    if deferred {
        return ok(code+"["+strings.join(arguments,",")+"]() mutable {auto depth=hn::enter<false,false>("
            +location(e,n)+");"+function_name(e,function.id)+"("+strings.join(arguments,",")+");"
            +"hn::leave<false>(depth);};});\nhn::Deferred guard"+cpp_id(e,n.id)+"(std::move(deferred"+cpp_id(e,n.id)+"));\n")
    }
    if direct {
        code+="auto depth=hn::enter<false,false>("+location(e,n)+");\n"
        let invoke=function_name(e,function.id)+"("+strings.join(arguments,",")+");\n"
        if n.type_name=="void" { return ok(code+invoke+"hn::leave<false>(depth);})") }
        return ok(code+"auto result="+invoke+"hn::leave<false>(depth);\nstd::move(result);})")
    }
    if bridge {
        let mut_arg=bridge_mut_arg(builtin)
        if mut_arg>0 {
            code+="std::vector<hua::Value> bargs={"+strings.join(arguments,",")+"};\n"
            let invoke=("hn::call_builtin("+quote(builtin)+","+location(e,n)+",bargs,{"+strings.join(list.snapshot(flags),",")+"},"+quote(bridge_name(n.type_name))+")")
            if n.type_name=="void" {
                return ok(code+invoke+";\nhn::sync_from_value(arg"+str(mut_arg)+",bargs["+str(mut_arg-1)+"]);})")
            }
            return ok(code+"auto bres="+invoke+";\nhn::sync_from_value(arg"+str(mut_arg)+",bargs["+str(mut_arg-1)+"]);\nhn::from_value<"+cpp_type(e,n,n.type_name)?+">(bres);})")
        }
        let invoke=("hn::call_builtin("+quote(builtin)+","+location(e,n)+",{"+strings.join(arguments,",")
            +"},{"+strings.join(list.snapshot(flags),",")+"},"+quote(bridge_name(n.type_name))+")")
        if n.type_name=="void" { return ok(code+invoke+";})") }
        return ok(code+"hn::from_value<"+cpp_type(e,n,n.type_name)?+">("+invoke+");})")
    }
    if builtin=="is_none" || builtin=="is_some" || builtin=="unwrap" || builtin=="unwrap_or" {
        let item=node(e.core,n.children[1])
        if !optional_name(e,item) && !strings.ends_with(item.type_name,"?") && len(rules.arguments(item.type_name,"Result"))==0 {
            if builtin=="is_none" { return ok(code+str(item.type_name=="nil")+";})") }
            if builtin=="is_some" { return ok(code+str(item.type_name!="nil")+";})") }
            if item.type_name!="nil" { return ok(code+"arg1;})") }
            if builtin=="unwrap_or" { return ok(code+"arg2;})") }
        }
    }
    let invoke=typed_builtin(e,n,builtin,arguments)
    if invoke=="" { return err(fail(callee,"unsupported native intrinsic "+builtin)) }
    return ok(code+invoke+";})")
}
fn index(e Emitter, n lower.Node) Result<string> {
    let base=node(e.core,n.children[0])
    if !slice_type(base.type_name) && !map_type(base.type_name) {
        return err(fail(n,"unsupported native index of "+base.type_name))
    }
    return ok("({auto base="+expression(e,base)?+";auto key="+expression(e,node(e.core,n.children[1]))?
        +";hn::at(base,key,"+location(e,n)+");})")
}
fn subslice(e Emitter, n lower.Node) Result<string> {
    let base=node(e.core,n.children[0])
    if !slice_type(base.type_name) { return err(fail(n,"unsupported native slice of "+base.type_name)) }
    let start=node(e.core,n.children[1])
    let end=node(e.core,n.children[2])
    var first="0"
    var last="base.length"
    if start.kind!="Omitted" { first=expression(e,start)? }
    if end.kind!="Omitted" { last=expression(e,end)? }
    return ok("({auto base="+expression(e,base)?+";hn::I first="+first+";hn::I last="+last
        +";hn::sub_slice(std::move(base),first,last,"+location(e,n)+");})")
}
fn array_literal(e Emitter, n lower.Node, expected string) Result<string> {
    if !slice_type(expected) {
        if len(n.children)==0 && (expected=="" || expected=="[]") { return ok("hn::EmptySlice{}") }
        return err(fail(n,"unsupported native array literal type "+expected))
    }
    let element=cpp_type(e,n,rules.cut(expected,2,len(expected)))?
    var code="({std::vector<"+element+"> items;items.reserve("+str(len(n.children))+");\n"
    for child in n.children {
        code+="items.push_back("+contextual_expression(e,node(e.core,child),rules.cut(expected,2,len(expected)))?+");\n"
    }
    return ok(code+"hn::Slice<"+element+">::of(std::move(items));})")
}
fn map_literal(e Emitter, n lower.Node) Result<string> {
    let parts=rules.arguments(n.type_name,"map")
    if len(parts)!=2 { return err(fail(n,"unsupported native map type "+n.type_name)) }
    let key_type=cpp_type(e,n,parts[0])?
    let value_type=cpp_type(e,n,parts[1])?
    var code="({auto map=hn::new_map<"+key_type+","+value_type+">();\n"
    for i in 1..len(n.children) {
        let item=node(e.core,n.children[i])
        code+=("{"+key_type+" key="+expression(e,node(e.core,item.children[0]))?+";\n"
             +value_type+" value="+expression(e,node(e.core,item.children[1]))?+";\n"
             +"hn::put(map,std::move(key),std::move(value),"+location(e,item)+");}\n")
    }
    return ok(code+"map;})")
}
fn contextual_expression(e Emitter, n lower.Node, expected string) Result<string> {
    if n.kind=="Array" { return array_literal(e,n,expected) }
    return expression(e,n)
}
fn structure_literal(e Emitter, n lower.Node) Result<string> {
    let t=cpp_type(e,n,n.type_name)?
    var code="({"+t+" record{};\n"
    for child in n.children {
        let field=node(e.core,child)
        let id=field_id(e,field,n.type_name)?
        let value=node(e.core,field.children[0])
        let owner=record_name(n.type_name)
        if node(e.core,unwrap(e.records[owner])).role=="enum-layout" {
            if field.text=="$case" {
                code+="record.fields.get().tag="+str(unwrap(e.tags[owner+":"+value.text]))+";\n"
                continue
            }
            if value.kind=="Nil" { continue }
        }
        let declaration=node(e.core,id)
        var expected=declaration.type_name
        if expected=="" { expected=type_text(e.core,node(e.core,declaration.children[0])) }
        code+="record.fields.get()."+field_name(e,id)+"="+contextual_expression(e,value,expected)?+";\n"
    }
    return ok(code+"record;})")
}
fn expression(e Emitter, n lower.Node) Result<string> {
    let k=n.kind
    if k=="Call" { return call(e,n) }
    if k=="Nil" { return ok("std::nullopt") }
    if k=="Pack" { return pack(e,n.children) }
    if k=="Array" { return array_literal(e,n,n.type_name) }
    if k=="MapLiteral" { return map_literal(e,n) }
    if k=="Index" { return index(e,n) }
    if k=="Slice" { return subslice(e,n) }
    if k=="Assignment" || k=="Update" { return assignment(e,n) }
    if k=="Propagate" {
        let operand=node(e.core,n.children[0])
        if len(rules.arguments(operand.type_name,"Result"))!=2 { return err(fail(n,"unsupported native propagation")) }
        return ok("({auto pending="+expression(e,operand)?+";if(!pending.ok)return hn::propagated("
            +"std::move(pending.error),pending.trace,"+location(e,n)+");std::move(pending.value);})")
    }
    if k=="Name" {
        let value=read_variable(e,n)?
        if optional_name(e,n) && !strings.ends_with(n.type_name,"?") && n.type_name!="nil" {
            return ok("hn::unwrap("+value+","+location(e,n)+")")
        }
        return ok(value)
    }
    cpp_type(e,n,n.type_name)?
    if k=="Integer" { return literal(n,false) }
    if k=="Float" {
        let text=strings.replace(n.text,"_","")
        if is_err(json.decode(text)) { return err(fail(n,"unrepresentable floating literal")) }
        return ok("static_cast<hn::F>("+text+")")
    }
    if k=="Boolean" { return ok(n.text) }
    if k=="String" { return ok("text"+unwrap(e.positions[n.id])) }
    if k=="StructLiteral" { return structure_literal(e,n) }
    if k=="Member" {
        let base=node(e.core,n.children[0])
        let owner=expression(e,base)?
        if n.text=="len" && (base.type_name=="string" || slice_type(base.type_name) || map_type(base.type_name)) { return ok("hn::len("+owner+")") }
        let field=field_id(e,n,base.type_name)?
        return ok("("+owner+").fields.get()."+field_name(e,field))
    }
    if k=="Unary" {
        let child=node(e.core,n.children[0])
        if n.text=="-" && child.kind=="Integer" { return literal(child,true) }
        if n.text!="-" && n.text!="+" && n.text!="!" { return err(fail(n,"unsupported native unary operator "+n.text)) }
        let operand=expression(e,child)?
        if n.text=="-" {
            if n.type_name=="float" { return ok("(-("+operand+"))") }
            return ok("hn::neg("+operand+","+location(e,n)+")")
        }
        return ok("("+n.text+"("+operand+"))")
    }
    if k=="Binary" {
        let op=n.text
        let left_node=node(e.core,n.children[0])
        let right_node=node(e.core,n.children[1])
        var left=expression(e,left_node)?
        var right=expression(e,right_node)?
        if left_node.kind=="Nil" || right_node.kind=="Nil" {
            left=optional_operand(e,left_node)?
            right=optional_operand(e,right_node)?
        }
        if op=="&&" || op=="||" { return ok("("+left+op+right+")") }
        let helper=integer_operator(op)
        let head="({auto left="+left+";\nauto right="+right+";\n"
        if left_node.type_name=="string" && right_node.type_name=="string" {
            if op=="+" { return ok(head+"hn::concat(left,right,"+location(e,n)+");})") }
            if op=="<=" { return ok(head+"!(right<left);})") }
            if op==">=" { return ok(head+"!(left<right);})") }
            if op==">" { return ok(head+"right<left;})") }
        }
        if n.type_name=="float" && (op=="+" || op=="-" || op=="*" || op=="/") {
            var method="fdiv"
            if op=="+" { method="fadd" }
            else if op=="-" { method="fsub" }
            else if op=="*" { method="fmul" }
            return ok(head+"hn::"+method+"(left,right,"+location(e,n)+");})")
        }
        if n.type_name=="int" && (op=="&" || op=="|" || op=="^" || op=="<<" || op==">>") {
            return ok(head+"hn::general_binary<hn::I>("+quote(op)+",left,right,"+location(e,n)+");})")
        }
        if helper!="" && left_node.type_name=="int" && right_node.type_name=="int" {
            return ok(head+"hn::"+helper+"(left,right,"+location(e,n)+");})")
        }
        if (op=="==" || op=="!=") && (left_node.kind=="Nil" || right_node.kind=="Nil") {
            if left_node.kind=="Nil" && right_node.kind=="Nil" { return ok(str(op=="==")) }
            return ok(head+"left"+op+"right;})")
        }
        if (left_node.type_name=="string" || left_node.type_name=="bool" || left_node.type_name=="int" || left_node.type_name=="float") && (op=="==" || op=="!=" || op=="<" || op==">" || op=="<=" || op==">=") {
            return ok(head+"left"+op+"right;})")
        }
        if op=="==" || op=="!=" {
            return ok(head+"hn::general_binary<bool>("+quote(op)+",left,right,"+location(e,n)+");})")
        }
        return err(fail(n,"unsupported native binary operator "+op))
    }
    return err(fail(n,"unsupported native expression "+k))
}
fn compound(e Emitter, n lower.Node, t string, read string) Result<string> {
    if n.text=="=" { return ok("rhs") }
    var op=rules.cut(n.text,0,len(n.text)-1)
    if n.kind=="Update" {
        op="+"
        if n.text=="--" { op="-" }
    }
    let helper=integer_operator(op)
    if t=="int" && helper!="" { return ok("hn::"+helper+"("+read+",rhs,"+location(e,n)+")") }
    if t=="string" && op=="+" { return ok("hn::concat("+read+",rhs,"+location(e,n)+")") }
    return err(fail(n,"unsupported native assignment "+n.text+" for "+t))
}
fn receiver(e Emitter, n lower.Node) Result<Receiver> {
    if n.kind=="Index" {
        let base=node(e.core,n.children[0])
        if !slice_type(base.type_name) { return err(fail(n,"native field target needs a record or slice element")) }
        let owner="owner"+cpp_id(e,n.id)
        let key="key"+cpp_id(e,n.id)
        let prefix=("auto "+owner+"="+expression(e,base)?+";\n"
            +"auto "+key+"="+expression(e,node(e.core,n.children[1]))?+";\n")
        return ok(Receiver{code:prefix,value:"hn::slot("+owner+","+key+","+location(e,n)+")"})
    }
    if n.kind=="Member" {
        let base=node(e.core,n.children[0])
        let field=field_id(e,n,base.type_name)?
        let source=receiver(e,base)?
        return ok(Receiver{code:source.code,value:"("+source.value+").fields.get()."+field_name(e,field)})
    }
    return ok(Receiver{code:"",value:expression(e,n)?})
}
fn assignment(e Emitter, n lower.Node) Result<string> {
    let target=node(e.core,n.children[0])
    var code="({"
    var value="hn::I{1}"
    if n.kind!="Update" { value=contextual_expression(e,node(e.core,n.children[1]),n.type_name)? }
    var read="slot"
    var indirect=false
    if target.kind=="Name" {
        code+="auto& slot="+read_variable(e,target)?+";\n"
    } else if target.kind=="Member" {
        let base=node(e.core,target.children[0])
        let name=record_name(base.type_name)
        let field=field_id(e,target,name)?
        let body=record_body(e,unwrap(e.records[name]))
        let owner=receiver(e,base)?
        code+=owner.code+"auto slot=field_location("+owner.value+",&"+body+"::"+field_name(e,field)+");\n"
        read="slot.read()"
        indirect=true
    } else if target.kind=="Index" {
        let base=node(e.core,target.children[0])
        let key=node(e.core,target.children[1])
        code+="auto base="+expression(e,base)?+";auto key="+expression(e,key)?+";\n"
        if map_type(base.type_name) {
            code+="auto slot=hn::locate_map(std::move(base),std::move(key),"+location(e,target)+");\n"
            read="slot.read("+location(e,n)+")"
        } else if slice_type(base.type_name) {
            code+="auto slot=hn::locate_sequence(std::move(base),key,"+location(e,target)+");\n"
            read="slot.read()"
        } else { return err(fail(target,"unsupported native indexed assignment "+base.type_name)) }
        indirect=true
    } else { return err(fail(target,"unsupported native assignment target "+target.kind)) }
    let t=cpp_type(e,n,n.type_name)?
    code+=t+" rhs="+value+";\n"
    let updated=compound(e,n,n.type_name,read)?
    code+=t+" updated="+updated+";\n"
    if indirect { code+="slot.write(updated,"+location(e,n)+");\n" }
    else { code+="slot=updated;\n" }
    return ok(code+"updated;})")
}
fn loop_binding(e Emitter, n lower.Node, value string) string {
    if n.text=="_" { return "" }
    return "const auto loop"+cpp_id(e,n.id)+"=capture_value("+value+");\n"
}
fn iteration(e Emitter, n lower.Node) Result<string> {
    let count=len(n.children)-2
    let sequence=node(e.core,n.children[count])
    let body=statement(e,node(e.core,n.children[count+1]))?
    let first=node(e.core,n.children[0])
    let last=node(e.core,n.children[count-1])
    if sequence.kind=="Range" {
        if count!=1 { return err(fail(n,"native range loop requires one binding")) }
        let site=location(e,sequence)
        var step="1"
        if len(sequence.children)==3 { step=expression(e,node(e.core,sequence.children[2]))? }
        var positive="<"
        var negative=">"
        if sequence.text=="..=" { positive="<="
            negative=">=" }
        return ok("{hn::I cursor="+expression(e,node(e.core,sequence.children[0]))?+";hn::I limit="
            +expression(e,node(e.core,sequence.children[1]))?+";hn::I step="+step+";bool done=false;\n"
            +"if(step==0)hn::fail("+site+",\"range step cannot be zero\",\"E4005\");\n"
            +"while(!done&&(step>0?cursor"+positive+"limit:cursor"+negative+"limit)){\n"
            +loop_binding(e,first,"cursor")
            +"if((step>0&&cursor>std::numeric_limits<hn::I>::max()-step)||"
            +"(step<0&&cursor<std::numeric_limits<hn::I>::min()-step))done=true;else cursor+=step;\n"
            +body+"}\n}\n")
    }
    let header="{auto iterable="+expression(e,sequence)?+";\n"
    if slice_type(sequence.type_name) {
        var bind=""
        if count==2 { bind=loop_binding(e,first,"ix") }
        let element=cpp_type(e,sequence,rules.cut(sequence.type_name,2,len(sequence.type_name)))?
        return ok(header+"for(hn::I ix=0;ix<iterable.length;++ix){\n"+bind
            +loop_binding(e,last,element+"(hn::at(iterable,ix,"+location(e,sequence)+"))")+body+"}\n}\n")
    }
    if map_type(sequence.type_name) {
        let parts=rules.arguments(sequence.type_name,"map")
        let pair="std::pair<"+cpp_type(e,sequence,parts[0])?+","+cpp_type(e,sequence,parts[1])?+">"
        var bind=loop_binding(e,first,"item.first")
        if count==2 { bind+=loop_binding(e,last,"item.second") }
        return ok(header+"std::vector<"+pair+"> snapshot(iterable.data->begin(),iterable.data->end());\n"
            +"for(const auto& item:snapshot){\n"+bind+body+"}\n}\n")
    }
    return err(fail(sequence,"unsupported native iteration over "+sequence.type_name))
}
fn pack(e Emitter, children []int) Result<string> {
    var code="({"
    let empty []string=[]
    var names=list.from_slice(empty)
    for id in children {
        let name="item"+cpp_id(e,id)
        code+="auto "+name+"="+expression(e,node(e.core,id))?+";\n"
        list.append(names,"std::move("+name+")")?
    }
    return ok(code+"std::make_tuple("+strings.join(list.snapshot(names),",")+");})")
}
fn multiple(e Emitter, n lower.Node) Result<string> {
    let bindings=node(e.core,n.children[0])
    let pack_name="pack"+cpp_id(e,n.id)
    var setup=""
    var writes=""
    for i in 0..len(bindings.children) {
        let binding=node(e.core,bindings.children[i])
        if binding.text=="_" { continue }
        let item="std::get<"+str(i)+">("+pack_name+")"
        if n.kind=="MultiAssignment" {
            if binding.kind!="Name" { return err(fail(binding,"unsupported native multiple assignment target")) }
            let slot="target"+cpp_id(e,binding.id)
            setup+="auto& "+slot+"="+read_variable(e,binding)?+";\n"
            writes+=slot+"="+item+";\n"
        } else {
            let name=variable(e,binding)?
            if n.text=="var" { writes+="auto "+name+"="+item+";\n" }
            else { writes+="const auto "+name+"=capture_value("+item+");\n" }
        }
    }
    return ok(setup+"auto "+pack_name+"="+expression(e,node(e.core,n.children[1]))?+";\n"+writes)
}
fn match_statement(e Emitter, n lower.Node) Result<string> {
    let subject=node(e.core,n.children[0])
    let owner=record_name(n.type_name)
    var enumeration=false
    if has(e.records,owner) { enumeration=node(e.core,unwrap(e.records[owner])).role=="enum-layout" }
    var code="{auto subject="+expression(e,subject)?+";\n"
    for i in 1..len(n.children) {
        let arm=node(e.core,n.children[i])
        let pattern=node(e.core,arm.children[0])
        let bindings=node(e.core,arm.children[1])
        let any=pattern.kind=="Name" && pattern.text=="_"
        if i>1 { code+="else " }
        var label=""
        if !any {
            if enumeration {
                let parts=strings.split(pattern.text,".")
                label=parts[len(parts)-1]
                code+="if(subject.fields.get().tag=="+str(unwrap(e.tags[owner+":"+label]))+")"
            } else {
                var value=expression(e,pattern)?
                if pattern.kind=="Nil" { value="std::nullopt" }
                code+="if(subject=="+value+")"
            }
        }
        code+="{\n"
        for j in 0..len(bindings.children) {
            let binding=node(e.core,bindings.children[j])
            if binding.text=="_" { continue }
            let key=owner+":$"+label+"#"+str(j)+"#"+binding.type_name
            if !has(e.fields,key) { return err(fail(binding,"unsupported native match payload "+key)) }
            code+="const auto "+variable(e,binding)?+"=capture_value(subject.fields.get()."+field_name(e,unwrap(e.fields[key]))+");\n"
        }
        code+=block_contents(e,node(e.core,arm.children[2]))?+"}\n"
    }
    return ok(code+"}\n")
}
fn statement(e Emitter, n lower.Node) Result<string> {
    let k=n.kind
    if k=="Block" { return ok("{\n"+block_contents(e,n)?+"}\n") }
    if k=="Let" || k=="Var" {
        var value=contextual_expression(e,node(e.core,n.children[len(n.children)-1]),n.type_name)?
        if k=="Let" { value="capture_value("+value+")" }
        if n.text=="_" { return ok("(void)("+value+");\n") }
        let name=variable(e,n)?
        if has(e.globals,n.text) { return ok(name+".emplace("+value+");\n") }
        let t=cpp_type(e,n,n.type_name)?
        if k=="Let" { return ok("const "+t+" "+name+"="+value+";\n") }
        return ok(t+" "+name+"="+value+";\n")
    }
    if k=="ExpressionStatement" {
        let child=node(e.core,n.children[0])
        return ok("(void)("+expression(e,child)?+");\n")
    }
    if k=="If" || k=="While" {
        let condition=expression(e,node(e.core,n.children[0]))?
        var result="if"
        if k=="While" { result="while" }
        result+="("+condition+")"+statement(e,node(e.core,n.children[1]))?
        if len(n.children)==3 { result+="else "+statement(e,node(e.core,n.children[2]))? }
        return ok(result)
    }
    if k=="For" { return iteration(e,n) }
    if k=="Match" { return match_statement(e,n) }
    if k=="Defer" { return emit_call(e,node(e.core,n.children[0]),true) }
    if k=="MultiBinding" || k=="MultiAssignment" { return multiple(e,n) }
    if k=="Break" { return ok("break;\n") }
    if k=="Continue" { return ok("continue;\n") }
    if k=="Return" {
        if len(n.children)==0 { return ok("return;\n") }
        if len(n.children)>1 { return ok("return "+pack(e,n.children)?+";\n") }
        return ok("return "+expression(e,node(e.core,n.children[0]))?+";\n")
    }
    if k=="ExternalInit" {
        return ok("hn::init_external_module("+quote(n.text)+","+location(e,n)+");\n")
    }
    return err(fail(n,"unsupported native statement "+k))
}
fn block_contents(e Emitter, n lower.Node) Result<string> {
    let empty []string=[]
    var lines=list.from_slice(empty)
    for id in n.children { list.append(lines,statement(e,node(e.core,id))?)? }
    return ok(strings.join(list.snapshot(lines),""))
}

fn unit_id(module string) string {
    return "u"+str(bytes.crc32(bytes.from_text(module)))
}
fn prepare(core lower.Core) Result<Program> {
    var e=Emitter{core:core,values:map[string]string{},functions:map[string]int{},
        records:map[string]int{},fields:map[string]int{},tags:map[string]int{},files:map[string]string{},
        globals:map[string]bool{},value_types:map[string]string{},ids:map[int]string{},positions:map[int]string{}}
    let empty []int=[]
    let no_units []Unit=[]
    var units=list.from_slice(no_units)
    var used=map[string]bool{}
    var records=list.from_slice(empty)
    let nodes=list.snapshot(core.nodes)
    var cursor=0
    for unit in list.snapshot(core.initialization) {
        let base=unit_id(unit.module)
        var id=base
        var suffix=0
        while has(used,id) {
            suffix+=1
            id=base+"_"+str(suffix)
        }
        used[id]=true
        e.files[unit.module]="source_"+id
        let first=cursor
        # C05 appends all nodes for a module before lowering the next module.
        while cursor<len(nodes) && nodes[cursor].module==unit.module {
            e.ids[cursor]=str(cursor-first)
            e.positions[cursor]=id+"_"+cpp_id(e,cursor)
            cursor+=1
        }
        list.append(units,Unit{module:unit.module,id:id,roots:unit.roots,first:first,end:cursor})?
    }
    if cursor!=len(nodes) { return err("E8001 native Core module ranges are inconsistent") }
    for unit in list.snapshot(units) {
        for id in unit.roots {
            let n=node(core,id)
            if n.role!="source" && n.role!="enum-constructor" && n.role!="enum-layout" && n.role!="external" && n.role!="async-body" { return err(fail(n,"unsupported native declaration "+n.role)) }
            if n.kind=="Function" {
                e.ids[id]=mangle(n.text)
                e.functions[n.text]=id
            } else if n.kind=="Struct" {
                let owner=enum_decl(n)
                if strings.contains(owner," ") { return err(fail(n,"unsupported native structure "+owner)) }
                e.records[owner]=id
                e.ids[id]=mangle(owner)
                var tag=0
                for child in n.children {
                    let field=node(core,child)
                    e.fields[owner+":"+field.text]=child
                    e.ids[child]=mangle(field.text)
                    if n.role=="enum-layout" && field.text!="$case" {
                        let label=enum_part(field.text)[0]
                        let key=owner+":"+rules.cut(label,1,len(label))
                        if !has(e.tags,key) {
                            e.tags[key]=tag
                            tag+=1
                        }
                    }
                }
                list.append(records,id)?
            } else if (n.kind=="Let" || n.kind=="Var") && n.text!="_" {
                e.ids[id]=mangle(n.text)
                e.globals[n.text]=true
            }
        }
    }
    for n in list.snapshot(core.nodes) {
        if n.kind=="Let" || n.kind=="Var" || n.kind=="Parameter" {
            var prefix="v"
            if has(e.globals,n.text) { prefix="global_" }
            e.values[binding_name(n)]=prefix+cpp_id(e,n.id)
            e.value_types[binding_name(n)]=n.type_name
        }
        if n.kind=="For" {
            for i in 0..len(n.children)-2 {
                let binding=node(core,n.children[i])
                e.values[binding.text]="loop"+cpp_id(e,binding.id)
            }
        }
        if n.kind=="BindingList" {
            for id in n.children {
                let binding=node(core,id)
                if binding.kind!="Name" || binding.text=="_" || has(e.values,binding.text) { continue }
                e.values[binding.text]="v"+cpp_id(e,id)
                e.value_types[binding.text]=binding.type_name
            }
        }
    }
    var layouts=map[int]RecordCode{}
    for id in list.snapshot(records) { layouts[id]=layout(e,id)? }
    return ok(Program{e:e,units:list.snapshot(units),layouts:layouts})
}

struct Interface {
    records map[int]bool
    functions map[int]bool
    globals map[int]bool
}

fn declaration_types(e Emitter, n lower.Node, types_used mut map[int]bool) {
    for id in n.children {
        let child=node(e.core,id)
        if child.kind=="Parameter" { used_types(e,child.type_name,types_used) }
        if child.kind=="ReturnTypes" {
            for ty in child.children { used_types(e,type_text(e.core,node(e.core,ty)),types_used) }
        }
    }
}

fn interface_for(p Program, units []Unit) Result<Interface> {
    let e=p.e
    var out=Interface{records:map[int]bool{},functions:map[int]bool{},globals:map[int]bool{}}
    var global_ids=map[string]int{}
    for unit in p.units {
        for id in unit.roots {
            let n=node(e.core,id)
            if has(e.globals,n.text) { global_ids[n.text]=id }
        }
    }
    for unit in units {
        for id in unit.roots {
            let n=node(e.core,id)
            if n.kind=="Function" { out.functions[id]=true }
            if n.kind=="Struct" { out.records[id]=true }
            if has(global_ids,n.text) { out.globals[id]=true }
        }
        for id in unit.first..unit.end {
            let n=node(e.core,id)
            used_types(e,n.type_name,out.records)
            if n.kind=="Name" {
                if has(e.functions,n.text) { out.functions[unwrap(e.functions[n.text])]=true }
                if has(global_ids,n.text) { out.globals[unwrap(global_ids[n.text])]=true }
            }
            if n.kind=="TypeName" { used_types(e,n.text,out.records) }
        }
    }
    for id in sorted_ids(out.functions) { declaration_types(e,node(e.core,id),out.records) }
    for id in sorted_ids(out.globals) { used_types(e,node(e.core,id).type_name,out.records) }
    return ok(out)
}

fn close_layouts(p Program, id int, found mut map[int]bool) {
    if has(found,id) { return }
    found[id]=true
    for dep in unwrap(p.layouts[id]).dependencies { close_layouts(p,dep,found) }
}

fn ordered_layout(p Program, id int, active mut map[int]bool, done mut map[int]bool, order mut List<int>) Result<void> {
    if has(done,id) { return ok() }
    if has(active,id) { return err(fail(node(p.e.core,id),"cyclic native record layout")) }
    active[id]=true
    for dep in unwrap(p.layouts[id]).by_value { ordered_layout(p,dep,active,done,order)? }
    delete(active,id)
    done[id]=true
    list.append(order,id)?
    return ok()
}

fn header(p Program, iface Interface, scalar bool) Result<string> {
    let e=p.e
    var needed=map[int]bool{}
    for id in sorted_ids(iface.records) { close_layouts(p,id,needed) }
    let records=sorted_ids(needed)
    var runtime="native_rt.hpp"
    if scalar { runtime="native_scalar.hpp" }
    var output=list.from_slice(["#include \"hua/"+runtime+"\"\nnamespace hua_generated {\n",
        "using hn::capture_value;using hn::to_value;using hn::clone;\n"])
    let empty []int=[]
    var ordering=list.from_slice(empty)
    var active=map[int]bool{}
    var done=map[int]bool{}
    for id in records {
        ordered_layout(p,id,active,done,ordering)?
        list.append(output,"struct "+record_type(e,id)+";\n")?
    }
    for id in list.snapshot(ordering) { list.append(output,unwrap(p.layouts[id]).definition)? }
    list.append(output,"}\n")?
    for id in records { list.append(output,unwrap(p.layouts[id]).name)? }
    list.append(output,"namespace hua_generated {\n")?
    for id in records { list.append(output,unwrap(p.layouts[id]).declarations)? }
    if !scalar {
        list.append(output,"template<class T> auto borrow_record(T&& owner){"
        +"using Record=std::remove_cvref_t<T>;using Storage=std::remove_cvref_t<decltype(owner.fields)>;"
        +"return Record{Storage::alias(owner.fields.pin())};}\n"
        +"template<class Record,class Body,class Field> "
        +"auto field_location(Record&& owner,Field Body::* field){return hn::locate_field(owner.fields,field);}\n"
        )?
    }
    list.append(output,"template<class T> T& global_slot(std::optional<T>& value,const hn::SourceSpan& site){"
        +"if(!value)hn::fail(site,\"global binding is not initialized\",\"E4001\");return *value;}\n")?
    for id in sorted_ids(iface.functions) {
        let fn_node=node(e.core,id)
        if fn_node.role!="external" { list.append(output,signature(e,fn_node,false)?+";\n")? }
    }
    for id in sorted_ids(iface.globals) {
        let n=node(e.core,id)
        list.append(output,"extern std::optional<"+cpp_type(e,n,n.type_name)?+"> "+variable(e,n)?+";\n")?
    }
    list.append(output,"}\n")?
    return ok(strings.join(list.snapshot(output),""))
}

fn implementation(p Program, unit Unit, scalar bool) Result<string> {
    let e=p.e
    var output=list.from_slice(["namespace hua_generated {\n"])
    list.append(output,"static const char "+unwrap(e.files[unit.module])+"[]="+quote(unit.module)+";\n")?
    for id in unit.first..unit.end {
        let n=node(e.core,id)
        list.append(output,site(e,n))?
        if n.kind=="String" {
            if scalar {
                list.append(output,"static const hn::Str text"+unwrap(e.positions[id])+"("
                    +quote(n.text)+","+str(len(n.text))+");\n")?
            } else {
                list.append(output,"static hn::StrRep raw"+unwrap(e.positions[id])+"{hn::StrRep::immortal,std::string("
                +quote(n.text)+","+str(len(n.text))+")};\nstatic const hn::Str text"+unwrap(e.positions[id])+"(&raw"+unwrap(e.positions[id])+");\n")?
            }
        }
    }
    let empty []string=[]
    var initializers=list.from_slice(empty)
    var problems=list.from_slice(empty)
    for id in unit.roots {
        let n=node(e.core,id)
        if n.kind=="Function" {
            if n.role=="external" { continue }
            let body=node(e.core,n.children[len(n.children)-1])
            let lines=block_contents(e,body)
            if is_err(lines) {
                list.append(problems,unwrap_err(lines))?
                if list.len(problems)>=32 { break }
                continue
            }
            var tail="}\n"
            if strings.starts_with(return_type(e,n)?,"hn::Opt<") { tail="return std::nullopt;\n"+tail }
            list.append(output,signature(e,n,true)?+"{\n"+unwrap(lines)+tail)?
        } else if n.kind=="Struct" {
            list.append(output,unwrap(p.layouts[id]).methods)?
        } else {
            if has(e.globals,n.text) {
                list.append(output,"std::optional<"+cpp_type(e,n,n.type_name)?+"> "+variable(e,n)?+";\n")?
            }
            list.append(initializers,statement(e,n)?)?
        }
    }
    if list.len(problems)>0 { return err(strings.join(list.snapshot(problems),"\n")) }
    list.append(output,"void init_"+unit.id+"(){\n"+strings.join(list.snapshot(initializers),"")+"}\n}\n")?
    return ok(strings.join(list.snapshot(output),""))
}

fn uses_tasks(core lower.Core) bool {
    for n in list.snapshot(core.nodes) {
        if n.role=="async-body" || n.text=="$core$task_start" || n.text=="$core$task_group_begin" || strings.starts_with(n.text,"$core$$std$task$") {
            return true
        }
    }
    return false
}
fn startup(p Program) Result<string> {
    let e=p.e
    var declarations=""
    var initialize=""
    for em in e.core.external_modules {
        var ex_list=""
        for i in 0..len(em.exports) {
            let ex=em.exports[i]
            if i>0 { ex_list+="," }
            var ps=""
            for j in 0..len(ex.parameters) {
                if j>0 { ps+="," }
                ps+=quote(ex.parameters[j])
            }
            ex_list+="hn::ExternalExportSpec{"+quote(ex.name)+","+quote(ex.linked_name)+","+quote(ex.result)+",{"+ps+"}}"
        }
        let sn=node(e.core,em.site_node)
        let sp="hn::SourceSpan{"+quote(sn.module)+","+str(sn.start)+","+str(sn.end)+","+str(sn.line)+","+str(sn.column)+"}"
        initialize+="hn::register_external_module("+quote(em.id)+","+quote(em.artifact)+","+str(em.abi_version)+",{"+ex_list+"},"+sp+");\n"
    }
    for unit in p.units {
        declarations+="void init_"+unit.id+"();\n"
        initialize+="init_"+unit.id+"();\n"
    }
    var result="return hn::Value{};"
    var position="{}"
    if has(e.functions,"main") {
        let main=node(e.core,unwrap(e.functions["main"]))
        let invoke=function_name(e,main.id)+"()"
        if strings.starts_with(return_type(e,main)?,"hn::Result<") { result="return hn::to_value("+invoke+");" }
        else { result=invoke+";"+result }
        position="{"+quote(main.module)+","+str(main.start)+","+str(main.end)+","+str(main.line)+","+str(main.column)+"}"
    }
    var tasks_flag="false"
    if uses_tasks(p.e.core) { tasks_flag="true" }
    return ok("namespace hua_generated {\n"+declarations+"static const hn::SourceSpan entry_site"+position
        +";\nstatic hn::Value entry(){"+initialize+result+"}\n}\n"
        +"int main(int argc,char** argv){return hn::run_main(argc,argv,hua_generated::entry_site,&hua_generated::entry,"+tasks_flag+");}\n")
}

# Keep the legacy one-file generator available for older SDKs and comparisons.
fn emit_combined(p Program, scalar bool) Result<string> {
    var output=list.from_slice([header(p,interface_for(p,p.units)?,scalar)?])
    for unit in p.units {
        list.append(output,implementation(p,unit,scalar)?)?
    }
    list.append(output,startup(p)?)?
    return ok(strings.join(list.snapshot(output),""))
}

pub fn emit(core lower.Core) Result<string> { return emit_combined(prepare(core)?,false) }

# Scalar programs reuse the same verified Core, C++ expressions and initialization order.
# Any node outside the compact runtime's coverage uses the full runtime.
fn supports_scalar(core lower.Core) bool {
    if len(core.external_modules)>0 { return false }
    for n in list.snapshot(core.nodes) {
        let t=n.type_name
        let k=n.kind
        if t!="" && t!="void" && t!="int" && t!="bool" && t!="string" &&
                !strings.starts_with(t,"fn:") && !strings.starts_with(t,"builtin:") { return false }
        if !alg.contains(["Function","Parameter","ReturnTypes","TypeName","Block","Let","Var",
            "ExpressionStatement","If","While","For","Range","Break","Continue","Return",
            "Integer","Boolean","String","Name","Call","Binary","Unary","Assignment","Update"],k) { return false }
        if k=="Name" && strings.starts_with(n.text,"$core$") && n.text!="$core$print" { return false }
        if k=="Return" && len(n.children)>1 { return false }
        if k=="Binary" && !alg.contains(["+","-","*","//","%","==","!=","<",">","<=",">=","&&","||"],n.text) { return false }
        if k=="Assignment" && !alg.contains(["=","+=","-=","*=","//=","%="],n.text) { return false }
    }
    return true
}

pub fn emit_release(core lower.Core, directory string) Result<Split> {
    if list.len(core.initialization)>2 || list.len(core.nodes)>256 {
        return emit_split(core,directory)
    }
    let p=prepare(core)?
    let scalar=supports_scalar(core)
    var runtime="full"
    if scalar { runtime="scalar" }
    let id=p.units[len(p.units)-1].id
    output_unit(directory,id,"#pragma once\n",emit_combined(p,scalar)?)?
    return ok(Split{units:[BuildUnit{id:id,module:core.entry}],runtime:runtime,layout:"combined"})
}

fn output_unit(directory string, id string, declarations string, code string) Result<void> {
    fs.write_text(path.join([directory,id+".hpp"])?,declarations)?
    fs.write_text(path.join([directory,id+".cpp"])?,"#include \""+id+".hpp\"\n"+code)?
    return ok()
}

pub fn emit_split(core lower.Core, directory string) Result<Split> {
    let p=prepare(core)?
    let empty []BuildUnit=[]
    var units=list.from_slice(empty)
    for unit in p.units {
        var code=implementation(p,unit,false)?
        if len(p.units)==1 { code+=startup(p)? }
        output_unit(directory,unit.id,header(p,interface_for(p,[unit])?,false)?,code)?
        list.append(units,BuildUnit{id:unit.id,module:unit.module})?
    }
    if len(p.units)>1 {
        var iface=Interface{records:map[int]bool{},functions:map[int]bool{},globals:map[int]bool{}}
        if has(p.e.functions,"main") {
            let id=unwrap(p.e.functions["main"])
            iface.functions[id]=true
            declaration_types(p.e,node(p.e.core,id),iface.records)
        }
        output_unit(directory,"entry",header(p,iface,false)?,startup(p)?)?
        list.append(units,BuildUnit{id:"entry",module:""})?
    }
    return ok(Split{units:list.snapshot(units),runtime:"full",layout:"modules"})
}
