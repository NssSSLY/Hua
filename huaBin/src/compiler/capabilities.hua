# C04 internal capability flow with inline-singleton factored OriginPool, pre-extracted UnitPlan (NodeOp), per-field demand & bottom-up SCC-local solver.
# The input program is never executed.
import modules as modules
import ast_pool as ast
import type_rules as rules
import signatures as signatures
import origin_pool as opool
import std.list as list
import std.strings as strings
import std.alg as alg

pub struct View { type_name string
    writable bool
    readonly_children bool
    deep_owned bool
    record_copy bool
    oid int }
pub struct Value { root View
    fields map[string]View
    prefixes map[string]map[string]bool
    prefix string
    readonly_fields bool
    positions []Value }
# Node consumers use the root view (including write origins) and positional roots only.
pub struct Fact { root View
    positions []Fact }
fn node_fact(input Value) Fact { var out=Fact{root:input.root,positions:[]}
    if len(input.positions)>0 { var empty []Fact=[]
        var positions=list.from_slice(empty)
        for item in input.positions { unwrap(list.append(positions,node_fact(item))) }
        out.positions=list.snapshot(positions) }
    return out
}
pub struct Parameter { target string
    type_name string
    writable bool }
pub struct Function { target string
    module string
    node int
    parameters []Parameter
    result string
    asynchronous bool }
struct WriteArgument { destination string
    parameter bool
    writable bool }
struct CompiledWrite { owner string
    suffix string
    has_elem bool
    elem_ancestor string
    elem_suffix string
    fact View }
struct CompiledReq { owner string
    path string
    readonly bool }
struct Summary { returned Value
    unknown bool
    saw_return bool
    pure_fast bool
    writes map[string]View
    compiled_writes []CompiledWrite
    required map[int]bool
    compiled_reqs []CompiledReq }
struct NodeOp { kind int
    text string
    ref_target string
    decl_target string
    proj string
    node_key string
    children []int
    line int
    col int }
pub struct Model { facts map[string]Fact
    passes int
    work int
    error string }
struct State { std_sigs map[string]signatures.Signature
    fields map[string]string
    members map[string]map[string]string
    shapes map[string]map[string]View
    shape_prefixes map[string]map[string]map[string]bool
    parameter_fields map[string]map[string]View
    parameter_field_count int
    functions map[string]Function
    variants map[string]string
    summaries map[string]Summary
    dependents map[string]map[string]bool
    sub_ret_fields map[string]map[string]bool
    dirty map[string]bool
    facts map[string]Fact
    global_symbols map[string]bool
    errors map[string]string
    probing bool
    work int
    error string }
struct Environment { unit_id string
    function string
    values map[string]Value
    versions map[string]int
    next_version int
    updating bool
    edited_fields map[string]map[string]View
    edited_prefixes map[string]map[string]map[string]bool
    alias_cache map[string][]string
    alias_gen map[string]int
    alias_seq int
    returned Value
    saw_return bool
    writes map[string]bool
    visible map[string]bool
    required map[int]bool
    callees map[string]bool
    sub_ret_fields map[string]bool
    exits []map[string]Value
    deferred bool }

fn view(type string, writable bool) View { return View{type_name:type,writable:writable,readonly_children:false,deep_owned:false,record_copy:false,oid:0} }
fn value(type string, writable bool) Value { return Value{root:view(type,writable),fields:map[string]View{},prefixes:map[string]map[string]bool{},prefix:"",readonly_fields:false,positions:[]} }
fn key(module string, node int) string { return module+":"+str(node) }
fn record(type string) bool { return strings.contains(rules.optional(type),"#") && !rules.shared(type) && !strings.starts_with(type,"fn:") && !strings.starts_with(type,"variant:") }
fn pure_scalar(type string) bool {
    let n=len(type)
    if n==0 || n>6 { return strings.starts_with(type,"fn:") }
    return type=="string" || type=="int" || type=="bool" || type=="float" || type=="nil" || type=="void" || type=="byte" || type=="isize" || type=="usize" || type=="i8" || type=="i16" || type=="i32" || type=="i64" || type=="u8" || type=="u16" || type=="u32" || type=="u64" || type=="f32" || type=="f64"
}
fn split_origin(origin string) []string { return strings.split(origin,"|") }
fn depth_ok(path string) bool {
    if len(path)<18 { return true }
    return len(strings.split(path,"#@"))-1<=8
}
fn tick(s mut State, line int, col int) Result<void> {
    if s.work >= 1048576 { return err("E8202@"+str(line)+":"+str(col)+" capability work budget") }
    s.work += 1
    return ok()
}
fn denied(s mut State, e Environment, line int, col int, reason string) Result<void> {
    if e.function!="" && !has(s.errors,e.function) {
        s.errors[e.function]="E3003@"+str(line)+":"+str(col)+" ["+e.unit_id+"] "+reason }
    return ok()
}
fn projected(p mut opool.Pool, base View, path string, type string) View {
    var out=view(type,base.writable && !base.readonly_children)
    out.readonly_children=base.readonly_children || !base.writable
    out.deep_owned=base.deep_owned
    if base.oid!=0 { out.oid=opool.project_oid(p,base.oid,path,pure_scalar(type)) }
    return out
}
fn child_type(type string) string {
    let m=rules.arguments(type,"map")
    if len(m)==2 { return m[1] }
    let l=rules.arguments(type,"List")
    if len(l)==1 { return l[0] }
    return rules.element(type)
}
fn note_prefix(prefixes mut map[string]map[string]bool, path string) {
    if len(path)<=2 { return }
    if has(prefixes,"@types") {
        var seen=unwrap(prefixes["@types"])
        if has(seen,path) { return }
        seen[path]=true
    }
    if strings.starts_with(path,"#@") && !strings.contains(rules.cut(path,2,len(path)),"#@") { return }
    let parts=strings.split(path,"#@")
    var prefix=""
    let end=len(parts)-1
    for i in 1..end { prefix+="#@"+parts[i]
        if !has(prefixes,prefix) { prefixes[prefix]=map[string]bool{} }
        var descendants=unwrap(prefixes[prefix])
        descendants[path]=true }
}
fn note_type(prefixes mut map[string]map[string]bool, path string, type string) {
    let bucket="@type:"+type
    if !has(prefixes,bucket) { prefixes[bucket]=map[string]bool{} }
    var paths=unwrap(prefixes[bucket])
    paths[path]=true
}
fn prefix_index(fields map[string]View) map[string]map[string]bool {
    var out=map[string]map[string]bool{"@types":map[string]bool{}}
    for path, fact in fields { note_prefix(out,path)
        note_type(out,path,fact.type_name) }
    return out
}
fn field_shape(members map[string]map[string]string, base View, level int) map[string]View {
    var result=map[string]View{}
    if level>=8 { return result }
    var type=rules.optional(base.type_name)
    let wrapped=rules.arguments(type,"Result")
    if len(wrapped)==2 { type=wrapped[0] }
    if record(type) {
        for name, typ in unwrap_or(members[type],map[string]string{}) {
            let path="#@"+name
            var item=view(typ,base.writable && !base.readonly_children)
            item.readonly_children=base.readonly_children || !base.writable
            item.deep_owned=base.deep_owned
            if record(typ) && base.record_copy { item=copy_view(item) }
            result[path]=item
            for suffix, nested in field_shape(members,item,level+1) { result[path+suffix]=nested }
        }
    } else {
        let typ=child_type(type)
        if typ!="" {
            var item=view(typ,base.writable && !base.readonly_children)
            item.readonly_children=base.readonly_children || !base.writable
            item.deep_owned=base.deep_owned
            result["#@[]"]=item
            for suffix, nested in field_shape(members,item,level+1) { result["#@[]"+suffix]=nested }
        }
    }
    return result
}
fn field_defaults(s mut State, p mut opool.Pool, base View, level int) map[string]View {
    let cache_key=base.type_name+"|"+str(level)+":"+str(base.writable)+str(base.readonly_children)+str(base.deep_owned)+str(base.record_copy)
    if !has(s.shapes,cache_key) {
        var prototype=base
        prototype.oid=0
        s.shapes[cache_key]=field_shape(s.members,prototype,level)
    }
    var result=map[string]View{}
    let boid=base.oid
    for path, fact in unwrap(s.shapes[cache_key]) {
        var item=fact
        if boid!=0 { item.oid=opool.project_oid(p,boid,path,pure_scalar(fact.type_name)) }
        result[path]=item
    }
    return result
}
fn seeded(s mut State, p mut opool.Pool, type string, writable bool, owner string) Value {
    var out=value(type,writable)
    out.root.oid=opool.make_seed(p,owner,writable,pure_scalar(type))
    out.fields=field_defaults(s,p,out.root,0)
    if !has(s.shape_prefixes,type) { s.shape_prefixes[type]=prefix_index(out.fields) }
    out.prefixes=unwrap(s.shape_prefixes[type])
    return out
}
fn parameter_seeded(s mut State, p mut opool.Pool, type string, writable bool, owner string) Value {
    let identity=str(len(owner))+":"+owner+str(len(type))+":"+type+":"+str(writable)
    if !has(s.parameter_fields,identity) {
        let out=seeded(s,p,type,writable,owner)
        if len(s.parameter_fields)<4096 && s.parameter_field_count+len(out.fields)<=4096 {
            s.parameter_fields[identity]=out.fields
            s.parameter_field_count+=len(out.fields)
        }
        return out
    }
    var out=value(type,writable)
    out.root.oid=opool.make_seed(p,owner,writable,pure_scalar(type))
    out.fields=unwrap(s.parameter_fields[identity])
    out.prefixes=unwrap(s.shape_prefixes[type])
    return out
}
fn copy_view(input View) View {
    var out=input
    if record(out.type_name) {
        if !out.writable { out.deep_owned=false }
        out.readonly_children=out.readonly_children || !out.writable
        out.writable=true
        out.record_copy=true
    }
    return out
}
fn materialized(input Value) Value {
    if input.prefix=="" && !input.readonly_fields { return input }
    var out=input
    out.fields=map[string]View{}
    if input.prefix=="" {
        for path, fact in input.fields { var next=fact
            if input.readonly_fields { next.writable=false
                next.readonly_children=true }
            out.fields[path]=next }
    } else if has(input.prefixes,input.prefix) {
        for path, unused in unwrap(input.prefixes[input.prefix]) { if has(input.fields,path) {
            var next=unwrap(input.fields[path])
            if input.readonly_fields { next.writable=false
                next.readonly_children=true }
            out.fields[unwrap(strings.slice(path,len(input.prefix),len(path)))]=next } }
    }
    out.prefixes=prefix_index(out.fields)
    out.prefix=""
    out.readonly_fields=false
    return out
}
fn copied(input Value) Value {
    var out=input
    out.root=copy_view(input.root)
    if record(input.root.type_name) {
        let logical=materialized(input)
        out.fields=map[string]View{}
        out.prefixes=logical.prefixes
        out.prefix=""
        out.readonly_fields=false
        for path, item in logical.fields { var next=item
            if !input.root.writable { next.writable=false
                next.readonly_children=true }
            out.fields[path]=copy_view(next) }
    }
    return out
}
fn merge_view(p mut opool.Pool, a View, b View) View {
    if a==b { return a }
    var moid=a.oid
    if moid!=b.oid && b.oid!=0 {
        if moid==0 { moid=b.oid }
        else { moid=opool.merge_oid(p,moid,b.oid) }
    }
    return View{type_name:a.type_name,writable:a.writable && b.writable,readonly_children:a.readonly_children || b.readonly_children,deep_owned:a.deep_owned && b.deep_owned,record_copy:a.record_copy && b.record_copy,oid:moid}
}
fn field_fact(p mut opool.Pool, input Value, path string, type string) View {
    let full=input.prefix+path
    if has(input.fields,full) { var fact=unwrap(input.fields[full])
        if input.readonly_fields { fact.writable=false
            fact.readonly_children=true }
        return fact }
    var out=projected(p,input.root,path,type)
    if record(type) && input.root.record_copy { out=copy_view(out) }
    return out
}
fn merge(p mut opool.Pool, a Value, b Value) Value {
    let left=materialized(a)
    let right=materialized(b)
    var out=clone(left)
    if !has(out.prefixes,"@types") { out.prefixes=prefix_index(out.fields) }
    out.root=merge_view(p,a.root,b.root)
    var remaining=len(left.fields)
    for path, item in right.fields {
        if has(left.fields,path) { remaining-=1
            let previous=unwrap(left.fields[path])
            if previous!=item {
                let combined=merge_view(p,previous,item)
                out.fields[path]=combined
                if combined.type_name!=previous.type_name { note_type(out.prefixes,path,combined.type_name) }
            }
        } else {
            let combined=merge_view(p,projected(p,left.root,path,item.type_name),item)
            out.fields[path]=combined
            note_prefix(out.prefixes,path)
            note_type(out.prefixes,path,combined.type_name)
        }
    }
    if remaining>0 {
        for path, item in left.fields {
            if !has(right.fields,path) { out.fields[path]=merge_view(p,item,projected(p,b.root,path,item.type_name)) }
        }
    }
    for i in 0..len(out.positions) { if i<len(b.positions) { out.positions[i]=merge(p,out.positions[i],b.positions[i]) } }
    return out
}
fn select_root(p mut opool.Pool, input Value, path string, type string) Value {
    var out=value(type,false)
    out.root=field_fact(p,input,path,type)
    out.root.type_name=type
    if !input.root.writable { out.root.writable=false
        out.root.readonly_children=true }
    return out
}
fn select(p mut opool.Pool, input Value, path string, type string) Value {
    var out=select_root(p,input,path,type)
    let prefix=input.prefix+path
    if !has(input.prefixes,prefix) { return out }
    out.fields=input.fields
    out.prefixes=input.prefixes
    out.prefix=prefix
    out.readonly_fields=input.readonly_fields || !input.root.writable
    return out
}
fn attach(p mut opool.Pool, out mut Value, path string, input Value, copy bool) {
    if out.prefix!="" || out.readonly_fields {
        let logical=materialized(out)
        out.fields=clone(logical.fields)
        out.prefixes=clone(logical.prefixes)
        out.prefix=""
        out.readonly_fields=false
    }
    if !has(out.prefixes,"@types") { out.prefixes=prefix_index(out.fields) }
    var item=materialized(input)
    if copy { item=copied(item) }
    if depth_ok(path) {
        let ex0=has(out.fields,path)
        var st0=false
        if ex0 { st0=unwrap(out.fields[path]).type_name==item.root.type_name }
        var rv=item.root
        if rv.oid>=262144 && pure_scalar(rv.type_name) { rv.oid=rv.oid % 262144 }
        out.fields[path]=rv
        if !ex0 { note_prefix(out.prefixes,path)
            note_type(out.prefixes,path,rv.type_name) }
        else if !st0 { note_type(out.prefixes,path,rv.type_name) }
    }
    for name, fact in item.fields {
        let full=path+name
        if depth_ok(full) {
            let ex1=has(out.fields,full)
            var st1=false
            if ex1 { st1=unwrap(out.fields[full]).type_name==fact.type_name }
            var fv=fact
            if fv.oid>=262144 && pure_scalar(fv.type_name) { fv.oid=fv.oid % 262144 }
            out.fields[full]=fv
            if !ex1 { note_prefix(out.prefixes,full)
                note_type(out.prefixes,full,fv.type_name) }
            else if !st1 { note_type(out.prefixes,full,fv.type_name) }
        } else {
            var parent=unwrap_or(out.fields[path],item.root)
            if !parent.deep_owned { parent.readonly_children=true }
            out.fields[path]=parent
        }
    }
}
fn path_owner(path string) string { return strings.split(path,"#@")[0] }
fn path_tail(path string) string { return rules.cut(path,len(path_owner(path)),len(path)) }
fn value_path(p mut opool.Pool, values map[string]Value, path string) Value {
    let owner=path_owner(path)
    let root=unwrap_or(values[owner],value("",false))
    let suffix=path_tail(path)
    if suffix=="" { return root }
    return select(p,root,suffix,field_fact(p,root,suffix,"").type_name)
}
fn commit(e mut Environment, name string, input Value, keep_aliases bool) {
    if !keep_aliases && len(e.alias_cache)>0 { e.alias_cache=map[string][]string{} }
    e.next_version+=1
    e.values[name]=input
    e.versions[name]=e.next_version
}
fn store(e mut Environment, name string, input Value) { commit(e,name,input,false) }
fn begin_updates(e mut Environment) { e.updating=true }
fn end_updates(e mut Environment) {
    e.updating=false
    if len(e.edited_fields)>0 || len(e.edited_prefixes)>0 {
        e.edited_fields=map[string]map[string]View{}
        e.edited_prefixes=map[string]map[string]map[string]bool{} }
}
fn editable(e mut Environment, input Value, owner string) Value {
    var out=input
    if e.updating && has(e.edited_fields,owner) {
        out.fields=unwrap(e.edited_fields[owner])
        out.prefixes=unwrap(e.edited_prefixes[owner])
        out.prefix=""
        out.readonly_fields=false
        return out
    }
    out=clone(materialized(input))
    if e.updating { e.edited_fields[owner]=out.fields
        e.edited_prefixes[owner]=out.prefixes }
    return out
}
fn bump_alias_type(e mut Environment, typ string) {
    if has(e.alias_gen,typ) {
        e.alias_seq+=1
        e.alias_gen[typ]=e.alias_seq
    }
}
fn put(p mut opool.Pool, e mut Environment, path string, input Value, weak bool, copy bool) {
    let owner=path_owner(path)
    let suffix=path_tail(path)
    if owner=="" || !has(e.values,owner) { return }
    var root=materialized(unwrap(e.values[owner]))
    if !depth_ok(suffix) {
        root=editable(e,root,owner)
        let parts=strings.split(suffix,"#@")
        var prefix=""
        for i in 1..9 { prefix+="#@"+parts[i] }
        var ancestor=field_fact(p,root,prefix,"")
        ancestor.readonly_children=true
        ancestor.deep_owned=false
        root.fields[prefix]=ancestor
        note_prefix(root.prefixes,prefix)
        note_type(root.prefixes,prefix,ancestor.type_name)
        store(e,owner,root)
        if has(e.visible,owner) { e.writes[owner+"|"+prefix]=true }
        return
    }
    if suffix=="" {
        var next=input
        if copy { next=copied(input) }
        next.root.type_name=root.root.type_name
        if !rules.shared(next.root.type_name) { next.root.writable=root.root.writable }
        if next.root.oid>=262144 && pure_scalar(next.root.type_name) { next.root.oid=next.root.oid % 262144 }
        delete(e.edited_fields,owner)
        delete(e.edited_prefixes,owner)
        store(e,owner,next)
        if has(e.visible,owner) { e.writes[owner+"|"]=true
            for name, unused in materialized(next).fields { e.writes[owner+"|"+name]=true } }
        return
    }
    var item=materialized(input)
    if copy { item=copied(item) }
    if weak { item=merge(p,value_path(p,e.values,path),item) }
    if item.root.oid>=262144 && pure_scalar(item.root.type_name) { item.root.oid=item.root.oid % 262144 }
    let has_desc=has(root.prefixes,suffix)
    let leaf_only=!has_desc && len(item.fields)==0 && len(item.positions)==0
    if leaf_only && has(root.fields,suffix) && unwrap(root.fields[suffix])==item.root {
        if has(e.visible,owner) { e.writes[owner+"|"+suffix]=true }
        return
    }
    let check_gen=len(e.alias_cache)>0
    if check_gen {
        let nt=item.root.type_name
        if leaf_only {
            if has(root.fields,suffix) {
                let old_f=unwrap(root.fields[suffix])
                if old_f.type_name!=nt || old_f.oid!=item.root.oid {
                    bump_alias_type(e,old_f.type_name)
                    bump_alias_type(e,nt)
                }
            } else { bump_alias_type(e,nt) }
        } else {
            if has(root.fields,suffix) { bump_alias_type(e,unwrap(root.fields[suffix]).type_name) }
            bump_alias_type(e,nt)
            for unused, f in item.fields { bump_alias_type(e,f.type_name) }
        }
    }
    root=editable(e,root,owner)
    if has_desc {
        delete(root.fields,suffix)
        for name, unused in unwrap(root.prefixes[suffix]) {
            if check_gen && has(root.fields,name) { bump_alias_type(e,unwrap(root.fields[name]).type_name) }
            delete(root.fields,name)
        }
    }
    attach(p,root,suffix,item,false)
    commit(e,owner,root,true)
    if has(e.visible,owner) { e.writes[owner+"|"+suffix]=true
        for name, unused in item.fields { if depth_ok(suffix+name) { e.writes[owner+"|"+suffix+name]=true } } }
}
fn storage_aliases(p mut opool.Pool, e mut Environment, container View) Result<[]string> {
    var empty []string=[]
    if container.oid==0 { return ok(empty) }
    let is_shared=rules.shared(container.type_name)
    var identity=""
    if is_shared {
        let gen=unwrap_or(e.alias_gen[container.type_name],0)
        identity=str(gen)+":"+str(container.oid)+":"+container.type_name
        if has(e.alias_cache,identity) { return ok(unwrap(e.alias_cache[identity])) }
    }
    var found=list.from_slice(empty)
    let bucket_key="@type:"+container.type_name
    let c_oid=container.oid
    for owner, root in e.values {
        if root.root.oid!=0 && opool.same_storage(p,root.root.oid,c_oid) { list.append(found,owner)? }
        if has(root.prefixes,"@types") {
            if has(root.prefixes,bucket_key) { for full, unused in unwrap(root.prefixes[bucket_key]) {
                if root.prefix!="" && !strings.starts_with(full,root.prefix+"#@") { continue }
                if has(root.fields,full) { let field=unwrap(root.fields[full])
                    if field.type_name==container.type_name && field.oid!=0 && opool.same_storage(p,field.oid,c_oid) {
                        list.append(found,owner+rules.cut(full,len(root.prefix),len(full)))?
                    } } } }
        } else {
            if root.prefix=="" { for prefix, field in root.fields {
                if field.type_name==container.type_name && field.oid!=0 && opool.same_storage(p,field.oid,c_oid) { list.append(found,owner+prefix)? } }
            } else if has(root.prefixes,root.prefix) {
                for full, unused in unwrap(root.prefixes[root.prefix]) { if has(root.fields,full) {
                    let field=unwrap(root.fields[full])
                    if field.type_name==container.type_name && field.oid!=0 && opool.same_storage(p,field.oid,c_oid) {
                        list.append(found,owner+rules.cut(full,len(root.prefix),len(full)))?
                    } } }
            }
        }
    }
    let result=list.snapshot(found)
    if is_shared {
        if !has(e.alias_gen,container.type_name) { e.alias_gen[container.type_name]=0 }
        e.alias_cache[identity]=result
    }
    return ok(result)
}
fn assign(p mut opool.Pool, e mut Environment, ops []NodeOp, left_idx int, input Value) Result<void> {
    let left=ops[left_idx]
    let path=left.proj
    if path=="" { return ok() }
    if left.kind!=3 { put(p,e,path,input,false,true)
        return ok() }
    let container=value_path(p,e.values,ops[left.children[0]].proj)
    let destinations=storage_aliases(p,e,container.root)?
    for destination in destinations { put(p,e,destination+"#@[]",input,true,true) }
    return ok()
}
fn require_write(s mut State, p opool.Pool, e mut Environment, line int, col int, fact View) Result<void> {
    if !fact.writable { denied(s,e,line,col,"read-only member/view")? }
    if !fact.record_copy && fact.oid!=0 {
        let poid=fact.oid % 262144
        if poid!=0 {
            if poid>=131072 {
                let aid=(poid-131072) // 2
                let ro=(poid % 2)==1
                e.required[aid]=ro || unwrap_or(e.required[aid],false)
            } else {
                for aid, ro in opool.param_map(p,poid) { e.required[aid]=ro || unwrap_or(e.required[aid],false) }
            }
        }
    }
    return ok()
}
fn bind(p mut opool.Pool, e mut Environment, name string, input Value, mutable bool) {
    if name=="" { return }
    var next=copied(input)
    next.root.writable=mutable && (!rules.shared(next.root.type_name) || input.root.writable)
    if next.root.oid>=262144 && pure_scalar(next.root.type_name) { next.root.oid=next.root.oid % 262144 }
    store(e,name,next)
}
fn instantiate_view_at(p mut opool.Pool, site_id int, src View, actual map[string]Value) View {
    let oid=src.oid
    if oid==0 { return src }
    let scalar=pure_scalar(src.type_name)
    let poid=oid % 262144
    var acc=0
    if oid>=262144 && !scalar { acc=opool.retag_local_oid(p,site_id,oid,false) }
    if poid==0 {
        var out=src
        out.oid=acc
        return out
    }
    var out=src
    if poid>=131072 {
        let aid=(poid-131072) // 2
        let readonly=(poid % 2)==1
        let owner=opool.param_owner(p,aid)
        let path=opool.param_path(p,aid)
        if has(actual,owner) {
            let root=unwrap(actual[owner])
            var fact=root.root
            if path!="" {
                fact=field_fact(p,root,path,src.type_name)
                if !has(root.fields,root.prefix+path) && !root.root.deep_owned { fact.writable=false
                    fact.readonly_children=true }
                if !root.root.writable { fact.writable=false
                    fact.readonly_children=true }
            }
            if !src.record_copy {
                out.writable=out.writable && fact.writable && !readonly
                out.readonly_children=out.readonly_children || fact.readonly_children || readonly
            }
            var foid=fact.oid
            if foid!=0 {
                var fp=foid % 262144
                if readonly && fp!=0 { fp=opool.mark_ro_param(p,fp) }
                if scalar { foid=fp }
                else { foid=fp+(foid // 262144)*262144 }
                if foid!=0 {
                    if acc==0 { acc=foid }
                    else if acc!=foid { acc=opool.merge_oid(p,acc,foid) }
                }
            }
        } else {
            if acc==0 { acc=poid }
            else if acc!=poid { acc=opool.merge_oid(p,acc,poid) }
        }
        out.oid=acc
        return out
    }
    for aid, readonly in opool.param_map(p,poid) {
        let owner=opool.param_owner(p,aid)
        let path=opool.param_path(p,aid)
        if has(actual,owner) {
            let root=unwrap(actual[owner])
            var fact=root.root
            if path!="" {
                fact=field_fact(p,root,path,src.type_name)
                if !has(root.fields,root.prefix+path) && !root.root.deep_owned { fact.writable=false
                    fact.readonly_children=true }
                if !root.root.writable { fact.writable=false
                    fact.readonly_children=true }
            }
            if !src.record_copy {
                out.writable=out.writable && fact.writable && !readonly
                out.readonly_children=out.readonly_children || fact.readonly_children || readonly
            }
            var foid=fact.oid
            if foid!=0 {
                var fp=foid % 262144
                if readonly && fp!=0 { fp=opool.mark_ro_param(p,fp) }
                if scalar { foid=fp }
                else { foid=fp+(foid // 262144)*262144 }
                if foid!=0 {
                    if acc==0 { acc=foid }
                    else if acc!=foid { acc=opool.merge_oid(p,acc,foid) }
                }
            }
        } else {
            let sp=opool.single_param_aid(p,aid,readonly)
            if acc==0 { acc=sp }
            else if acc!=sp { acc=opool.merge_oid(p,acc,sp) }
        }
    }
    out.oid=acc
    return out
}
fn instantiate_at(p mut opool.Pool, site_id int, source Value, actual map[string]Value, demand string) Value {
    if demand=="!" {
        var out=Value{root:instantiate_view_at(p,site_id,source.root,actual),fields:map[string]View{},prefixes:map[string]map[string]bool{},prefix:"",readonly_fields:false,positions:clone(source.positions)}
        for i in 0..len(source.positions) { out.positions[i]=instantiate_at(p,site_id,source.positions[i],actual,"!") }
        return out
    }
    let logical=materialized(source)
    if demand=="" {
        var out=Value{root:instantiate_view_at(p,site_id,source.root,actual),fields:map[string]View{},prefixes:clone(logical.prefixes),prefix:"",readonly_fields:false,positions:clone(source.positions)}
        for path, fact in logical.fields { out.fields[path]=instantiate_view_at(p,site_id,fact,actual) }
        for i in 0..len(source.positions) { out.positions[i]=instantiate_at(p,site_id,source.positions[i],actual,"") }
        return out
    }
    var out=Value{root:instantiate_view_at(p,site_id,source.root,actual),fields:map[string]View{},prefixes:map[string]map[string]bool{"@types":map[string]bool{}},prefix:"",readonly_fields:false,positions:clone(source.positions)}
    if has(logical.fields,demand) {
        let f0=instantiate_view_at(p,site_id,unwrap(logical.fields[demand]),actual)
        out.fields[demand]=f0
        note_prefix(out.prefixes,demand)
        note_type(out.prefixes,demand,f0.type_name)
    }
    if has(logical.prefixes,demand) {
        for pth, unused in unwrap(logical.prefixes[demand]) {
            if has(logical.fields,pth) {
                let fp=instantiate_view_at(p,site_id,unwrap(logical.fields[pth]),actual)
                out.fields[pth]=fp
                note_prefix(out.prefixes,pth)
                note_type(out.prefixes,pth,fp.type_name)
            }
        }
    }
    for i in 0..len(source.positions) { out.positions[i]=instantiate_at(p,site_id,source.positions[i],actual,demand) }
    return out
}
fn empty_compiled_writes() []CompiledWrite { var x []CompiledWrite=[]
    return x }
fn empty_compiled_reqs() []CompiledReq { var x []CompiledReq=[]
    return x }
fn invoke(s mut State, p mut opool.Pool, e mut Environment, ops []NodeOp, n NodeOp, f Function, args []Value, demand string) Result<Value> {
    if s.probing && e.function!="" {
        if !has(e.callees,f.target) { e.callees[f.target]=true }
        if demand!="!" && !has(e.sub_ret_fields,f.target) { e.sub_ret_fields[f.target]=true }
    }
    if len(args)!=len(f.parameters) { return ok(value(f.result,false)) }
    for i in 0..len(args) { if !rules.compatible(f.parameters[i].type_name,args[i].root.type_name) { return ok(value(f.result,false)) } }
    for i in 0..len(f.parameters) {
        if f.parameters[i].writable && !args[i].root.writable {
            let arg_n=ops[n.children[i+1]]
            denied(s,e,arg_n.line,arg_n.col,"mut borrow requires writable argument")?
        }
    }
    if !has(s.summaries,f.target) && !rules.lexical_target(f.target) { return ok(value(f.result,true)) }
    var selected=s.summaries[f.target]
    if is_none(selected) {
        selected=Summary{returned:value(f.result,false),unknown:true,saw_return:false,pure_fast:false,writes:map[string]View{},compiled_writes:empty_compiled_writes(),required:map[int]bool{},compiled_reqs:empty_compiled_reqs()}
    }
    let summary=unwrap(selected)
    if summary.pure_fast {
        var res=summary.returned
        res.root.type_name=f.result
        return ok(res)
    }
    var actual=map[string]Value{}
    for owner, unused in s.global_symbols { if has(e.values,owner) { actual[owner]=unwrap(e.values[owner]) } }
    for i in 0..len(f.parameters) { actual[f.parameters[i].target]=args[i] }
    if summary.unknown {
        for owner, input in e.values { if has(s.global_symbols,owner) || has(e.visible,owner) {
            var conservative=conservative_value(input)
            if record(input.root.type_name) { conservative.root.writable=input.root.writable }
            else if !has(s.global_symbols,owner) { conservative.root.writable=input.root.writable }
            store(e,owner,conservative)
        } }
        for i in 0..len(f.parameters) { if f.parameters[i].writable && i+1<len(n.children) {
            let path=ops[n.children[i+1]].proj
            if path!="" { let input=value_path(p,e.values,path)
                var conservative=conservative_value(input)
                conservative.root.writable=input.root.writable
                put(p,e,path,conservative,false,false)
            }
        } }
    }
    for req in summary.compiled_reqs {
        if has(actual,req.owner) {
            let root=unwrap(actual[req.owner])
            var fact=root.root
            if req.path!="" { fact=field_fact(p,root,req.path,"") }
            if req.readonly || !fact.writable { denied(s,e,n.line,n.col,"callee writes through a read-only member/view")? }
            if !fact.record_copy && fact.oid!=0 {
                let poid=fact.oid % 262144
                if poid!=0 {
                    if poid>=131072 {
                        let aid=(poid-131072) // 2
                        let ro=(poid % 2)==1
                        e.required[aid]=ro || unwrap_or(e.required[aid],false)
                    } else {
                        for aid, ro in opool.param_map(p,poid) { e.required[aid]=ro || unwrap_or(e.required[aid],false) }
                    }
                }
            }
        }
    }
    let site_id=opool.site_id(p,e.function+"!"+n.node_key)
    if len(summary.compiled_writes)>0 { begin_updates(e) }
    var write_arguments=map[string]WriteArgument{}
    var batch_aliases=map[string][]string{}
    var batch_ctype=map[string]string{}
    var batch_cgen=map[string]int{}
    for cw in summary.compiled_writes {
        if !has(write_arguments,cw.owner) {
            var argument=WriteArgument{destination:cw.owner,parameter:false,writable:false}
            for i in 0..len(f.parameters) { if f.parameters[i].target==cw.owner {
                argument.parameter=true
                argument.writable=f.parameters[i].writable
                if i+1<len(n.children) { argument.destination=ops[n.children[i+1]].proj } } }
            write_arguments[cw.owner]=argument
        }
        let argument=unwrap(write_arguments[cw.owner])
        let destination=argument.destination
        let parameter=argument.parameter
        let mutable=argument.writable
        if parameter && !mutable { continue }
        if (destination=="" && (!parameter || !cw.has_elem)) || (e.deferred && parameter && record(unwrap(actual[cw.owner]).root.type_name) && !cw.has_elem) { continue }
        var changed=value(cw.fact.type_name,false)
        changed.root=instantiate_view_at(p,site_id,cw.fact,actual)
        if cw.suffix=="" {
            put(p,e,destination,changed,false,false)
            if len(batch_aliases)>0 { batch_aliases=map[string][]string{} }
        } else {
            let path=destination+cw.suffix
            if destination!="" { put(p,e,path,changed,e.deferred,false) }
            if cw.has_elem {
                let self_target=destination+cw.elem_ancestor
                var aliases []string=[]
                var hit=false
                if destination!="" && has(batch_aliases,self_target) {
                    let ct=unwrap(batch_ctype[self_target])
                    if unwrap_or(e.alias_gen[ct],0)==unwrap(batch_cgen[self_target]) && len(e.alias_cache)>0 {
                        aliases=unwrap(batch_aliases[self_target])
                        hit=true
                    }
                }
                if !hit {
                    var container=value_path(p,e.values,self_target)
                    if destination=="" && parameter {
                        container=unwrap(actual[cw.owner])
                        if cw.elem_ancestor!="" { container=select(p,container,cw.elem_ancestor,"") }
                    }
                    aliases=storage_aliases(p,e,container.root)?
                    if destination!="" && rules.shared(container.root.type_name) {
                        batch_aliases[self_target]=aliases
                        batch_ctype[self_target]=container.root.type_name
                        batch_cgen[self_target]=unwrap_or(e.alias_gen[container.root.type_name],0)
                    }
                }
                let skip_self=destination!="" && !e.deferred && !record(changed.root.type_name)
                for alias in aliases {
                    if skip_self && alias==self_target { continue }
                    put(p,e,alias+cw.elem_suffix,changed,true,true)
                }
            }
        }
    }
    if len(summary.compiled_writes)>0 { end_updates(e) }
    var result=instantiate_at(p,site_id,summary.returned,actual,demand)
    result.root.type_name=f.result
    return ok(result)
}
fn expression(s mut State, p mut opool.Pool, e mut Environment, ops []NodeOp, idx int, demand string) Result<Value> {
    let n=ops[idx]
    tick(s,n.line,n.col)?
    let result=expression_body(s,p,e,ops,n,demand)?
    s.facts[n.node_key]=node_fact(result)
    return ok(result)
}
fn expression_body(s mut State, p mut opool.Pool, e mut Environment, ops []NodeOp, n NodeOp, demand string) Result<Value> {
    let k=n.kind
    if k==1 || (k==2 && n.ref_target!="") { let name=n.ref_target
        if has(s.functions,name) { return ok(value("fn:"+name,false)) }
        if has(s.variants,name) { return ok(value("variant:"+name,false)) }
        if strings.starts_with(name,"builtin:") { return ok(value(name,false)) }
        return ok(unwrap_or(e.values[name],value("",false))) }
    if k==5 {
        let callee=expression(s,p,e,ops,n.children[0],"!")?
        let name=callee.root.type_name
        var arg_demand=""
        if name=="builtin:core:unwrap" || name=="builtin:core:unwrap_err" || name=="builtin:core:unwrap_or" { arg_demand=demand }
        var empty []Value=[]
        var items=list.from_slice(empty)
        for i in 1..len(n.children) { list.append(items,expression(s,p,e,ops,n.children[i],arg_demand)?)? }
        let args=list.snapshot(items)
        if strings.starts_with(name,"fn:") { let fn_name=rules.cut(name,3,len(name))
            if has(s.functions,fn_name) {
                let f=unwrap(s.functions[fn_name])
                if f.asynchronous { return ok(value("Task<"+f.result+">",false)) }
                return invoke(s,p,e,ops,n,f,args,demand)
            } }
        if strings.starts_with(name,"variant:") { let variant=rules.cut(name,8,len(name))
            return ok(seeded(s,p,unwrap(s.variants[variant]),true,e.function+"!"+n.node_key)) }
        if len(args)>0 && (name=="builtin:core:unwrap" || name=="builtin:core:unwrap_or" || name=="builtin:core:ok" || name=="builtin:core:err" || name=="builtin:core:clone" || name=="builtin:core:unwrap_err") {
            var out=args[0]
            if name=="builtin:core:clone" {
                out=seeded(s,p,args[0].root.type_name,true,e.function+"!"+n.node_key)
                out.root.deep_owned=true
                out.fields=field_defaults(s,p,out.root,0)
                for path, fact in out.fields { var next=fact
                    next.writable=true
                    next.readonly_children=false
                    next.deep_owned=true
                    out.fields[path]=next }
            } else if name=="builtin:core:ok" || name=="builtin:core:err" {
                let payload=out.root.type_name
                if payload!="nil" && payload!="void" && !rules.shared(payload) && !record(payload) { out.root.writable=true }
                if name=="builtin:core:ok" { out.root.type_name="Result<"+payload+",>" }
                else { out.root.type_name="Result<,"+payload+">" }
            } else {
                let ts=rules.arguments(out.root.type_name,"Result")
                if len(ts)==2 { var side=0
                    if name=="builtin:core:unwrap_err" { side=1 }
                    out.root.type_name=ts[side] }
                else { out.root.type_name=rules.optional(out.root.type_name) }
                if name=="builtin:core:unwrap_or" && len(args)==2 { out=merge(p,out,args[1]) }
            }
            return ok(out) }
        if has(s.std_sigs,name) { let sig=unwrap(s.std_sigs[name])
            if sig.mutates && len(args)>0 { require_write(s,p,e,n.line,n.col,args[0].root)? }
            if name=="builtin:std.list#from_slice" && len(args)>0 { var out=args[0]
                out.root.type_name="List<"+child_type(args[0].root.type_name)+">"
                out.root.writable=true
                out.root.oid=opool.make_seed(p,e.function+"!"+n.node_key,true,false)
                return ok(out) }
            if name=="builtin:std.list#get" && len(args)>0 { var out=select(p,args[0],"#@[]",child_type(args[0].root.type_name))
                out.root.writable=false
                out.root.readonly_children=true
                out.root.type_name="Result<"+out.root.type_name+",string>"
                return ok(out) }
            if name=="builtin:std.list#snapshot" && len(args)>0 && child_type(args[0].root.type_name)!="" {
                return ok(seeded(s,p,"[]"+child_type(args[0].root.type_name),false,e.function+"!"+n.node_key)) }
            return ok(seeded(s,p,sig.result,sig.writable,e.function+"!"+n.node_key)) }
        if name=="builtin:core:delete" && len(args)>0 { require_write(s,p,e,n.line,n.col,args[0].root)? }
        if name=="builtin:core:task_group_begin" { return ok(value("int",false)) }
        if name=="builtin:core:task_group_end" { return ok(value("void",false)) }
        if len(args)>0 && (name=="builtin:std.task#all" || name=="builtin:std.task#race" || name=="builtin:std.task#timeout") {
            let type=args[0].root.type_name
            let task=rules.arguments(type,"Task")
            if len(task)!=1 { return ok(value("",false)) }
            if name=="builtin:std.task#all" { return ok(value("Task<[]"+task[0]+">",false)) }
            if name=="builtin:std.task#timeout" { return ok(seeded(s,p,"Result<"+task[0]+",string>",true,e.function+"!"+n.node_key)) }
            return ok(value(type,false)) }
        if strings.starts_with(name,"builtin:core:") { return ok(value("",false)) }
        for owner, input in e.values { if rules.shared(input.root.type_name) || record(input.root.type_name) {
            var out=clone(materialized(input))
            out.root.readonly_children=true
            out.root.deep_owned=false
            for path, fact in out.fields { var next=fact
                next.writable=false
                next.readonly_children=true
                out.fields[path]=next }
            store(e,owner,out) } }
        return ok(value("",false)) }
    if k==2 || k==3 || k==4 {
        var path="#@"+n.text
        var base_demand=""
        if k==2 {
            if demand=="" || demand=="!" { base_demand=path }
            else { base_demand=path+demand }
        }
        let base=expression(s,p,e,ops,n.children[0],base_demand)?
        var typ=unwrap_or(s.fields[rules.optional(base.root.type_name)+"#"+n.text],"")
        if k!=2 { path="#@[]"
            typ=child_type(base.root.type_name)
            for i in 1..len(n.children) { if ops[n.children[i]].kind!=19 { expression(s,p,e,ops,n.children[i],"!")? } } }
        if k==4 { var out=base
            out.root.type_name="[]"+typ
            return ok(out) }
        var out=select(p,base,path,typ)
        if k==3 { out.root.record_copy=false }
        if k==3 && len(rules.arguments(base.root.type_name,"map"))==2 { out.root.type_name=typ+"?" }
        return ok(out) }
    if k==14 { return ok(value("int",false)) }
    if k==15 { return ok(value("string",false)) }
    if k==17 { return ok(value("bool",false)) }
    if k==16 { return ok(value("float",false)) }
    if k==18 { return ok(value("nil",false)) }
    if k==12 || k==13 { let left_idx=n.children[0]
        let left=ops[left_idx]
        if left.kind!=1 {
            expression(s,p,e,ops,left_idx,"!")?
            let base=unwrap(s.facts[ops[left.children[0]].node_key])
            require_write(s,p,e,left.line,left.col,base.root)?
        }
        if k==12 {
            let right=expression(s,p,e,ops,n.children[1],"")?
            if n.text=="=" { assign(p,e,ops,left_idx,right)? }
        }
        return ok(value("",false)) }
    if k==11 { var out=expression(s,p,e,ops,n.children[0],demand)?
        let ts=rules.arguments(out.root.type_name,"Result")
        if len(ts)==2 { out.root.type_name=ts[0] }
        return ok(out) }
    if k==6 {
        var out=value(n.ref_target,true)
        out.root.oid=opool.make_seed(p,e.function+"!"+n.node_key,true,false)
        for child in n.children { let field=ops[child]
            let name=field.text
            var item=expression(s,p,e,ops,field.children[0],"")?
            item.root.type_name=unwrap_or(s.fields[out.root.type_name+"#"+name],item.root.type_name)
            attach(p,out,"#@"+name,item,true) }
        return ok(out) }
    if k==7 || k==8 || k==9 {
        var out=value("",true)
        out.root.oid=opool.make_seed(p,e.function+"!"+n.node_key,true,false)
        var seen=false
        var element=value("",false)
        var empty []Value=[]
        var positions=list.from_slice(empty)
        var types []string=[]
        var type_names=list.from_slice(types)
        var offset=0
        if k==8 { offset=1 }
        for i in offset..len(n.children) { var cidx=n.children[i]
            if k==8 { let entry=ops[cidx]
                expression(s,p,e,ops,entry.children[0],"!")?
                cidx=entry.children[1] }
            let item=expression(s,p,e,ops,cidx,"")?
            if k==9 { list.append(positions,item)?
                list.append(type_names,item.root.type_name)? }
            else { let next=copied(item)
                if seen { element=merge(p,element,next) }
                else { element=next
                    seen=true } } }
        if k==9 { out.positions=list.snapshot(positions)
            out.root.type_name="multi<"+strings.join(list.snapshot(type_names),",")+">"
            return ok(out) }
        out.root.type_name="[]"+element.root.type_name
        if k==8 { out.root.type_name=type_name(ops,n.children[0]) }
        if seen { attach(p,out,"#@[]",element,false) }
        else if k==8 { out.fields=field_defaults(s,p,out.root,0)
            out.prefixes=prefix_index(out.fields) }
        return ok(out) }
    if k==10 && n.text=="spawn" {
        let call=ops[n.children[0]]
        let callee=expression(s,p,e,ops,call.children[0],"!")?
        for i in 1..len(call.children) { expression(s,p,e,ops,call.children[i],"!")? }
        let name=callee.root.type_name
        if strings.starts_with(name,"fn:") {
            let target=rules.cut(name,3,len(name))
            if has(s.functions,target) {
                let f=unwrap(s.functions[target])
                return ok(value("Task<"+f.result+">",false))
            }
        }
        return ok(value("",false)) }
    if k==10 && n.text=="await" {
        let operand=expression(s,p,e,ops,n.children[0],"!")?
        let task=rules.arguments(operand.root.type_name,"Task")
        if len(task)==1 {
            if !rules.shared(task[0]) && !record(task[0]) { return ok(value(task[0],true)) }
            var result=seeded(s,p,task[0],true,e.function+"!"+n.node_key)
            result.root.deep_owned=true
            return ok(result)
        }
        return ok(value("",false)) }
    for child in n.children { expression(s,p,e,ops,child,"!")? }
    return ok(value("",false))
}
fn type_name(ops []NodeOp, idx int) string {
    let n=ops[idx]
    let k=n.kind
    if k==40 { let name=n.ref_target
        if strings.starts_with(name,"builtin:type:") { return n.text }
        return name }
    if k==41 { return type_name(ops,n.children[0]) }
    if k==42 { return type_name(ops,n.children[0])+"?" }
    if k==43 { return "[]"+type_name(ops,n.children[0]) }
    if k==44 { return "["+n.text+"]"+type_name(ops,n.children[0]) }
    var empty []string=[]
    var names=list.from_slice(empty)
    for child in n.children { unwrap(list.append(names,type_name(ops,child))) }
    if n.text=="Result" && len(n.children)==1 { unwrap(list.append(names,"string")) }
    return n.text+"<"+strings.join(list.snapshot(names),",")+">"
}
fn snapshot(values map[string]Value) map[string]Value {
    var out=map[string]Value{}
    for name, input in values { out[name]=input }
    return out
}
fn same_value(a Value, b Value) bool {
    if a.root!=b.root || len(a.positions)!=len(b.positions) { return false }
    var equal=false
    if a.prefix==b.prefix && a.readonly_fields==b.readonly_fields {
        equal=a.fields==b.fields
        if !equal && a.prefix=="" && !a.readonly_fields { return false }
    }
    if !equal {
        let left=materialized(a)
        let right=materialized(b)
        if left.fields!=right.fields { return false }
    }
    for i in 0..len(a.positions) { if !same_value(a.positions[i],b.positions[i]) { return false } }
    return true
}
fn join(p mut opool.Pool, e mut Environment, other map[string]Value, versions map[string]int) {
    for name, input in e.values {
        if has(other,name) && unwrap_or(e.versions[name],0)!=unwrap_or(versions[name],0) {
            let previous=unwrap(other[name])
            if !same_value(input,previous) { store(e,name,merge(p,input,previous)) }
        }
    }
}
fn capture(p mut opool.Pool, e mut Environment, input Value) {
    let next=copied(input)
    if e.saw_return { e.returned=merge(p,e.returned,next) }
    else { e.returned=next
        e.saw_return=true }
}
fn statement(s mut State, p mut opool.Pool, e mut Environment, ops []NodeOp, idx int) Result<void> {
    let n=ops[idx]
    tick(s,n.line,n.col)?
    let k=n.kind
    if k==20 { for child in n.children { statement(s,p,e,ops,child)? }
        return ok() }
    if k==32 { expression(s,p,e,ops,n.children[0],"!")?
        return ok() }
    if k==21 || k==22 || k==23 {
        var input=expression(s,p,e,ops,n.children[len(n.children)-1],"")?
        if len(n.children)==2 { input.root.type_name=type_name(ops,n.children[0]) }
        bind(p,e,n.decl_target,input,k==22)
        return ok() }
    if k==27 {
        expression(s,p,e,ops,n.children[0],"!")?
        let before=snapshot(e.values)
        let before_versions=clone(e.versions)
        statement(s,p,e,ops,n.children[1])?
        let yes=snapshot(e.values)
        let yes_versions=clone(e.versions)
        e.values=snapshot(before)
        e.alias_cache=map[string][]string{}
        e.versions=clone(before_versions)
        if len(n.children)==3 { statement(s,p,e,ops,n.children[2])? }
        join(p,e,yes,yes_versions)
        return ok() }
    if k==26 {
        var empty []Value=[]
        var values=list.from_slice(empty)
        for child in n.children { list.append(values,expression(s,p,e,ops,child,"")?)? }
        let items=list.snapshot(values)
        if len(items)==1 { capture(p,e,items[0]) }
        else { var out=value("",false)
            out.positions=items
            capture(p,e,out) }
        var snap=map[string]Value{}
        for owner, input in e.values { if has(e.visible,owner) { snap[owner]=input } }
        var exits=list.from_slice(e.exits)
        list.append(exits,snap)?
        e.exits=list.snapshot(exits)
        return ok() }
    if k==28 || k==29 {
        let before=snapshot(e.values)
        let before_versions=clone(e.versions)
        var count=0
        if k==28 { expression(s,p,e,ops,n.children[0],"!")? }
        else { count=len(n.children)-2
            let input=expression(s,p,e,ops,n.children[count],"")?
            let m=rules.arguments(input.root.type_name,"map")
            var key_type="int"
            var item_type=child_type(input.root.type_name)
            if len(m)==2 { key_type=m[0]
                if count==1 { item_type=key_type } }
            for i in 0..count { let name=ops[n.children[i]].decl_target
                var typ=item_type
                if count==2 && i==0 { typ=key_type }
                if name!="" { store(e,name,value(typ,false)) } } }
        var changed=true
        var passes=0
        while changed && passes<32 {
            passes+=1
            let previous=snapshot(e.values)
            let previous_versions=clone(e.versions)
            statement(s,p,e,ops,n.children[len(n.children)-1])?
            join(p,e,before,before_versions)
            join(p,e,previous,previous_versions)
            changed=false
            for owner, input in previous {
                if has(e.values,owner) && unwrap_or(previous_versions[owner],0)!=unwrap_or(e.versions[owner],0) && !same_value(input,unwrap(e.values[owner])) { changed=true }
            }
        }
        if changed {
            for owner, input in e.values {
                var conservative=clone(materialized(input))
                conservative.root.readonly_children=true
                conservative.root.deep_owned=false
                for path, fact in conservative.fields { var item=fact
                    item.writable=false
                    item.readonly_children=true
                    conservative.fields[path]=item }
                store(e,owner,conservative)
            }
        }
        return ok() }
    if k==34 { return ok() }
    if k==33 {
        let name=n.decl_target
        if !rules.lexical_target(name) { return ok() }
        let f=unwrap(s.functions[name])
        var captures=map[string]Value{}
        for owner, input in e.values {
            if rules.lexical_target(owner) { captures[owner]=conservative_value(input) }
            else { captures[owner]=input }
        }
        var inner=environment(e.unit_id,e.function,captures)
        for prm in f.parameters { store(inner,prm.target,parameter_seeded(s,p,prm.type_name,prm.writable,prm.target)) }
        statement(s,p,inner,ops,n.children[1])?
        for target, unused in inner.callees { e.callees[target]=true }
        for target, unused in inner.sub_ret_fields { e.sub_ret_fields[target]=true }
        return ok()
    }
    if k==24 || k==25 {
        let names=ops[n.children[0]]
        let input=expression(s,p,e,ops,n.children[1],"")?
        let ts=rules.arguments(input.root.type_name,"multi")
        for i in 0..len(names.children) { let item_idx=names.children[i]
            var next=value("",false)
            if i<len(input.positions) { next=input.positions[i] }
            else if i<len(ts) { next.root.type_name=ts[i] }
            if k==24 { bind(p,e,ops[item_idx].decl_target,next,n.text=="var") }
            else { assign(p,e,ops,item_idx,next)? } }
        return ok() }
    if k==30 {
        expression(s,p,e,ops,n.children[0],"!")?
        let before=snapshot(e.values)
        let before_versions=clone(e.versions)
        var merged=snapshot(before)
        var merged_versions=clone(before_versions)
        for i in 1..len(n.children) {
            e.values=snapshot(before)
            e.alias_cache=map[string][]string{}
            e.versions=clone(before_versions)
            let arm=ops[n.children[i]]
            statement(s,p,e,ops,arm.children[2])?
            join(p,e,merged,merged_versions)
            merged=snapshot(e.values)
            merged_versions=clone(e.versions)
        }
        e.values=merged
        e.alias_cache=map[string][]string{}
        e.versions=merged_versions
        return ok() }
    if k==31 { e.deferred=true
        expression(s,p,e,ops,n.children[0],"!")?
        e.deferred=false
        return ok() }
    return ok()
}
fn environment(unit_id string, function string, values map[string]Value) Environment {
    var visible=map[string]bool{}
    for owner, unused in values { visible[owner]=true }
    return Environment{unit_id:unit_id,function:function,values:snapshot(values),versions:map[string]int{},next_version:0,updating:false,edited_fields:map[string]map[string]View{},edited_prefixes:map[string]map[string]map[string]bool{},alias_cache:map[string][]string{},alias_gen:map[string]int{},alias_seq:0,returned:value("",false),saw_return:false,writes:map[string]bool{},visible:visible,required:map[int]bool{},callees:map[string]bool{},sub_ret_fields:map[string]bool{},exits:[],deferred:false}
}
fn canon_value(p mut opool.Pool, input Value) Value {
    let logical=materialized(input)
    var out=Value{root:logical.root,fields:map[string]View{},prefixes:logical.prefixes,prefix:"",readonly_fields:false,positions:clone(logical.positions)}
    out.root.oid=opool.canon_oid(p,out.root.oid,pure_scalar(out.root.type_name))
    for path, fact in logical.fields {
        var cf=fact
        cf.oid=opool.canon_oid(p,cf.oid,pure_scalar(cf.type_name))
        out.fields[path]=cf
    }
    for i in 0..len(out.positions) { out.positions[i]=canon_value(p,out.positions[i]) }
    return out
}
fn summary(p mut opool.Pool, e Environment) Summary {
    var writes=map[string]View{}
    var cws=list.from_slice(empty_compiled_writes())
    for origin, unused in e.writes {
        let parts=split_origin(origin)
        let owner=parts[0]
        let suffix=parts[1]
        var fact=value_path(p,e.values,owner+suffix).root
        for exit in e.exits { if has(exit,owner) { fact=merge_view(p,fact,value_path(p,exit,owner+suffix).root) } }
        fact.oid=opool.canon_oid(p,fact.oid,pure_scalar(fact.type_name))
        writes[origin]=fact
        let has_elem=strings.contains(suffix,"#@[]")
        var elem_ancestor=""
        var elem_suffix=""
        if has_elem {
            let start=strings.index(suffix,"#@[]")
            elem_ancestor=rules.cut(suffix,0,start)
            elem_suffix=rules.cut(suffix,start,len(suffix))
        }
        unwrap(list.append(cws,CompiledWrite{owner:owner,suffix:suffix,has_elem:has_elem,elem_ancestor:elem_ancestor,elem_suffix:elem_suffix,fact:fact}))
    }
    var crs=list.from_slice(empty_compiled_reqs())
    for aid, ro in e.required {
        unwrap(list.append(crs,CompiledReq{owner:opool.param_owner(p,aid),path:opool.param_path(p,aid),readonly:ro}))
    }
    let ret=canon_value(p,e.returned)
    let cws_snap=list.snapshot(cws)
    let crs_snap=list.snapshot(crs)
    let pf=len(cws_snap)==0 && len(crs_snap)==0 && ret.root.oid==0 && len(ret.fields)==0 && len(ret.positions)==0
    return Summary{returned:ret,unknown:false,saw_return:e.saw_return,pure_fast:pf,writes:writes,compiled_writes:cws_snap,required:e.required,compiled_reqs:crs_snap}
}
fn conservative_value(input Value) Value {
    var out=clone(materialized(input))
    out.root.writable=false
    out.root.readonly_children=true
    out.root.deep_owned=false
    for path, fact in out.fields { var readonly=fact
        readonly.writable=false
        readonly.readonly_children=true
        readonly.deep_owned=false
        out.fields[path]=readonly }
    for i in 0..len(out.positions) { out.positions[i]=conservative_value(out.positions[i]) }
    return out
}
fn record_dependencies(s mut State, e Environment) {
    for target, unused in e.callees {
        var callers=map[string]bool{}
        if has(s.dependents,target) { callers=unwrap(s.dependents[target]) }
        if !has(callers,e.function) { callers=clone(callers)
            callers[e.function]=true
            s.dependents[target]=callers }
    }
}
fn record_field_subscriptions(s mut State, e Environment) {
    for target, unused in e.sub_ret_fields {
        var subs=map[string]bool{}
        if has(s.sub_ret_fields,target) { subs=unwrap(s.sub_ret_fields[target]) }
        if !has(subs,e.function) { subs=clone(subs)
            subs[e.function]=true
            s.sub_ret_fields[target]=subs }
    }
}
fn kind_code(k string) int {
    if k=="Name" { return 1 }
    if k=="Member" { return 2 }
    if k=="Index" { return 3 }
    if k=="Slice" { return 4 }
    if k=="Call" { return 5 }
    if k=="StructLiteral" { return 6 }
    if k=="Array" { return 7 }
    if k=="MapLiteral" { return 8 }
    if k=="Pack" { return 9 }
    if k=="Unary" { return 10 }
    if k=="Propagate" { return 11 }
    if k=="Assignment" { return 12 }
    if k=="Update" { return 13 }
    if k=="Integer" { return 14 }
    if k=="String" { return 15 }
    if k=="Float" { return 16 }
    if k=="Boolean" { return 17 }
    if k=="Nil" { return 18 }
    if k=="Omitted" { return 19 }
    if k=="Block" || k=="Program" { return 20 }
    if k=="Let" { return 21 }
    if k=="Var" { return 22 }
    if k=="Const" { return 23 }
    if k=="MultiBinding" { return 24 }
    if k=="MultiAssignment" { return 25 }
    if k=="Return" { return 26 }
    if k=="If" { return 27 }
    if k=="While" { return 28 }
    if k=="For" { return 29 }
    if k=="Match" { return 30 }
    if k=="Defer" { return 31 }
    if k=="ExpressionStatement" { return 32 }
    if k=="Function" { return 33 }
    if k=="Import" || k=="Struct" || k=="Enum" || k=="Break" || k=="Continue" { return 34 }
    if k=="TypeName" { return 40 }
    if k=="MutableType" { return 41 }
    if k=="OptionalType" { return 42 }
    if k=="SliceType" { return 43 }
    if k=="ArrayType" { return 44 }
    return 0
}
fn empty_ops() []NodeOp { var x []NodeOp=[]
    return x }
fn empty_ints() []int { var x []int=[]
    return x }
fn build_unit_plan(unit modules.Unit, refs map[string]string, declarations map[string]string, std_sigs mut map[string]signatures.Signature) []NodeOp {
    let pool=unit.tree.pool
    let count=ast.count(pool)
    var ops=list.from_slice(empty_ops())
    for idx in 0..count {
        let n=unwrap(ast.get(pool,ast.NodeId{pool:pool.identity,index:idx}))
        let k=kind_code(ast.kind(n.payload))
        let txt=ast.payload_text(n.payload)
        let nk=key(unit.id,idx)
        let rt=unwrap_or(refs[nk],"")
        let dt=unwrap_or(declarations[nk],"")
        if strings.starts_with(rt,"builtin:") && !has(std_sigs,rt) {
            let std=signatures.signature(rt)
            if is_some(std) { std_sigs[rt]=unwrap(std) }
        }
        var ch=list.from_slice(empty_ints())
        for c in n.children { unwrap(list.append(ch,c.index)) }
        let ch_snap=list.snapshot(ch)
        var pr=""
        if k==1 || (k==2 && rt!="") { pr=rt }
        else if (k==2 || k==3) && len(ch_snap)>0 {
            let parent_idx=ch_snap[0]
            if parent_idx>=0 && parent_idx<idx {
                let ppr=unwrap(list.get(ops,parent_idx)).proj
                if ppr!="" {
                    if k==3 { pr=ppr+"#@[]" }
                    else { pr=ppr+"#@"+txt }
                }
            }
        }
        unwrap(list.append(ops,NodeOp{kind:k,text:txt,ref_target:rt,decl_target:dt,proj:pr,node_key:nk,children:ch_snap,line:n.span.line,col:n.span.column}))
    }
    # Second pass for any forward child projection references (if parent index > child index, rare)
    for idx in 0..count {
        let op=unwrap(list.get(ops,idx))
        if (op.kind==2 || op.kind==3) && op.proj=="" && op.ref_target=="" && len(op.children)>0 {
            var cur=idx
            var segs=list.from_slice(empty_str_slice())
            var base=""
            var steps=0
            while steps<32 {
                steps+=1
                let co=unwrap(list.get(ops,cur))
                if co.proj!="" { base=co.proj
                    break }
                if co.kind==1 || (co.kind==2 && co.ref_target!="") { base=co.ref_target
                    break }
                if (co.kind==2 || co.kind==3) && len(co.children)>0 {
                    if co.kind==3 { unwrap(list.append(segs,"#@[]")) }
                    else { unwrap(list.append(segs,"#@"+co.text)) }
                    cur=co.children[0]
                } else { break }
            }
            if base!="" {
                let ss=list.snapshot(segs)
                var j=len(ss)-1
                var full=base
                while j>=0 { full+=ss[j]
                    j-=1 }
                var fixed=op
                fixed.proj=full
                unwrap(list.set(ops,idx,fixed))
            }
        }
    }
    return list.snapshot(ops)
}
fn empty_str_slice() []string { var x []string=[]
    return x }
struct SccComponent { members []string
    cyclic bool }
fn empty_sccs() []SccComponent { var x []SccComponent=[]
    return x }
fn bottom_up_sccs(functions map[string]Function, dependents map[string]map[string]bool) Result<[]SccComponent> {
    var empty []string=[]
    var callees=map[string]map[string]bool{}
    var rev_edges=map[string][]string{}
    for callee, callers in dependents { if has(functions,callee) {
        var rev_items=list.from_slice(empty)
        for caller, unused in callers { if has(functions,caller) {
            list.append(rev_items,caller)?
            var own=map[string]bool{}
            if has(callees,caller) { own=clone(unwrap(callees[caller])) }
            own[callee]=true
            callees[caller]=own } }
        rev_edges[callee]=list.snapshot(rev_items) } }
    var edges=map[string][]string{}
    for caller, targets in callees { var items=list.from_slice(empty)
        for callee, unused in targets { list.append(items,callee)? }
        edges[caller]=list.snapshot(items) }
    var none []int=[]
    var finish=list.from_slice(empty)
    var names=list.from_slice(empty)
    var cursor=list.from_slice(none)
    var seen=map[string]bool{}
    for root, unused in functions { if has(seen,root) { continue }
        seen[root]=true
        list.append(names,root)?
        list.append(cursor,0)?
        while list.len(names)>0 { let top=list.len(names)-1
            let name=list.get(names,top)?
            let i=list.get(cursor,top)?
            let targets=unwrap_or(rev_edges[name],empty)
            if i<len(targets) { list.set(cursor,top,i+1)?
                let child=targets[i]
                if !has(seen,child) { seen[child]=true
                    list.append(names,child)?
                    list.append(cursor,0)? } }
            else { list.pop(names)?
                list.pop(cursor)?
                list.append(finish,name)? } } }
    let fin=list.snapshot(finish)
    var sccs=list.from_slice(empty_sccs())
    var assigned=map[string]bool{}
    var idx=len(fin)-1
    while idx>=0 {
        let root=fin[idx]
        idx-=1
        if has(assigned,root) { continue }
        assigned[root]=true
        var comp=list.from_slice(empty)
        list.append(names,root)?
        list.append(cursor,0)?
        while list.len(names)>0 { let top=list.len(names)-1
            let name=list.get(names,top)?
            let i=list.get(cursor,top)?
            let targets=unwrap_or(edges[name],empty)
            if i<len(targets) { list.set(cursor,top,i+1)?
                let child=targets[i]
                if !has(assigned,child) { assigned[child]=true
                    list.append(names,child)?
                    list.append(cursor,0)? } }
            else { list.pop(names)?
                list.pop(cursor)?
                list.append(comp,name)? } }
        let members=list.snapshot(comp)
        var cyc=len(members)>1
        if !cyc && len(members)==1 {
            let m0=members[0]
            if has(callees,m0) && has(unwrap(callees[m0]),m0) { cyc=true }
        }
        list.append(sccs,SccComponent{members:members,cyclic:cyc})?
    }
    return ok(list.snapshot(sccs))
}
pub fn analyze(graph modules.Graph, refs map[string]string, declarations map[string]string, fields map[string]string, functions map[string]Function, variants map[string]string) Result<Model> {
    var members=map[string]map[string]string{}
    for full, typ in fields {
        let parts=strings.split(full,"#")
        let name=parts[len(parts)-1]
        let owner=rules.cut(full,0,len(full)-len(name)-1)
        var own=map[string]string{}
        if has(members,owner) { own=clone(unwrap(members[owner])) }
        own[name]=typ
        members[owner]=own
    }
    var p=opool.create()
    var std_sigs=map[string]signatures.Signature{}
    var plans=map[string][]NodeOp{}
    var units_map=map[string]modules.Unit{}
    for unit in list.snapshot(graph.units) {
        units_map[unit.id]=unit
        plans[unit.id]=build_unit_plan(unit,refs,declarations,std_sigs)
    }
    var s=State{std_sigs:std_sigs,fields:fields,members:members,shapes:map[string]map[string]View{},shape_prefixes:map[string]map[string]map[string]bool{},parameter_fields:map[string]map[string]View{},parameter_field_count:0,functions:functions,variants:variants,summaries:map[string]Summary{},dependents:map[string]map[string]bool{},sub_ret_fields:map[string]map[string]bool{},dirty:map[string]bool{},facts:map[string]Fact{},global_symbols:map[string]bool{},errors:map[string]string{},probing:true,work:0,error:""}
    var globals=map[string]Value{}
    for module in list.snapshot(graph.order) {
        let unit=unwrap(units_map[module])
        let ops=unwrap(plans[module])
        var e=environment(module,"",globals)
        statement(s,p,e,ops,unit.tree.root.index)?
        for name, input in e.values { globals[name]=input }
    }
    for owner, unused in globals { s.global_symbols[owner]=true }
    for name, unused in functions { if !rules.lexical_target(name) { s.dirty[name]=true } }
    var passes=0
    var non_converged=false
    var first []string=[]
    var keyed=list.from_slice(first)
    for name, unused in functions { list.append(keyed,name)? }
    var init_sccs=list.from_slice(empty_sccs())
    list.append(init_sccs,SccComponent{members:list.snapshot(keyed),cyclic:false})?
    let pass1_sccs=list.snapshot(init_sccs)
    while len(s.dirty)>0 && passes<32 && !non_converged {
        passes+=1
        var sccs=pass1_sccs
        if passes>1 { sccs=bottom_up_sccs(functions,s.dependents)? }
        for comp in sccs {
            var max_r=1
            if comp.cyclic { max_r=32 }
            var scc_rounds=0
            while scc_rounds<max_r {
                var any_dirty=false
                for name in comp.members {
                    if has(s.dirty,name) { any_dirty=true
                        break }
                }
                if !any_dirty { break }
                scc_rounds+=1
                for name in comp.members {
                    if !has(s.dirty,name) { continue }
                    let f=unwrap(functions[name])
                    delete(s.dirty,name)
                    delete(s.errors,name)
                    let ops=unwrap(plans[f.module])
                    var e=environment(f.module,name,globals)
                    for prm in f.parameters { store(e,prm.target,parameter_seeded(s,p,prm.type_name,prm.writable,prm.target))
                        if prm.writable { e.visible[prm.target]=true } }
                    statement(s,p,e,ops,ops[f.node].children[1])?
                    record_dependencies(s,e)
                    record_field_subscriptions(s,e)
                    let next=summary(p,e)
                    if !has(s.summaries,name) {
                        s.summaries[name]=next
                        if has(s.dependents,name) { for caller, unused in unwrap(s.dependents[name]) { s.dirty[caller]=true } }
                    } else {
                        let prev=unwrap(s.summaries[name])
                        var non_rf=prev.unknown!=next.unknown || prev.saw_return!=next.saw_return || prev.returned.root!=next.returned.root || prev.writes!=next.writes || prev.required!=next.required || len(prev.returned.positions)!=len(next.returned.positions)
                        if !non_rf {
                            for i in 0..len(prev.returned.positions) {
                                if !same_value(prev.returned.positions[i],next.returned.positions[i]) { non_rf=true
                                    break }
                            }
                        }
                        let rf_chg=prev.returned.fields!=next.returned.fields
                        if non_rf || rf_chg {
                            s.summaries[name]=next
                            if has(s.dependents,name) {
                                if non_rf { for caller, unused in unwrap(s.dependents[name]) { s.dirty[caller]=true } }
                                else if has(s.sub_ret_fields,name) { for caller, unused in unwrap(s.sub_ret_fields[name]) { s.dirty[caller]=true } }
                            }
                        }
                    }
                }
            }
            if comp.cyclic && scc_rounds>=32 {
                for name in comp.members {
                    if has(s.dirty,name) { non_converged=true
                        break }
                }
                if non_converged { break }
            }
        }
    }
    if non_converged || len(s.dirty)>0 {
        for name, input in s.summaries {
            var next=clone(input)
            next.unknown=true
            next.pure_fast=false
            next.writes=map[string]View{}
            next.compiled_writes=empty_compiled_writes()
            next.returned=conservative_value(input.returned)
            s.summaries[name]=next
            if has(s.dependents,name) { for caller, unused in unwrap(s.dependents[name]) { s.dirty[caller]=true } }
        }
    }
    s.probing=false
    for name, f in functions {
        if has(s.dirty,name) {
            delete(s.errors,name)
            let ops=unwrap(plans[f.module])
            var e=environment(f.module,name,globals)
            for prm in f.parameters { store(e,prm.target,parameter_seeded(s,p,prm.type_name,prm.writable,prm.target))
                if prm.writable { e.visible[prm.target]=true } }
            statement(s,p,e,ops,ops[f.node].children[1])?
        }
        if s.error=="" && has(s.errors,name) { s.error=unwrap(s.errors[name]) }
    }
    return ok(Model{facts:s.facts,passes:passes,work:s.work,error:s.error})
}
