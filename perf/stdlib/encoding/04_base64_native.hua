# base64编码/解码往返：原生std.encoding（对照02手写）
import std.list as list
import std.bytes as bytes
import std.encoding as encoding
fn main() {
    var empty []int = []
    var src = list.from_slice(empty)
    for i in 0..4096 { unwrap(list.append(src, (i * 7) % 256)) }
    let data = unwrap(bytes.from_ints(list.snapshot(src)))
    var total = 0
    for round in 0..30 {
        let text = encoding.base64_encode(data)
        total += len(text) + bytes.crc32(unwrap(encoding.base64_decode(text)))
    }
    print(total)
}
