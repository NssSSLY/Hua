# UTF-8校验与逐字符解码：手写严格校验＋解码（原生utf8_valid/utf8_decode对照见06）
import std.strings as strings
import std.bytes as bytes
fn valid(d []int) bool {
    var i = 0
    while i < len(d) {
        let b = d[i]
        var n = 1
        var low = 128
        var high = 191
        if b < 128 {
            n = 1
        } else if b >= 194 && b <= 223 {
            n = 2
        } else if b >= 224 && b <= 239 {
            n = 3
            if b == 224 { low = 160 }
            if b == 237 { high = 159 }
        } else if b >= 240 && b <= 244 {
            n = 4
            if b == 240 { low = 144 }
            if b == 244 { high = 143 }
        } else {
            return false
        }
        if i + n > len(d) { return false }
        for j in 1..n {
            let c = d[i + j]
            if c < low || c > high { return false }
            low = 128
            high = 191
        }
        i += n
    }
    return true
}
fn main() {
    let data = bytes.from_text(strings.repeat("aé中😀", 2000))
    var total = 0
    for round in 0..5 {
        let d = unwrap(bytes.to_ints(data))
        if valid(d) { total += 1 }
        var i = 0
        while i < len(d) {
            let b = d[i]
            var cp = b
            var n = 1
            if b >= 240 {
                cp = b & 7
                n = 4
            } else if b >= 224 {
                cp = b & 15
                n = 3
            } else if b >= 192 {
                cp = b & 31
                n = 2
            }
            for j in 1..n { cp = (cp << 6) | (d[i + j] & 63) }
            total += cp
            i += n
        }
    }
    print(total)
}
