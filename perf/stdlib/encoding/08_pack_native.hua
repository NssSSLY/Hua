# 端序打包：原生pack/unpack（对照07手写）
import std.encoding as encoding
fn main() {
    var total = 0
    for i in 0..30000 {
        let v = i * 7919
        let a = unwrap(encoding.pack_uint(v, 4, "be"))
        total += unwrap(encoding.unpack_uint(a, 0, 4, "be"))
        let n = (i % 65536) - 32768
        let b = unwrap(encoding.pack_int(n, 2, "le"))
        total += unwrap(encoding.unpack_int(b, 0, 2, "le"))
    }
    print(total)
}
