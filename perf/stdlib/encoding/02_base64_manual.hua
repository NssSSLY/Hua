# base64编码/解码往返：手写（原生encoding对照见04）
import std.list as list
import std.bytes as bytes
import std.buffer as buffer
import std.strings as strings
fn main() {
    var empty []int = []
    var src = list.from_slice(empty)
    for i in 0..4096 { unwrap(list.append(src, (i * 7) % 256)) }
    let data = unwrap(bytes.from_ints(list.snapshot(src)))
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var none []string = []
    var letters = list.from_slice(none)
    var rev = map[string]int{}
    for v in 0..64 {
        let c = unwrap(strings.slice(alphabet, v, v + 1))
        unwrap(list.append(letters, c))
        rev[c] = v
    }
    let table = list.snapshot(letters)
    var total = 0
    for round in 0..30 {
        let xs = unwrap(bytes.to_ints(data))
        var out = buffer.new()
        var i = 0
        while i < len(xs) {
            let a = xs[i]
            var b = 0
            if i + 1 < len(xs) { b = xs[i + 1] }
            var c = 0
            if i + 2 < len(xs) { c = xs[i + 2] }
            let n = (a << 16) | (b << 8) | c
            buffer.write_str(out, table[n >> 18])
            buffer.write_str(out, table[(n >> 12) & 63])
            if i + 1 < len(xs) { buffer.write_str(out, table[(n >> 6) & 63]) } else { buffer.write_str(out, "=") }
            if i + 2 < len(xs) { buffer.write_str(out, table[n & 63]) } else { buffer.write_str(out, "=") }
            i += 3
        }
        let text = unwrap(buffer.take_text(out))
        var back = list.from_slice(empty)
        var j = 0
        while j < len(text) {
            let c2 = unwrap(strings.slice(text, j + 2, j + 3))
            let c3 = unwrap(strings.slice(text, j + 3, j + 4))
            let n = (unwrap(rev[unwrap(strings.slice(text, j, j + 1))]) << 18) | (unwrap(rev[unwrap(strings.slice(text, j + 1, j + 2))]) << 12) | (unwrap_or(rev[c2], 0) << 6) | unwrap_or(rev[c3], 0)
            unwrap(list.append(back, n >> 16))
            if c2 != "=" { unwrap(list.append(back, (n >> 8) & 255)) }
            if c3 != "=" { unwrap(list.append(back, n & 255)) }
            j += 4
        }
        total += len(text) + bytes.crc32(unwrap(bytes.from_ints(list.snapshot(back))))
    }
    print(total)
}
