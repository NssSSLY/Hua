# 参数解析：手写循环＋map（原生os.parse_args对照见02）
import std.strings as strings
fn main() {
    let argv = ["input.txt", "--verbose", "--name=hua", "-n", "second", "--name", "third", "output.txt", "--", "--literal"]
    var total = 0
    for round in 0..4000 {
        var positional = 0
        var names = 0
        var verbose = false
        var i = 0
        var rest = false
        while i < len(argv) {
            let t = argv[i]
            if rest {
                positional += 1
            } else if t == "--" {
                rest = true
            } else if t == "--verbose" {
                verbose = true
            } else if strings.starts_with(t, "--name=") {
                names += 1
            } else if t == "--name" || t == "-n" {
                names += 1
                i += 1
            } else {
                positional += 1
            }
            i += 1
        }
        total += positional + names
        if verbose { total += 1 }
    }
    print(total)
}
