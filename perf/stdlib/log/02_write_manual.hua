# 结构日志：手写logfmt格式化，每行一次io.write_err写stderr（原生log对照见03）
import std.io as io
import std.time as time
fn main() {
    var lines = 0
    for i in 0..100000 {
        let n = unwrap(io.write_err("ts=" + time.format_rfc3339(time.unix_ms()) + " level=info msg=\"request done\" id=" + str(i) + " path=/api/items\n"))
        if n > 0 { lines += 1 }
    }
    print(lines, true)
}
