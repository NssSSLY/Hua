# 带缺省值读取与删除取值：原生maps.get_or/pop（对照03手写）
import std.maps as maps
fn main() {
    var total = 0
    for round in 0..40 {
        var m = map[int]int{}
        for i in 0..3000 { m[i] = i * 3 }
        for i in 0..6000 { total += maps.get_or(m, i, 1) }
        for i in 0..3000 {
            if i % 2 == 0 { total += unwrap(maps.pop(m, i)) }
        }
        total += len(m)
    }
    print(total)
}
