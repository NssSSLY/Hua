# 就地保留：原生list.retain（对照07手写）
import std.list as list
fn keep(x int) bool { return x % 4 != 0 }
fn main() {
    var empty []int = []
    var check = 0
    for round in 0..20 {
        var l = list.from_slice(empty)
        for i in 0..20000 { unwrap(list.append(l, (i * 13) % 1000)) }
        check += list.retain(l, keep) + unwrap(list.get(l, 0)) + unwrap(list.get(l, list.len(l) - 1))
    }
    print(check)
}
