# 中间插入与删除：手写为append/pop加逐项get/set移位
import std.list as list
fn main() {
    var empty []int = []
    var total = 0
    for round in 0..5 {
        var l = list.from_slice(empty)
        for i in 0..1000 { unwrap(list.append(l, i)) }
        for j in 0..200 {
            let at = (j * 37) % list.len(l)
            unwrap(list.append(l, 0))
            var p = list.len(l) - 1
            while p > at {
                unwrap(list.set(l, p, unwrap(list.get(l, p - 1))))
                p -= 1
            }
            unwrap(list.set(l, at, 0 - j))
        }
        for j in 0..200 {
            let at = (j * 53) % list.len(l)
            total += unwrap(list.get(l, at))
            var p = at
            while p < list.len(l) - 1 {
                unwrap(list.set(l, p, unwrap(list.get(l, p + 1))))
                p += 1
            }
            unwrap(list.pop(l))
        }
        total += list.len(l) + unwrap(list.get(l, 0)) + unwrap(list.get(l, list.len(l) - 1))
    }
    print(total)
}
