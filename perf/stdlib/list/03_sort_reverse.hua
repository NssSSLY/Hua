# 就地排序与反转：手写为snapshot→alg.sorted/reverse→clear→extend
import std.list as list
import std.alg as alg
fn main() {
    var empty []int = []
    var check = 0
    for round in 0..10 {
        var l = list.from_slice(empty)
        var x = round + 1
        for i in 0..20000 {
            x = (x * 1103515245 + 12345) % 2147483648
            unwrap(list.append(l, x % 100000))
        }
        let s = unwrap(alg.sorted(list.snapshot(l)))
        list.clear(l)
        unwrap(list.extend(l, s))
        check += unwrap(list.get(l, 0)) + unwrap(list.get(l, 10000)) + unwrap(list.get(l, 19999))
        let r = unwrap(alg.reverse(list.snapshot(l)))
        list.clear(l)
        unwrap(list.extend(l, r))
        check += unwrap(list.get(l, 0)) - unwrap(list.get(l, 19999))
    }
    print(check)
}
