# 去相邻重复：手写逐项与前一项比较＋新List append（原生list.dedup对照见10）
import std.list as list
fn main() {
    var ints []int = []
    var strs []string = []
    var a = list.from_slice(ints)
    for i in 0..20000 { unwrap(list.append(a, (i // 2 * 7) % 1000)) }
    var b = list.from_slice(strs)
    for i in 0..20000 { unwrap(list.append(b, "k" + str((i // 2) % 2500))) }
    let xs = list.snapshot(a)
    let ss = list.snapshot(b)
    var total = 0
    for round in 0..10 {
        var out = list.from_slice(ints)
        var first = true
        var prev = 0
        for x in xs {
            if first || x != prev {
                unwrap(list.append(out, x))
                prev = x
                first = false
            }
        }
        total += len(xs) - list.len(out) + list.len(out)
        var out_s = list.from_slice(strs)
        var prev_s = ""
        var first_s = true
        for s in ss {
            if first_s || s != prev_s {
                unwrap(list.append(out_s, s))
                prev_s = s
                first_s = false
            }
        }
        total += len(ss) - list.len(out_s) + list.len(out_s) * 2
    }
    print(total)
}
