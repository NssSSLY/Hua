# 就地排序与反转：原生list.sort/reverse（对照03手写）
import std.list as list
fn main() {
    var empty []int = []
    var check = 0
    for round in 0..10 {
        var l = list.from_slice(empty)
        var x = round + 1
        for i in 0..20000 {
            x = (x * 1103515245 + 12345) % 2147483648
            unwrap(list.append(l, x % 100000))
        }
        list.sort(l)
        check += unwrap(list.get(l, 0)) + unwrap(list.get(l, 10000)) + unwrap(list.get(l, 19999))
        list.reverse(l)
        check += unwrap(list.get(l, 0)) - unwrap(list.get(l, 19999))
    }
    print(check)
}
