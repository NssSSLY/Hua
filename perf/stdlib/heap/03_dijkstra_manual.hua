# 网格Dijkstra：手写堆＋键编码（原生heap对照见06/07）
import std.list as list
fn hpush(mut h List<int>, x int) {
    unwrap(list.append(h, x))
    var i = list.len(h) - 1
    while i > 0 {
        let p = (i - 1) // 2
        let pv = unwrap(list.get(h, p))
        if pv <= x { break }
        unwrap(list.set(h, i, pv))
        i = p
    }
    unwrap(list.set(h, i, x))
}
fn hpop(mut h List<int>) int {
    let top = unwrap(list.get(h, 0))
    let last = unwrap(list.pop(h))
    let n = list.len(h)
    if n > 0 {
        var i = 0
        while 2 * i + 1 < n {
            var c = 2 * i + 1
            if c + 1 < n && unwrap(list.get(h, c + 1)) < unwrap(list.get(h, c)) { c += 1 }
            let cv = unwrap(list.get(h, c))
            if cv >= last { break }
            unwrap(list.set(h, i, cv))
            i = c
        }
        unwrap(list.set(h, i, last))
    }
    return top
}
fn main() {
    let w = 150
    var empty []int = []
    var total = 0
    for round in 0..2 {
        var dist = list.from_slice(empty)
        for i in 0..w * w { unwrap(list.append(dist, 1000000000000000000)) }
        unwrap(list.set(dist, 0, 0))
        var h = list.from_slice([0])
        while list.len(h) > 0 {
            let e = hpop(h)
            let d = e // 100000
            let c = e % 100000
            if d <= unwrap(list.get(dist, c)) {
                let x = c % w
                let y = c // w
                for k in 0..4 {
                    var nx = x
                    var ny = y
                    if k == 0 { nx = x + 1 }
                    if k == 1 { nx = x - 1 }
                    if k == 2 { ny = y + 1 }
                    if k == 3 { ny = y - 1 }
                    if nx >= 0 && nx < w && ny >= 0 && ny < w {
                        let n = ny * w + nx
                        let nd = d + (nx * 31 + ny * 17) % 9 + 1
                        if nd < unwrap(list.get(dist, n)) {
                            unwrap(list.set(dist, n, nd))
                            hpush(h, nd * 100000 + n)
                        }
                    }
                }
            }
        }
        for d in list.snapshot(dist) { total += d }
    }
    print(total)
}
