# top-k：手写alg.sorted后取前100（原生heap.smallest对照见05）
import std.list as list
import std.alg as alg
fn main() {
    var empty []int = []
    var src = list.from_slice(empty)
    var x = 1
    for i in 0..200000 {
        x = (x * 1103515245 + 12345) % 2147483648
        unwrap(list.append(src, x % 10000000))
    }
    let xs = list.snapshot(src)
    var total = 0
    for round in 0..5 {
        let sorted = unwrap(alg.sorted(xs))
        var s = 0
        for i in 0..100 { s += sorted[i] }
        total += s + round
    }
    print(total)
}
