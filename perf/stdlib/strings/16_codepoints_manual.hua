# 码点往返：手写UTF-8解码与编码（原生codepoints/from_codepoints对照见19）
import std.strings as strings
import std.bytes as bytes
import std.list as list
fn main() {
    let text = strings.repeat("aé中😀", 2000)
    var empty []int = []
    var total = 0
    for round in 0..10 {
        let data = unwrap(bytes.to_ints(bytes.from_text(text)))
        var decoded = list.from_slice(empty)
        var i = 0
        while i < len(data) {
            let b = data[i]
            var cp = b
            var n = 1
            if b >= 240 {
                cp = b & 7
                n = 4
            } else if b >= 224 {
                cp = b & 15
                n = 3
            } else if b >= 192 {
                cp = b & 31
                n = 2
            }
            for j in 1..n { cp = (cp << 6) | (data[i + j] & 63) }
            unwrap(list.append(decoded, cp))
            i += n
        }
        let cs = list.snapshot(decoded)
        var encoded = list.from_slice(empty)
        for cp in cs {
            if cp < 128 {
                unwrap(list.append(encoded, cp))
            } else if cp < 2048 {
                unwrap(list.append(encoded, 192 | (cp >> 6)))
                unwrap(list.append(encoded, 128 | (cp & 63)))
            } else if cp < 65536 {
                unwrap(list.append(encoded, 224 | (cp >> 12)))
                unwrap(list.append(encoded, 128 | ((cp >> 6) & 63)))
                unwrap(list.append(encoded, 128 | (cp & 63)))
            } else {
                unwrap(list.append(encoded, 240 | (cp >> 18)))
                unwrap(list.append(encoded, 128 | ((cp >> 12) & 63)))
                unwrap(list.append(encoded, 128 | ((cp >> 6) & 63)))
                unwrap(list.append(encoded, 128 | (cp & 63)))
            }
        }
        let back = unwrap(bytes.to_text(unwrap(bytes.from_ints(list.snapshot(encoded)))))
        total += len(cs) + cs[len(cs) - 1] + len(back)
    }
    print(total)
}
