# 边界加法：分别实现可恢复溢出、补码回绕和饱和，作为since22接口对照。
fn checked_add(a int,b int) Result<int,string> {
    if (b>0 && a>9223372036854775807-b) || (b<0 && a<(-9223372036854775808)-b) { return err("MATH_OVERFLOW") }
    return ok(a+b)
}
fn wrapping_add(a int,b int) int {
    if b>0 && a>9223372036854775807-b { return (-9223372036854775808)+(a-(9223372036854775807-b)-1) }
    if b<0 && a<(-9223372036854775808)-b { return 9223372036854775807+(a-((-9223372036854775808)-b)+1) }
    return a+b
}
fn saturating_add(a int,b int) int {
    if b>0 && a>9223372036854775807-b { return 9223372036854775807 }
    if b<0 && a<(-9223372036854775808)-b { return -9223372036854775808 }
    return a+b
}
fn main() {
    var total=0
    var errors=0
    for i in 0..60000 {
        let x=9223372036854775807-(i%8)
        let c=checked_add(x,3)
        if is_err(c) { errors+=1 }
        total += unwrap_or(c,0) & 65535
        total += wrapping_add(x,3) & 65535
        total += saturating_add(x,3) & 65535
    }
    print(total,errors)
}
