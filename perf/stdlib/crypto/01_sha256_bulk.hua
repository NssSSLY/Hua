# SHA-256批量（1 MiB×8轮，无手写对照）
import std.list as list
import std.bytes as bytes
import std.buffer as buffer
import std.crypto as crypto
import std.encoding as encoding
fn main() {
    var empty []int = []
    var src = list.from_slice(empty)
    for i in 0..4096 { unwrap(list.append(src, (i * 31) % 256)) }
    let block = unwrap(bytes.from_ints(list.snapshot(src)))
    var out = buffer.new()
    for k in 0..256 { unwrap(buffer.append(out, block)) }
    let data = buffer.bytes(out)
    var d = unwrap(bytes.from_ints(empty))
    for r in 0..8 { d = crypto.sha256(unwrap(bytes.concat(data, d))) }
    print(encoding.hex_encode(d))
}
