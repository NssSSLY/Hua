# 随机整数与浮点：手写31位LCG（原生random.int/float对照见03）
fn main() {
    var x = 42
    var n = 0
    for i in 0..300000 {
        x = (x * 1103515245 + 12345) % 2147483648
        let v = x % 1000
        if v >= 0 && v < 1000 { n += 1 }
        x = (x * 1103515245 + 12345) % 2147483648
        let f = float(x) / 2147483648.0
        if f >= 0.0 && f < 1.0 { n += 1 }
    }
    print(n)
}
