# 洗牌与抽样：原生random.shuffle/sample（对照02手写）
import std.list as list
import std.random as random
fn main() {
    var empty []int = []
    var l = list.from_slice(empty)
    for i in 0..10000 { unwrap(list.append(l, i)) }
    var r = random.new(7)
    var total = 0
    for k in 0..20 {
        random.shuffle(r, l)
        var s = 0
        for v in list.snapshot(l) { s += v }
        total += s + len(unwrap(random.sample(r, list.snapshot(l), 100)))
    }
    print(total)
}
