# 洗牌与抽样：手写LCG＋list.get/set的Fisher–Yates（原生shuffle/sample对照见04）
import std.list as list
fn main() {
    var empty []int = []
    var l = list.from_slice(empty)
    for i in 0..10000 { unwrap(list.append(l, i)) }
    var x = 7
    var total = 0
    for k in 0..20 {
        var i = list.len(l) - 1
        while i > 0 {
            x = (x * 1103515245 + 12345) % 2147483648
            let j = x % (i + 1)
            let a = unwrap(list.get(l, i))
            unwrap(list.set(l, i, unwrap(list.get(l, j))))
            unwrap(list.set(l, j, a))
            i -= 1
        }
        var s = 0
        for v in list.snapshot(l) { s += v }
        var idx = list.from_slice(list.snapshot(l))
        var picked = 0
        for t in 0..100 {
            x = (x * 1103515245 + 12345) % 2147483648
            let j = t + x % (list.len(idx) - t)
            let a = unwrap(list.get(idx, t))
            unwrap(list.set(idx, t, unwrap(list.get(idx, j))))
            unwrap(list.set(idx, j, a))
            picked += 1
        }
        total += s + picked
    }
    print(total)
}
