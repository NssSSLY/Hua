# 滑动窗口：原生alg.windows（对照19手写）
import std.alg as alg
import std.list as list
fn main() {
    var ints []int = []
    var a = list.from_slice(ints)
    for i in 0..5000 { unwrap(list.append(a, (i * 7919) % 10007)) }
    let xs = list.snapshot(a)
    var total = 0
    for round in 0..10 {
        let ws = alg.windows(xs, 8)
        total += len(ws)
        for w in ws { total += w[0] + w[7] }
    }
    print(total)
}
