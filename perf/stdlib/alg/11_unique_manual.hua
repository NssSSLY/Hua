# 去重保留首次出现顺序：手写map[T]bool记录已见＋list.append（原生alg.unique对照见14）
import std.list as list
fn main() {
    var ints []int = []
    var strs []string = []
    var a = list.from_slice(ints)
    for i in 0..20000 { unwrap(list.append(a, (i * 7919) % 10000)) }
    var b = list.from_slice(strs)
    for i in 0..5000 { unwrap(list.append(b, "k" + str((i * 31) % 2500))) }
    let xs = list.snapshot(a)
    let ss = list.snapshot(b)
    var total = 0
    for round in 0..10 {
        var seen = map[int]bool{}
        var out = list.from_slice(ints)
        for x in xs {
            if !has(seen, x) {
                seen[x] = true
                unwrap(list.append(out, x))
            }
        }
        let u = list.snapshot(out)
        total += len(u) + u[0] + u[len(u) - 1]
        var seen_s = map[string]bool{}
        var out_s = list.from_slice(strs)
        for s in ss {
            if !has(seen_s, s) {
                seen_s[s] = true
                unwrap(list.append(out_s, s))
            }
        }
        total += list.len(out_s)
    }
    print(total)
}
