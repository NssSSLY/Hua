# 过滤、存在与查找：手写for循环（原生filter/any/find_index对照见08）
import std.list as list
fn keep(x int) bool { return x % 3 == 0 }
fn main() {
    var empty []int = []
    var src = list.from_slice(empty)
    for i in 0..20000 { unwrap(list.append(src, (i * 7) % 20000)) }
    let xs = list.snapshot(src)
    var total = 0
    for round in 0..20 {
        var kept = list.from_slice(empty)
        for x in xs {
            if keep(x) { unwrap(list.append(kept, x)) }
        }
        total += list.len(kept)
        for x in xs {
            if x > 19990 {
                total += 1
                break
            }
        }
        var at = -1
        for i in 0..len(xs) {
            if xs[i] == 19999 - round {
                at = i
                break
            }
        }
        total += at
    }
    print(total)
}
