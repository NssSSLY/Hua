# 由Unix毫秒拆出UTC分量并格式化：手写civil_from_days＋pad（原生time对照见04）
import std.strings as strings
fn civil(z int) (int, int, int) {
    let zz = z + 719468
    var era = zz // 146097
    let doe = zz - era * 146097
    let yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    let doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    let mp = (5 * doy + 2) // 153
    let d = doy - (153 * mp + 2) // 5 + 1
    var m = mp + 3
    if mp >= 10 { m = mp - 9 }
    var y = yoe + era * 400
    if m <= 2 { y += 1 }
    return y, m, d
}
fn two(v int) string { return strings.pad_left(str(v), 2, "0") }
fn main() {
    var total = 0
    var length = 0
    for i in 0..100000 {
        let ms = (i * 86399937 * 13) % 4102444800000
        let days = ms // 86400000
        let rest = ms % 86400000
        let y, mo, d = civil(days)
        let h = rest // 3600000
        let mi = rest // 60000 % 60
        let s = rest // 1000 % 60
        let frac = rest % 1000
        total += y + mo + d + h + mi + s + frac
        var text = strings.pad_left(str(y), 4, "0") + "-" + two(mo) + "-" + two(d) + "T" + two(h) + ":" + two(mi) + ":" + two(s)
        if frac != 0 { text = text + "." + strings.pad_left(str(frac), 3, "0") }
        text = text + "Z"
        length += len(text)
    }
    print(total, length)
}
