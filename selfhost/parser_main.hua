# 直接运行时错误以 JSON 返回；进程退出和原子写出由 tools/hua_frontend.py 承担。
import parser as parser
import parser_report as report
import std.fs as fs
import std.os as os
import std.strings as strings
fn main() {
    let args = os.args()
    if len(args) != 2 { print(report.failure("command","input.hua","E8204@1:1 usage: source.hua logical-id"))
        return }
    let source = fs.read_text(args[0])
    if is_err(source) { print(report.failure("input",args[1],"E8204@1:1 "+unwrap_err(source)))
        return }
    let tree = parser.parse(unwrap(source),args[1])
    if is_err(tree) {
        let detail = unwrap_err(tree)
        var stage = "parser"
        if strings.starts_with(detail,"E1") { stage = "lexer" }
        print(report.failure(stage,args[1],detail))
        return
    }
    print(report.success(unwrap(tree)))
}
