import types as types
import lowering as lower
import lowering_report as report
import std.os as os
import std.path as path
fn main() {
    let args = os.args()
    if len(args)!=1 { print(report.failure("input.hua","E8204@1:1 usage: entry.hua"))
        return }
    let source = unwrap(path.basename(args[0]))
    let checked = types.analyze(args[0])
    if is_err(checked) { print(report.failure(source,unwrap_err(checked)))
        return }
    let model = unwrap(checked)
    let result = lower.lower(model)
    if is_err(result) { print(report.failure(source,unwrap_err(result)))
        return }
    let encoded = report.success(unwrap(result),model,source)
    if is_err(encoded) { print(report.failure(source,"E8202@1:1 report encoding budget: "+unwrap_err(encoded)))
        return }
    print(unwrap(encoded))
}
