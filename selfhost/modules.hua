# C03-N1：本地模块与词法名称分析；不执行初始化、不进行类型/能力检查。
import parser as parser
import ast_pool as ast
import catalog as catalog
import std.list as list
import std.fs as fs
import std.path as path
import std.os as os
import std.strings as strings
import std.bytes as bytes
import std.json as json
import std.alg as alg

pub struct Unit { id string
    path string
    key string
    package string
    external bool
    abi_version int
    tree parser.Tree }
pub struct NativeArtifact { source string
    artifact string }
pub struct ExternalModule { id string
    unit_id string
    artifact string
    source_path string
    abi_version int }
pub struct PackageInfo { name string
    version string
    root string
    deps map[string]string
    native_libs []string }
pub struct BuildInput { path string
    kind string
    content string }
pub struct Edge { source string
    target string
    namespace string
    node int }
pub struct Symbol { module string
    node int
    name string
    kind string
    published bool
    scope int
    target string }
pub struct Reference { module string
    node int
    name string
    target string
    type_name bool }
pub struct Limits { depth int
    modules int
    levels int
    source_bytes_total int
    symbols int
    references int
    work int
    compiler bool }
pub fn defaults() Limits { return Limits{depth:24,modules:8,levels:4,source_bytes_total:32768,symbols:512,references:1024,work:8192,compiler:false} }
pub fn compiler_limits() Limits { return Limits{depth:64,modules:32,levels:12,source_bytes_total:1048576,symbols:8192,references:32768,work:262144,compiler:true} }
pub struct Graph { globals map[string]int
    limits Limits
 root string
    has_manifest bool
    root_package PackageInfo
    packages map[string]PackageInfo
    units List<Unit>
    edges List<Edge>
    symbols List<Symbol>
    references List<Reference>
    order List<string>
    active List<string>
    total_bytes int
    work int
    build_inputs List<BuildInput>
    external_modules List<ExternalModule>
    native_artifacts List<NativeArtifact> }
struct Environment { unit string
    pool ast.Pool
    imports []Edge
    scopes List<int>
    locals map[string]Symbol
    visible map[string]bool
    next_scope int
    depth int }
fn error(id string, n ast.Node, code string, reason string) string {
    return code+"@"+str(n.span.line)+":"+str(n.span.column)+" ["+id+"] "+reason
}
fn check_work(g mut Graph, unit string, n ast.Node) Result<void> {
    if g.work >= g.limits.work { return err(error(unit,n,"E5005","analysis work budget")) }
    g.work += 1
    return ok()
}
fn declared(text string) string { return strings.split(text," ")[0] }
fn namespace_root(text string) string { return strings.split(text,".")[0] }
fn cache_key(p string) string {
    if strings.index(p,":") >= 0 || strings.starts_with(p,"//") { return strings.lower_ascii(p) }
    return p
}
fn unit_index(g Graph, id string) int {
    for i in 0..list.len(g.units) { if unwrap(list.get(g.units,i)).id == id { return i } }
    return -1
}
fn global(g Graph, module string, name string) Symbol? {
    let key = module+"#"+name
    if !has(g.globals,key) { return nil }
    return unwrap(list.get(g.symbols,unwrap(g.globals[key])))
}
fn add_global(g mut Graph, u Unit, n ast.Node, name string, kind string, published bool) Result<void> {
    if name == "_" { return ok() }
    if is_some(global(g,u.id,name)) { return err(error(u.id,n,"E3002","duplicate declaration "+name)) }
    if list.len(g.symbols) >= g.limits.symbols { return err(error(u.id,n,"E5005","symbol budget")) }
    g.globals[u.id+"#"+name] = list.len(g.symbols)
    list.append(g.symbols,Symbol{module:u.id,node:n.id.index,name:name,kind:kind,published:published,scope:0,target:u.id+"#"+name})?
    return ok()
}
fn collect(g mut Graph, u Unit) Result<void> {
    let root = ast.get(u.tree.pool,u.tree.root)?
    for id in root.children {
        let n = ast.get(u.tree.pool,id)?
        check_work(g,u.id,n)?
        let k = ast.kind(n.payload)
        let name = declared(ast.payload_text(n.payload))
        if alg.contains(["Function","Struct","Enum","Let","Var","Const"],k) {
            if strings.starts_with(name,"__") { return err(error(u.id,n,"E8201","internal declaration name")) }
            if k == "Struct" && alg.contains(["Json","Bytes","Buffer","List","Task","NativeHandle"],name) { return err(error(u.id,n,"E3002","reserved standard type")) }
            let published = strings.ends_with(ast.payload_text(n.payload)," pub")
            add_global(g,u,n,name,k,published)?
            if k == "Enum" { for variant in n.children {
                let v = ast.get(u.tree.pool,variant)?
                add_global(g,u,v,name+"."+ast.payload_text(v.payload),"Variant",published)? } }
        } else if k == "MultiBinding" {
            let names = ast.get(u.tree.pool,n.children[0])?
            for id in names.children { let p = ast.get(u.tree.pool,id)?
                add_global(g,u,p,ast.payload_text(p.payload),ast.payload_text(n.payload),false)? }
        }
    }
    for edge in list.snapshot(g.edges) {
        if edge.source == u.id && is_some(global(g,u.id,namespace_root(edge.namespace))) { return err(error(u.id,root,"E5004","import namespace conflicts with declaration")) }
    }
    return ok()
}
# No canonical API exists in SB1: inspect every dependency component and fail closed on symlinks.
fn inspect(g mut Graph, base string, relative string, site ast.Node, source string) Result<string> {
    let parts = strings.split(relative,"/")
    var current = base
    for i in 0..len(parts) {
        current = path.join([current,parts[i]])?
        let info = fs.stat(current)
        if is_err(info) {
            list.append(g.build_inputs,BuildInput{path:current,kind:"unavailable",content:unwrap_err(info)})?
            return ok("")
        }
        let kind = json.as_string(json.get(unwrap(info),"kind")?)?
        list.append(g.build_inputs,BuildInput{path:current,kind:kind,content:""})?
        if kind == "symlink" { return err(error(source,site,"E8302","symlink dependency is outside this resolver contract")) }
        if i+1 < len(parts) && kind != "directory" { return ok("") }
        if i+1 == len(parts) && kind != "file" { return ok("") }
    }
    return ok(current)
}
fn resolve(g mut Graph, name string, site ast.Node, source string) Result<string> {
    let relative = strings.replace(name,".","/")
    for candidate in [relative+".hua",relative+"/package.hua",relative+".huam",relative+"/package.huam"] {
        let p = inspect(g,g.root,candidate,site,source)?
        if p != "" { return ok(p) }
    }
    for candidate in [relative+".wasm",relative+"/package.wasm"] {
        if inspect(g,g.root,candidate,site,source)? != "" { return err(error(source,site,"E8201","WASM module is outside SB1")) }
    }
    return err(error(source,site,"E5001","cannot resolve module "+name))
}
fn valid_package_name(name string) bool {
    let n = strings.len_bytes(name)
    if n <= 0 || n > 128 || strings.starts_with(name,"__") { return false }
    let alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    let alnum = alpha + "0123456789"
    let first = unwrap_or(strings.slice(name,0,1),"")
    if first == "" || strings.index(alpha,first) < 0 { return false }
    for i in 0..n {
        let ch = unwrap_or(strings.slice(name,i,i+1),"")
        if ch == "" || strings.index(alnum,ch) < 0 { return false }
    }
    return !alg.contains([
        "std","int","float","bool","string","byte","i8","i16","i32","i64",
        "u8","u16","u32","u64","f32","f64","usize","isize","void",
        "Json","Bytes","Buffer","List","Deque","Result","Task","NativeHandle","map",
        "fn","struct","enum","interface","import","as","let","var","const",
        "pub","mut","async","await","spawn","taskgroup","parallel","simd",
        "match","if","else","while","for","in","by","break","continue",
        "return","defer","true","false","nil","unsafe"
    ],name)
}
fn skip_ws(raw Bytes, start int) int {
    var at = start
    let total = bytes.len(raw)
    while at < total {
        let b = unwrap(bytes.at(raw,at))
        if b != 32 && b != 9 && b != 13 && b != 10 { break }
        at += 1
    }
    return at
}
struct ScannedKey { text string
    next int }
struct ManifestShape { top_keys []string
    dep_keys []string }
struct ResolvedImport { file string
    logical string
    package string }
fn scan_json_str(raw_text string, raw Bytes, start int) Result<ScannedKey> {
    let total = bytes.len(raw)
    if start >= total || unwrap(bytes.at(raw,start)) != 34 { return err("bad string") }
    var at = start + 1
    while at < total {
        let b = unwrap(bytes.at(raw,at))
        at += 1
        if b == 34 {
            let token = strings.slice(raw_text,start,at)?
            let decoded = json.as_string(json.decode(token)?)?
            return ok(ScannedKey{text:decoded,next:at})
        }
        if b == 92 {
            if at >= total { return err("bad escape") }
            at += 1
        }
    }
    return err("unterminated")
}
fn scan_unique_json(raw_text string, raw Bytes, start int) Result<int> {
    let total = bytes.len(raw)
    var at = skip_ws(raw,start)
    if at >= total { return ok(at) }
    let b = unwrap(bytes.at(raw,at))
    if b == 34 {
        let scanned = scan_json_str(raw_text,raw,at)?
        return ok(scanned.next)
    }
    if b == 91 {
        at = skip_ws(raw,at+1)
        if at < total && unwrap(bytes.at(raw,at)) == 93 { return ok(at+1) }
        while at < total {
            at = scan_unique_json(raw_text,raw,at)?
            at = skip_ws(raw,at)
            if at < total && unwrap(bytes.at(raw,at)) == 93 { return ok(at+1) }
            if at >= total || unwrap(bytes.at(raw,at)) != 44 { return err("bad array") }
            at += 1
        }
        return err("unclosed array")
    }
    if b == 123 {
        at = skip_ws(raw,at+1)
        var seen = map[string]bool{}
        if at < total && unwrap(bytes.at(raw,at)) == 125 { return ok(at+1) }
        while at < total {
            at = skip_ws(raw,at)
            let scanned = scan_json_str(raw_text,raw,at)?
            if has(seen,scanned.text) { return err("duplicate key") }
            seen[scanned.text] = true
            at = skip_ws(raw,scanned.next)
            if at >= total || unwrap(bytes.at(raw,at)) != 58 { return err("expected colon") }
            at = scan_unique_json(raw_text,raw,at+1)?
            at = skip_ws(raw,at)
            if at < total && unwrap(bytes.at(raw,at)) == 125 { return ok(at+1) }
            if at >= total || unwrap(bytes.at(raw,at)) != 44 { return err("bad object") }
            at += 1
        }
        return err("unclosed object")
    }
    while at < total {
        let ch = unwrap(bytes.at(raw,at))
        if ch == 44 || ch == 93 || ch == 125 || ch == 32 || ch == 9 || ch == 13 || ch == 10 { break }
        at += 1
    }
    return ok(at)
}
fn scan_object_keys(raw_text string, raw Bytes, start int) Result<ScannedKey> {
    return scan_json_str(raw_text,raw,start)
}
fn parse_manifest_shape(raw_text string) Result<ManifestShape> {
    let raw = bytes.from_text(raw_text)
    let total = bytes.len(raw)
    var at = skip_ws(raw,0)
    if at >= total || unwrap(bytes.at(raw,at)) != 123 { return err("not object") }
    at = skip_ws(raw,at+1)
    let empty []string = []
    var top_keys = list.from_slice(empty)
    var dep_keys = list.from_slice(empty)
    var seen_top = map[string]bool{}
    if at < total && unwrap(bytes.at(raw,at)) == 125 {
        return ok(ManifestShape{top_keys:list.snapshot(top_keys),dep_keys:list.snapshot(dep_keys)})
    }
    while at < total {
        at = skip_ws(raw,at)
        let k = scan_object_keys(raw_text,raw,at)?
        if has(seen_top,k.text) { return err("duplicate key") }
        seen_top[k.text] = true
        list.append(top_keys,k.text)?
        at = skip_ws(raw,k.next)
        if at >= total || unwrap(bytes.at(raw,at)) != 58 { return err("expected colon") }
        at = skip_ws(raw,at+1)
        if k.text == "deps" {
            if at >= total || unwrap(bytes.at(raw,at)) != 123 { return err("deps not object") }
            at = skip_ws(raw,at+1)
            var seen_deps = map[string]bool{}
            if at < total && unwrap(bytes.at(raw,at)) == 125 {
                at += 1
            } else {
                while at < total {
                    at = skip_ws(raw,at)
                    let dk = scan_object_keys(raw_text,raw,at)?
                    if has(seen_deps,dk.text) { return err("duplicate dep key") }
                    seen_deps[dk.text] = true
                    list.append(dep_keys,dk.text)?
                    at = skip_ws(raw,dk.next)
                    if at >= total || unwrap(bytes.at(raw,at)) != 58 { return err("expected colon") }
                    at = scan_unique_json(raw_text,raw,at+1)?
                    at = skip_ws(raw,at)
                    if at < total && unwrap(bytes.at(raw,at)) == 125 {
                        at += 1
                        break
                    }
                    if at >= total || unwrap(bytes.at(raw,at)) != 44 { return err("bad deps") }
                    at += 1
                }
            }
        } else {
            at = scan_unique_json(raw_text,raw,at)?
        }
        at = skip_ws(raw,at)
        if at < total && unwrap(bytes.at(raw,at)) == 125 {
            return ok(ManifestShape{top_keys:list.snapshot(top_keys),dep_keys:list.snapshot(dep_keys)})
        }
        if at >= total || unwrap(bytes.at(raw,at)) != 44 { return err("bad root object") }
        at += 1
    }
    return err("unclosed root object")
}
fn resolve_dep_dir(g mut Graph, owner_root string, dep_name string, rel_path string, site ast.Node, source string) Result<string> {
    if rel_path == "" || strings.len_bytes(rel_path) > 1024 || strings.starts_with(rel_path,"/") ||
            strings.ends_with(rel_path,"/") || strings.contains(rel_path,"\\") || strings.contains(rel_path,":") {
        return err(error(source,site,"E5004","package dependency "+dep_name+" requires a normalized relative slash path"))
    }
    var current = owner_root
    for seg in strings.split(rel_path,"/") {
        if seg == "" || seg == "." {
            return err(error(source,site,"E5004","invalid path segment in package dependency "+dep_name))
        }
        if seg == ".." {
            let parent = path.normalize(path.dirname(current)?)?
            if cache_key(parent) == cache_key(current) {
                return err(error(source,site,"E5001","package dependency "+dep_name+" escapes filesystem root"))
            }
            let pinfo = fs.stat(parent)
            if is_err(pinfo) {
                list.append(g.build_inputs,BuildInput{path:parent,kind:"unavailable",content:unwrap_err(pinfo)})?
                return err(error(source,site,"E5001","cannot resolve package dependency "+dep_name))
            }
            list.append(g.build_inputs,BuildInput{path:parent,kind:"directory",content:""})?
            current = parent
        } else {
            let next = path.normalize(path.join([current,seg])?)?
            let info = fs.stat(next)
            if is_err(info) {
                list.append(g.build_inputs,BuildInput{path:next,kind:"unavailable",content:unwrap_err(info)})?
                return err(error(source,site,"E5001","cannot resolve package dependency "+dep_name+" at "+rel_path))
            }
            let kind = json.as_string(json.get(unwrap(info),"kind")?)?
            list.append(g.build_inputs,BuildInput{path:next,kind:kind,content:""})?
            if kind == "symlink" {
                return err(error(source,site,"E5001","symlink dependency is outside this resolver contract: "+dep_name))
            }
            if kind != "directory" {
                return err(error(source,site,"E5001","package dependency "+dep_name+" is not a directory"))
            }
            current = next
        }
    }
    let resolved = fs.canonical(current)
    if is_err(resolved) {
        return err(error(source,site,"E5001","cannot canonicalize package dependency "+dep_name))
    }
    let canonical_dir = path.normalize(unwrap(resolved))?
    if cache_key(canonical_dir) != cache_key(path.normalize(current)?) {
        return err(error(source,site,"E5001","symlink or junction dependency is outside this resolver contract: "+dep_name))
    }
    return ok(canonical_dir)
}
fn check_local_dep_conflict(g mut Graph, dir string, dep_name string, site ast.Node, source string) Result<void> {
    let sub = path.join([dir,dep_name])?
    let sub_info = fs.stat(sub)
    if is_ok(sub_info) {
        let kind = json.as_string(json.get(unwrap(sub_info),"kind")?)?
        list.append(g.build_inputs,BuildInput{path:sub,kind:kind,content:""})?
        return err(error(source,site,"E5004","local directory or file conflicts with package dependency "+dep_name))
    }
    list.append(g.build_inputs,BuildInput{path:sub,kind:"unavailable",content:unwrap_err(sub_info)})?
    for ext in [".hua",".huam",".wasm"] {
        let cand = path.join([dir,dep_name+ext])?
        let info = fs.stat(cand)
        if is_ok(info) {
            let kind = json.as_string(json.get(unwrap(info),"kind")?)?
            list.append(g.build_inputs,BuildInput{path:cand,kind:kind,content:""})?
            return err(error(source,site,"E5004","local module conflicts with package dependency "+dep_name))
        }
        list.append(g.build_inputs,BuildInput{path:cand,kind:"unavailable",content:unwrap_err(info)})?
    }
    return ok()
}
fn inspect_manifest(g mut Graph, dir string, site ast.Node, source string) Result<string> {
    let target = path.join([dir,"hua.package.json"])?
    let info = fs.stat(target)
    if is_err(info) {
        list.append(g.build_inputs,BuildInput{path:target,kind:"unavailable",content:unwrap_err(info)})?
        return ok("")
    }
    let kind = json.as_string(json.get(unwrap(info),"kind")?)?
    list.append(g.build_inputs,BuildInput{path:target,kind:kind,content:""})?
    if kind == "symlink" {
        return err(error(source,site,"E5001","symlink hua.package.json is outside this resolver contract"))
    }
    if kind != "file" {
        return err(error(source,site,"E5004","hua.package.json must be a regular file"))
    }
    return ok(target)
}
fn load_package_manifest(g mut Graph, expected_name string, dir string, site ast.Node, source string, active mut List<string>) Result<void> {
    let manifest_file = inspect_manifest(g,dir,site,source)?
    if manifest_file == "" {
        return err(error(source,site,"E5001","missing hua.package.json in package directory "+dir))
    }
    let info = fs.stat(manifest_file)?
    if json.as_int(json.get(info,"size_bytes")?)? > 1048576 {
        return err(error(source,site,"E5005","hua.package.json exceeds 1 MiB limit"))
    }
    let raw = fs.read_text(manifest_file)?
    list.append(g.build_inputs,BuildInput{path:manifest_file,kind:"text",content:raw})?
    let parsed = json.decode(raw)
    if is_err(parsed) {
        return err(error(source,site,"E5004","invalid JSON in hua.package.json"))
    }
    let shape_res = parse_manifest_shape(raw)
    if is_err(shape_res) {
        return err(error(source,site,"E5004","invalid or duplicate keys in hua.package.json"))
    }
    let shape = unwrap(shape_res)
    let root_json = unwrap(parsed)
    for k in shape.top_keys {
        if !alg.contains(["schema","name","version","deps","native_libs"],k) {
            return err(error(source,site,"E5004","unknown field "+k+" in hua.package.json"))
        }
    }
    let schema_res = json.get(root_json,"schema")
    if is_err(schema_res) || unwrap_or(json.as_string(unwrap(schema_res)),"") != "hua.package.v1" {
        return err(error(source,site,"E5004","unsupported hua.package.json schema (expected hua.package.v1)"))
    }
    let name_res = json.get(root_json,"name")
    if is_err(name_res) {
        return err(error(source,site,"E5004","invalid or reserved package name in hua.package.json"))
    }
    let name_str = json.as_string(unwrap(name_res))
    if is_err(name_str) || !valid_package_name(unwrap(name_str)) {
        return err(error(source,site,"E5004","invalid or reserved package name in hua.package.json"))
    }
    let pkg_name = unwrap(name_str)
    let ver_res = json.get(root_json,"version")
    if is_err(ver_res) {
        return err(error(source,site,"E5004","missing or invalid package version in hua.package.json"))
    }
    let ver_str = json.as_string(unwrap(ver_res))
    if is_err(ver_str) || unwrap(ver_str) == "" || strings.len_bytes(unwrap(ver_str)) > 128 {
        return err(error(source,site,"E5004","missing or invalid package version in hua.package.json"))
    }
    let pkg_ver = unwrap(ver_str)

    let is_root = expected_name == ""
    if !is_root {
        if pkg_name != expected_name {
            return err(error(source,site,"E5004","package manifest name "+pkg_name+" does not match dependency "+expected_name))
        }
        if pkg_name == g.root_package.name || cache_key(dir) == cache_key(g.root) {
            return err(error(source,site,"E5004","package dependency "+pkg_name+" conflicts with root package"))
        }
        let pkg_entry = path.join([dir,"package.hua"])?
        let entry_info = fs.stat(pkg_entry)
        if is_err(entry_info) {
            list.append(g.build_inputs,BuildInput{path:pkg_entry,kind:"unavailable",content:unwrap_err(entry_info)})?
            return err(error(source,site,"E5001","package "+pkg_name+" is missing package.hua"))
        }
        let entry_kind = json.as_string(json.get(unwrap(entry_info),"kind")?)?
        list.append(g.build_inputs,BuildInput{path:pkg_entry,kind:entry_kind,content:""})?
        if entry_kind != "file" {
            return err(error(source,site,"E5001","package "+pkg_name+" requires a regular package.hua file"))
        }
        if alg.contains(list.snapshot(active),pkg_name) {
            return err(error(source,site,"E5002","cyclic package dependency: "+strings.join(list.snapshot(active)," -> ")+" -> "+pkg_name))
        }
        if has(g.packages,pkg_name) {
            if cache_key(unwrap(g.packages[pkg_name]).root) != cache_key(dir) {
                return err(error(source,site,"E5004","conflicting package dependency "+pkg_name+" points to different directories"))
            }
            return ok()
        }
        for other_name, other_info in g.packages {
            if other_name != pkg_name && cache_key(other_info.root) == cache_key(dir) {
                return err(error(source,site,"E5004","package directory already registered under another name"))
            }
        }
        if len(g.packages) >= 128 {
            return err(error(source,site,"E5005","package dependency graph exceeds 128 packages"))
        }
    }

    let empty_libs []string = []
    var pkg_native_libs = list.from_slice(empty_libs)
    let libs_res = json.get(root_json,"native_libs")
    if is_ok(libs_res) {
        let libs_json = unwrap(libs_res)
        if json.kind(libs_json) != "object" {
            return err(error(source,site,"E5004","native_libs in hua.package.json must be a JSON object"))
        }
        let plat_keys = unwrap(json.keys(libs_json))
        for plat in plat_keys {
            if !alg.contains(["windows-x86_64","linux-x86_64","macos-arm64","macos-x86_64"],plat) {
                return err(error(source,site,"E5004","unsupported platform key "+plat+" in native_libs"))
            }
            let arr = unwrap(json.get(libs_json,plat))
            if json.kind(arr) != "array" {
                return err(error(source,site,"E5004","native_libs."+plat+" must be a JSON array"))
            }
            let nlibs = unwrap(json.len(arr))
            var seen_libs = map[string]bool{}
            for li in 0..nlibs {
                let item_str = json.as_string(unwrap(json.at(arr,li)))
                if is_err(item_str) {
                    return err(error(source,site,"E5004","invalid filename in native_libs."+plat))
                }
                let fname = unwrap(item_str)
                if fname == "" || strings.len_bytes(fname) > 256 || strings.contains(fname,"/") ||
                        strings.contains(fname,"\\") || strings.contains(fname,":") ||
                        fname == "." || fname == ".." || has(seen_libs,fname) {
                    return err(error(source,site,"E5004","invalid or duplicate filename in native_libs."+plat))
                }
                seen_libs[fname] = true
                if plat == "windows-x86_64" {
                    let lib_path = path.join([dir,fname])?
                    let lib_info = fs.stat(lib_path)
                    if is_err(lib_info) {
                        list.append(g.build_inputs,BuildInput{path:lib_path,kind:"unavailable",content:unwrap_err(lib_info)})?
                        return err(error(source,site,"E7001","missing native library "+fname+" declared in hua.package.json"))
                    }
                    let lib_kind = json.as_string(json.get(unwrap(lib_info),"kind")?)?
                    if lib_kind == "symlink" || lib_kind != "file" {
                        return err(error(source,site,"E5001","native library "+fname+" must be a regular non-symlink file"))
                    }
                    list.append(g.build_inputs,BuildInput{path:lib_path,kind:"binary",content:""})?
                    list.append(pkg_native_libs,fname)?
                    var art_rel = "native/_root/"+fname
                    if !is_root { art_rel = "native/"+pkg_name+"/"+fname }
                    list.append(g.native_artifacts,NativeArtifact{source:lib_path,artifact:art_rel})?
                }
            }
        }
    }

    var deps = map[string]string{}
    let deps_res = json.get(root_json,"deps")
    if is_ok(deps_res) {
        let deps_json = unwrap(deps_res)
        for dep_key in shape.dep_keys {
            if !valid_package_name(dep_key) {
                return err(error(source,site,"E5004","invalid or reserved dependency name "+dep_key))
            }
            if dep_key == pkg_name {
                return err(error(source,site,"E5004","package "+pkg_name+" cannot depend on itself"))
            }
            let val_node = json.get(deps_json,dep_key)?
            let val_str = json.as_string(val_node)
            if is_err(val_str) {
                return err(error(source,site,"E5004","dependency "+dep_key+" path must be a string"))
            }
            check_local_dep_conflict(g,dir,dep_key,site,source)?
            deps[dep_key] = unwrap(val_str)
        }
    }

    let pkg = PackageInfo{name:pkg_name,version:pkg_ver,root:dir,deps:deps,native_libs:list.snapshot(pkg_native_libs)}
    if is_root { g.root_package = pkg }
    else { g.packages[pkg_name] = pkg }

    list.append(active,pkg_name)?
    for dep_key, rel_path in deps {
        let dep_dir = resolve_dep_dir(g,dir,dep_key,rel_path,site,source)?
        load_package_manifest(g,dep_key,dep_dir,site,source,active)?
    }
    list.pop(active)?
    return ok()
}
fn resolve_in_package(g mut Graph, base_root string, rel_mod string, pkg_owner string, package_entry bool, name string, site ast.Node, source string) Result<ResolvedImport> {
    var candidates []string = []
    if package_entry {
        candidates = ["package.hua"]
    } else {
        let rel = strings.replace(rel_mod,".","/")
        candidates = [rel+".hua",rel+"/package.hua",rel+".huam",rel+"/package.huam"]
    }
    for cand in candidates {
        let found = inspect(g,base_root,cand,site,source)?
        if found != "" {
            let actual = fs.canonical(found)
            if is_err(actual) || cache_key(path.normalize(unwrap(actual))?) != cache_key(path.normalize(found)?) {
                return err(error(source,site,"E5001","symlink dependency is outside this resolver contract"))
            }
            var logical = cand
            if pkg_owner != "" { logical = "@pkg/"+pkg_owner+"/"+cand }
            return ok(ResolvedImport{file:found,logical:logical,package:pkg_owner})
        }
    }
    if !package_entry {
        let rel = strings.replace(rel_mod,".","/")
        for ext in [rel+".wasm",rel+"/package.wasm"] {
            if inspect(g,base_root,ext,site,source)? != "" { return err(error(source,site,"E8201","WASM module is outside SB1")) }
        }
    }
    return err(error(source,site,"E5001","cannot resolve module "+name))
}
fn resolve_in_context(g mut Graph, owner_pkg string, name string, site ast.Node, source string) Result<ResolvedImport> {
    if !g.has_manifest {
        let found = resolve(g,name,site,source)?
        return ok(ResolvedImport{file:found,logical:"",package:""})
    }
    var ctx = g.root_package
    if owner_pkg != "" { ctx = unwrap(g.packages[owner_pkg]) }
    let dot = strings.index(name,".")
    var first = name
    var rest = ""
    if dot >= 0 {
        first = rules_cut_local(name,0,dot)
        rest = rules_cut_local(name,dot+1,len(name))
    }
    if has(ctx.deps,first) {
        check_local_dep_conflict(g,ctx.root,first,site,source)?
        let target_pkg = unwrap(g.packages[first])
        return resolve_in_package(g,target_pkg.root,rest,target_pkg.name,rest == "",name,site,source)
    }
    return resolve_in_package(g,ctx.root,name,owner_pkg,false,name,site,source)
}
fn rules_cut_local(text string, start int, finish int) string {
    return unwrap(strings.slice(text,start,finish))
}
fn std_source(g mut Graph, site ast.Node, source string) Result<string> {
    let configured = os.getenv("HUA_HOME")?
    if is_none(configured) { return err(error(source,site,"E5001","std.alg_integer requires HUA_HOME set to a Hua SDK root")) }
    let requested = path.normalize(unwrap(configured))?
    if cache_key(path.join([os.cwd()?,requested])?) != cache_key(requested) {
        return err(error(source,site,"E5001","HUA_HOME must be an absolute SDK root"))
    }
    let resolved = fs.canonical(requested)
    if is_err(resolved) { return err(error(source,site,"E5001","invalid Hua SDK root")) }
    let root = path.normalize(unwrap(resolved))?
    let manifest = inspect(g,root,"manifest.json",site,source)?
    if manifest == "" { return err(error(source,site,"E5001","cannot read Hua SDK manifest.json")) }
    let info = fs.stat(manifest)?
    if json.as_int(json.get(info,"size_bytes")?)? > 1048576 {
        return err(error(source,site,"E5001","invalid size for Hua SDK manifest.json"))
    }
    let manifest_text = fs.read_text(manifest)?
    list.append(g.build_inputs,BuildInput{path:manifest,kind:"text",content:manifest_text})?
    let parsed = json.decode(manifest_text)
    if is_err(parsed) { return err(error(source,site,"E5001","invalid JSON in Hua SDK manifest.json")) }
    let value = unwrap(parsed)
    let relative = "src/std/alg_integer.hua"
    let schema = json.get(value,"schema")
    let modules = json.get(value,"source_modules")
    let files = json.get(value,"files")
    let invalid = error(source,site,"E5001","Hua SDK manifest does not register std.alg_integer")
    if is_err(schema) || is_err(modules) || is_err(files) { return err(invalid) }
    let registered = json.get(unwrap(modules),"std.alg_integer")
    let file = json.get(unwrap(files),relative)
    if is_err(registered) || is_err(file) { return err(invalid) }
    let role = json.get(unwrap(file),"role")
    if is_err(role) || unwrap_or(json.as_string(unwrap(schema)),"") != "hua.sdk.v1" ||
        unwrap_or(json.as_string(unwrap(registered)),"") != relative ||
        unwrap_or(json.as_string(unwrap(role)),"") != "stdlib_source" { return err(invalid) }
    let found = inspect(g,root,relative,site,source)?
    if found != "" {
        let actual = fs.canonical(found)
        if is_ok(actual) && cache_key(path.normalize(unwrap(actual))?) == cache_key(found) { return ok(found) }
    }
    return err(error(source,site,"E5001","cannot read registered SDK source: "+relative))
}
fn visit(g mut Graph, filename string, site ast.Node, parent string, sdk_id string, logical_id string, owner_pkg string) Result<string> {
    let normalized = path.normalize(filename)?
    var key = cache_key(normalized)
    if sdk_id != "" { key = sdk_id }
    for unit in list.snapshot(g.units) {
        if unit.key == key {
            if alg.contains(list.snapshot(g.active),unit.id) { return err(error(parent,site,"E5002","cyclic module import "+unit.id)) }
            return ok(unit.id)
        }
    }
    if list.len(g.units) >= g.limits.modules || list.len(g.active) >= g.limits.levels { return err(error(parent,site,"E5005","module count/dependency depth budget")) }
    let info = fs.stat(normalized)
    if is_err(info) { return err(error(parent,site,"E5001","cannot read source")) }
    let kind = json.as_string(json.get(unwrap(info),"kind")?)?
    if kind != "file" { return err(error(parent,site,"E8204","source must be a regular file")) }
    let size = json.as_int(json.get(unwrap(info),"size_bytes")?)?
    var per_file = parser.defaults().source_bytes
    if g.limits.compiler { per_file = parser.compiler_limits().source_bytes }
    if size > per_file || g.total_bytes+size > g.limits.source_bytes_total { return err(error(parent,site,"E5005","module byte budget")) }
    let raw = fs.read_text(normalized)
    if is_err(raw) { return err(error(parent,site,"E8204",unwrap_err(raw))) }
    list.append(g.build_inputs,BuildInput{path:normalized,kind:"text",content:unwrap(raw)})?
    var id = sdk_id
    if id == "" && logical_id != "" { id = logical_id }
    if id == "" {
        id = path.relative(normalized,g.root)?
        if id == ".." || strings.starts_with(id,"../") { return err(error(parent,site,"E8302","source outside project root")) }
    }
    let is_native = strings.ends_with(normalized,".huam")
    var abi_ver = 0
    var parse_source = unwrap(raw)
    if is_native {
        let norm_lines = strings.lines(parse_source)
        var first_line = ""
        if len(norm_lines) > 0 { first_line = norm_lines[0] }
        if first_line == "HUA_NATIVE 1" { abi_ver = 1 }
        else if first_line == "HUA_NATIVE 2" { abi_ver = 2 }
        else { return err(error(id,site,"E7002","native manifest requires HUA_NATIVE 1 or HUA_NATIVE 2 header")) }
        parse_source = "#" + rules_cut_local(parse_source,1,strings.len_bytes(parse_source))
        let dll_path = rules_cut_local(normalized,0,strings.len_bytes(normalized)-5) + ".dll"
        let dll_info = fs.stat(dll_path)
        if is_err(dll_info) {
            list.append(g.build_inputs,BuildInput{path:dll_path,kind:"unavailable",content:unwrap_err(dll_info)})?
            return err(error(parent,site,"E7001","native manifest binary is missing"))
        }
        let dll_kind = json.as_string(json.get(unwrap(dll_info),"kind")?)?
        if dll_kind != "file" {
            return err(error(parent,site,"E7001","native manifest binary is missing"))
        }
        list.append(g.build_inputs,BuildInput{path:dll_path,kind:"binary",content:""})?
        var art_rel = ""
        if g.has_manifest {
            if owner_pkg != "" {
                art_rel = "native/" + owner_pkg + "/" + path.basename(dll_path)?
            } else {
                art_rel = "native/_root/" + strings.replace(path.relative(dll_path,g.root)?,"\\","/")
            }
        } else {
            art_rel = strings.replace(path.relative(dll_path,g.root)?,"\\","/")
        }
        list.append(g.external_modules,ExternalModule{id:id+"#module",unit_id:id,artifact:art_rel,source_path:dll_path,abi_version:abi_ver})?
        list.append(g.native_artifacts,NativeArtifact{source:dll_path,artifact:art_rel})?
    }
    var parsed Result<parser.Tree> = err("uninitialized")
    if g.limits.compiler { parsed = parser.parse_compiler(parse_source,id) }
    else { parsed = parser.parse_extended(parse_source,id) }
    if is_err(parsed) { return err(unwrap_err(parsed)+" ["+id+"]") }
    let unit = Unit{id:id,path:normalized,key:key,package:owner_pkg,external:is_native,abi_version:abi_ver,tree:unwrap(parsed)}
    g.total_bytes += unit.tree.source_bytes
    if g.total_bytes > g.limits.source_bytes_total { return err(error(parent,site,"E5005","module byte budget")) }
    list.append(g.units,unit)?
    list.append(g.active,id)?
    let root = ast.get(unit.tree.pool,unit.tree.root)?
    var declarations = false
    for child in root.children {
        let n = ast.get(unit.tree.pool,child)?
        check_work(g,unit.id,n)?
        if ast.kind(n.payload) != "Import" { declarations = true
            continue }
        if declarations { return err(error(id,n,"E5004","imports must precede declarations")) }
        let name = ast.payload_text(n.payload)
        var ns = name
        if len(n.children) == 1 { ns = ast.payload_text(ast.get(unit.tree.pool,n.children[0])?.payload) }
        for edge in list.snapshot(g.edges) {
            if edge.source == id {
                if edge.namespace == ns { return err(error(id,n,"E5004","duplicate import namespace")) }
                if strings.starts_with(ns,edge.namespace+".") || strings.starts_with(edge.namespace,ns+".") { return err(error(id,n,"E8201","overlapping namespace prefixes need later resolution")) }
            }
        }
        var target = ""
        if sdk_id != "" && !(strings.starts_with(name,"std.") || name == "std") {
            return err(error(id,n,"E5001","SDK source modules can only import standard modules"))
        }
        if name == "std.alg_integer" {
            let loaded = unit_index(g,"@sdk/src/std/alg_integer.hua")
            var source = ""
            if loaded >= 0 { source = list.get(g.units,loaded)?.path }
            else { source = std_source(g,n,id)? }
            target = visit(g,source,n,id,"@sdk/src/std/alg_integer.hua","","")?
        } else if strings.starts_with(name,"std.") || name == "std" {
            if !catalog.module(name) { return err(error(id,n,"E8201","standard module is outside SB1")) }
            target = "builtin:"+name
        } else {
            let resolved_dep = resolve_in_context(g,owner_pkg,name,n,id)?
            target = visit(g,resolved_dep.file,n,id,"",resolved_dep.logical,resolved_dep.package)?
        }
        list.append(g.edges,Edge{source:id,target:target,namespace:ns,node:n.id.index})?
    }
    list.pop(g.active)?
    list.append(g.order,id)?
    return ok(id)
}
fn enter_scope(e mut Environment) Result<void> {
    list.append(e.scopes,e.next_scope)?
    e.next_scope += 1
    return ok()
}
fn local(e Environment, name string) Symbol? {
    var i = list.len(e.scopes)
    while i > 0 {
        i -= 1
        let scope = unwrap(list.get(e.scopes,i))
        let found = e.locals[str(scope)+":"+name]
        if is_some(found) { return found }
    }
    return nil
}
fn define(g mut Graph, e mut Environment, n ast.Node, name string, kind string) Result<void> {
    if name == "_" { return ok() }
    let u = e.unit
    let scope = list.get(e.scopes,list.len(e.scopes)-1)?
    let key = str(scope)+":"+name
    if has(e.locals,key) { return err(error(u,n,"E3002","duplicate declaration "+name)) }
    if list.len(g.symbols) >= g.limits.symbols { return err(error(u,n,"E5005","symbol budget")) }
    let item = Symbol{module:u,node:n.id.index,name:name,kind:kind,published:false,scope:scope,target:u+"#s"+str(scope)+":"+name}
    e.locals[key] = item
    list.append(g.symbols,item)?
    return ok()
}
fn reference(g mut Graph, e Environment, n ast.Node, name string, type_name bool) Result<void> {
    let u = e.unit
    var target = ""
    let base = namespace_root(name)
    let l = local(e,base)
    if !type_name && is_some(l) { target = unwrap(l).target }
    if target == "" {
        for edge in e.imports {
            if edge.source != u { continue }
            if strings.starts_with(name,edge.namespace+".") {
                let member = strings.slice(name,len(edge.namespace)+1,len(name))?
                if strings.starts_with(edge.target,"builtin:") {
                    let module = strings.slice(edge.target,8,len(edge.target))?
                    if !alg.contains(catalog.exports(module),member) || (type_name && !catalog.type_export(module,member)) { return err(error(u,n,"E5003","module has no public export "+member)) }
                    target = edge.target+"#"+member
                } else {
                    let symbol = global(g,edge.target,member)
                    if is_none(symbol) || !unwrap(symbol).published { return err(error(u,n,"E5003","module has no public export "+member)) }
                    let item = unwrap(symbol)
                    if type_name && item.kind != "Struct" && item.kind != "Enum" { return err(error(u,n,"E5003","export is not a type")) }
                    if !type_name && (item.kind == "Struct" || item.kind == "Enum") { return err(error(u,n,"E5003","export type requires named-field initializer")) }
                    target = item.target
                }
                break
            }
            if name == namespace_root(edge.namespace) && !type_name { return err(error(u,n,"E5003","module namespace requires qualified export")) }
        }
    }
    if target == "" {
        let symbol = global(g,u,name)
        if is_some(symbol) {
            let item = unwrap(symbol)
            if type_name {
                if item.kind == "Struct" || item.kind == "Enum" { target = item.target }
            } else if has(e.visible,name) { target = item.target }
        }
    }
    if target == "" {
        if type_name && name == "std.error.Value" { target = "builtin:std.error#Value" }
        else if type_name && catalog.primitive(name) { target = "builtin:type:"+name }
        else if !type_name && (name=="$task_group_begin" || name=="$task_group_end") {
            target = "builtin:core:"+unwrap(strings.slice(name,1,len(name)))
        }
        else if !type_name && catalog.core(name) { target = "builtin:core:"+name }
    }
    if target == "" {
        var code = "E3001"
        if type_name { code = "E3004" }
        return err(error(u,n,code,"undefined name "+name))
    }
    if list.len(g.references) >= g.limits.references { return err(error(u,n,"E5005","reference budget")) }
    list.append(g.references,Reference{module:u,node:n.id.index,name:name,target:target,type_name:type_name})?
    return ok()
}
fn dotted(pool ast.Pool, id ast.NodeId, source string, limit int) Result<string> {
    let origin = ast.get(pool,id)?
    var current = id
    var suffix = ""
    var depth = 0
    while true {
        if depth >= limit { return err(error(source,origin,"E5005","qualified name depth budget")) }
        depth += 1
        let n = ast.get(pool,current)?
        if ast.kind(n.payload) == "Name" { return ok(ast.payload_text(n.payload)+suffix) }
        if ast.kind(n.payload) != "Member" { return ok("") }
        suffix = "."+ast.payload_text(n.payload)+suffix
        current = n.children[0]
    }
    return ok("")
}
fn walk(g mut Graph, e mut Environment, id ast.NodeId, top bool) Result<void> {
    let u = e.unit
    let n = ast.get(e.pool,id)?
    check_work(g,u,n)?
    if e.depth >= g.limits.depth { return err(error(u,n,"E5005","analysis node depth budget")) }
    e.depth += 1
    let k = ast.kind(n.payload)
    let text = ast.payload_text(n.payload)
    if k == "Import" { if !top { return err(error(u,n,"E8201","nested imports are outside this module analyzer")) } }
    else if k == "Name" { reference(g,e,n,text,false)? }
    else if k == "TypeName" || k == "GenericType" { reference(g,e,n,text,true)?
        for child in n.children { walk(g,e,child,false)? } }
    else if k == "StructLiteral" { reference(g,e,n,text,true)?
        for child in n.children { walk(g,e,child,false)? } }
    else if k == "Member" {
        let name = dotted(e.pool,id,u,g.limits.depth)?
        var imported = false
        if name != "" && is_none(local(e,namespace_root(name))) {
            for edge in e.imports { if edge.source == u && strings.starts_with(name,edge.namespace+".") { imported = true } }
            if is_some(global(g,u,name)) { imported = true }
        }
        if imported { reference(g,e,n,name,false)? }
        else { walk(g,e,n.children[0],false)? }
    }
    else if k == "Block" { enter_scope(e)?
        for child in n.children { walk(g,e,child,false)? }
        list.pop(e.scopes)? }
    else if k == "Function" {
        if !top { define(g,e,n,declared(text),"Function")? }
        let signature = ast.get(e.pool,n.children[0])?
        # Types are resolved before value parameters enter scope.
        for child in signature.children {
            let p = ast.get(e.pool,child)?
            for typ in p.children { walk(g,e,typ,false)? }
        }
        enter_scope(e)?
        for child in signature.children {
            let p = ast.get(e.pool,child)?
            if ast.kind(p.payload) == "Parameter" { define(g,e,p,declared(ast.payload_text(p.payload)),"Parameter")? }
        }
        walk(g,e,n.children[1],false)?
        list.pop(e.scopes)?
    }
    else if k == "Let" || k == "Var" || k == "Const" {
        for child in n.children { walk(g,e,child,false)? }
        if top { e.visible[text] = true } else { define(g,e,n,text,k)? }
    }
    else if k == "MultiBinding" {
        let names = ast.get(e.pool,n.children[0])?
        for child in names.children { let p = ast.get(e.pool,child)?
            for typ in p.children { walk(g,e,typ,false)? } }
        walk(g,e,n.children[1],false)?
        for child in names.children { let p = ast.get(e.pool,child)?
            let name = ast.payload_text(p.payload)
            if top { e.visible[name] = true } else { define(g,e,p,name,text)? } }
    }
    else if k == "MultiAssignment" {
        let names = ast.get(e.pool,n.children[0])?
        for child in names.children { let p = ast.get(e.pool,child)?
            if ast.kind(p.payload) != "Name" || ast.payload_text(p.payload) != "_" { walk(g,e,child,false)? } }
        walk(g,e,n.children[1],false)?
    }
    else if k == "For" {
        let count = len(n.children)-2
        walk(g,e,n.children[count],false)?
        enter_scope(e)?
        for i in 0..count { let p = ast.get(e.pool,n.children[i])?
            define(g,e,p,ast.payload_text(p.payload),"For")? }
        walk(g,e,n.children[count+1],false)?
        list.pop(e.scopes)?
    }
    else if k == "MatchArm" {
        let pattern = ast.get(e.pool,n.children[0])?
        # Bare enum variant patterns need scrutinee type information in C04.
        if ast.kind(pattern.payload) == "Name" && strings.index(ast.payload_text(pattern.payload),".") >= 0 { reference(g,e,pattern,ast.payload_text(pattern.payload),false)? }
        enter_scope(e)?
        let bindings = ast.get(e.pool,n.children[1])?
        for child in bindings.children { let p = ast.get(e.pool,child)?
            define(g,e,p,ast.payload_text(p.payload),"Pattern")? }
        walk(g,e,n.children[2],false)?
        list.pop(e.scopes)?
    }
    else { for child in n.children { walk(g,e,child,false)? } }
    e.depth -= 1
    return ok()
}
pub fn analyze(entry string) Result<Graph> { return analyze_impl(entry,defaults()) }
pub fn analyze_compiler(entry string) Result<Graph> { return analyze_impl(entry,compiler_limits()) }
fn analyze_impl(entry string, limits Limits) Result<Graph> {
    let joined_entry = path.join([os.cwd()?,entry])?
    let canonical_entry = fs.canonical(joined_entry)
    var normalized = path.normalize(joined_entry)?
    if is_ok(canonical_entry) { normalized = path.normalize(unwrap(canonical_entry))? }
    let root = path.normalize(path.dirname(normalized)?)?
    var units []Unit = []
    var edges []Edge = []
    var symbols []Symbol = []
    var references []Reference = []
    var names []string = []
    let inputs []BuildInput = []
    let ext_mods []ExternalModule = []
    let nat_arts []NativeArtifact = []
    let empty_pkg = PackageInfo{name:"",version:"",root:root,deps:map[string]string{},native_libs:[]}
    var g = Graph{globals:map[string]int{},limits:limits,root:root,has_manifest:false,root_package:empty_pkg,packages:map[string]PackageInfo{},units:list.from_slice(units),edges:list.from_slice(edges),symbols:list.from_slice(symbols),references:list.from_slice(references),order:list.from_slice(names),active:list.from_slice(names),total_bytes:0,work:0,build_inputs:list.from_slice(inputs),external_modules:list.from_slice(ext_mods),native_artifacts:list.from_slice(nat_arts)}
    # A validated empty source supplies the entry error location before the actual parse.
    let entry_name = path.basename(normalized)?
    let seed = parser.parse_extended("",entry_name)?
    let site = ast.get(seed.pool,seed.root)?
    let root_manifest = inspect_manifest(g,root,site,entry_name)?
    if root_manifest != "" {
        g.has_manifest = true
        var active_pkgs = list.from_slice(names)
        load_package_manifest(g,"",root,site,entry_name,active_pkgs)?
    }
    var entry_logical = ""
    if g.has_manifest { entry_logical = entry_name }
    visit(g,normalized,site,entry_name,"",entry_logical,"")?
    for u in list.snapshot(g.units) { collect(g,u)? }
    for id in list.snapshot(g.order) {
        let index = unit_index(g,id)
        let u = list.get(g.units,index)?
        var scope []int = []
        var empty []Edge = []
        var imports = list.from_slice(empty)
        for edge in list.snapshot(g.edges) { if edge.source == u.id { list.append(imports,edge)? } }
        var e = Environment{unit:u.id,pool:u.tree.pool,imports:list.snapshot(imports),scopes:list.from_slice(scope),locals:map[string]Symbol{},visible:map[string]bool{},next_scope:1,depth:0}
        for symbol in list.snapshot(g.symbols) {
            if symbol.module == id && symbol.scope == 0 && alg.contains(["Function","Struct","Enum","Variant"],symbol.kind) { e.visible[symbol.name] = true }
        }
        let program = ast.get(u.tree.pool,u.tree.root)?
        for child in program.children {
            let n = ast.get(u.tree.pool,child)?
            if ast.kind(n.payload) != "Function" { walk(g,e,child,true)? }
        }
        for child in program.children {
            let n = ast.get(u.tree.pool,child)?
            if ast.kind(n.payload) == "Function" { walk(g,e,child,true)? }
        }
    }
    return ok(g)
}
